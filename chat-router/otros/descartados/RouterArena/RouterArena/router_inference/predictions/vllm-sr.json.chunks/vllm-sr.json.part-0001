      "generated_answer": "```python\nimport sys\nfrom collections import deque\n\nMOD = 998244353\n\ndef solve():\n    data = sys.stdin.read().split()\n    H, W = int(data[0]), int(data[1])\n    grid = [list(data[i+2]) for i in range(H)]\n    \n    # Directions: up, down, left, right\n    dirs = [(0,1), (0,-1), (1,0), (-1,0)]\n    \n    visited = [[False]*W for _ in range(H)]\n    comp_id = [[-1]*W for _ in range(H)]\n    comp_count = 0\n    \n    def bfs(start_i, start_j, cid):\n        q = deque([(start_i, start_j)])\n        visited[start_i][start_j] = True\n        comp_id[start_i][start_j] = cid\n        while q:\n            x, y = q.popleft()\n            for dx, dy in dirs:\n                nx, ny = x+dx, y+dy\n                if 0 <= nx < H and 0 <= ny < W and not visited[nx][ny] and grid[nx][ny]=='#':\n                    visited[nx][ny] = True\n                    comp_id[nx][ny] = cid\n                    q.append((nx, ny))\n    \n    # Count existing components and assign IDs\n    for i in range(H):\n        for j in range(W):\n            if grid[i][j] == '#' and not visited[i][j]:\n                bfs(i, j, comp_count)\n                comp_count += 1\n                \n    # For each red cell, compute new components count\n    total_red = 0\n    total_components = 0\n    red_cells = []\n    \n    for i in range(H):\n        for j in range(W):\n            if grid[i][j] == '.':\n                total_red += 1\n                red_cells.append((i,j))\n                \n                # Check neighbors\n                neighbors = []\n                for dx, dy in dirs:\n                    ni, nj = i+dx, j+dy\n                    if 0 <= ni < H and 0 <= nj < W and grid[ni][nj] == '#':\n                        neighbors.append(comp_id[ni][nj])\n                unique_neighbors = set(neighbors)\n                \n                new_comp = 1 - len(unique_neighbors) + comp_count\n                total_components += new_comp\n                \n    # Expected value = total_components / total_red\n    # Compute modular inverse of total_red mod MOD\n    def modinv(a, mod=MOD):\n        return pow(a, mod-2, mod)\n        \n    result = (total_components % MOD) * modinv(total_red, MOD) % MOD\n    print(result)\n\nsolve()\n```",
