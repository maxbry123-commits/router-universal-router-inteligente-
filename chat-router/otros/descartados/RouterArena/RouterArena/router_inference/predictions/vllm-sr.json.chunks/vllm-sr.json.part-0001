    "prediction": "qwen/qwen3-next-80b-a3b-instruct",
    "generated_result": {
      "generated_answer": "```python\nimport sys\nfrom collections import defaultdict, deque\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    n = int(data[0])\n    m = int(data[1])\n    \n    parents = [0] * (n + 1)\n    if n > 1:\n        p_list = list(map(int, data[2:2+n-1]))\n        for i in range(2, n + 1):\n            parents[i] = p_list[i - 2]\n    \n    children = defaultdict(list)\n    for i in range(2, n + 1):\n        children[parents[i]].append(i)\n    \n    # Read insurance policies\n    policies = []\n    idx = 2 + n - 1\n    for i in range(m):\n        x = int(data[idx])\n        y = int(data[idx + 1])\n        idx += 2\n        policies.append((x, y))\n    \n    # Use BFS/DFS to mark covered nodes\n    covered = set()\n    \n    for x, y in policies:\n        # BFS from x up to y generations deep\n        queue = deque([(x, 0)])\n        visited_in_this_policy = set()\n        \n        while queue:\n            node, gen = queue.popleft()\n            if gen > y or node in visited_in_this_policy:\n                continue\n            visited_in_this_policy.add(node)\n            covered.add(node)\n            \n            if gen < y:\n                for child in children[node]:\n                    queue.append((child, gen + 1))\n    \n    print(len(covered))\n\nmain()\n```",
