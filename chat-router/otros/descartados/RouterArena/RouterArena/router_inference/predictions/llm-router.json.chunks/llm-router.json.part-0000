e\n                    break\n                elif grid[row][j] == '.':\n                    operations_needed += 1\n            \n            if valid:\n                found_valid = True\n                min_operations = min(min_operations, operations_needed)\n    \n    if found_valid:\n        print(min_operations)\n    else:\n        print(-1)\n\nsolve()\n```",
