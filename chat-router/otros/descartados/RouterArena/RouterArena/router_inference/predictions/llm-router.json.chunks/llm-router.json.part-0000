d if solution exists — symmetry\n    # Also try making three cubes fully overlapping or disjoint?\n    \n    # Try cube1 at (0,0,0), cube2 at (d,0,0), cube3 at (0,d,0), d in a wider range?\n    for d in range(-20, 21):\n        for e in range(-20, 21):\n            # Configuration 1: C1(0,0,0), C2(d,0,0), C3(0,e,0)\n            a1, b1, c1 = 0, 0, 0\n            a2, b2, c2 = d, 0, 0\n            a3, b3, c3 = 0, e, 0\n            if any(abs(x) > 100 for x in [a1,b1,c1,a2,b2,c2,a3,b3,c3]):\n                continue\n            V_one, V_two, V_three = get_volume((a1,b1,c1), (a2,b2,c2), (a3,b3,c3))\n            if V_one == V1 and V_two == V2 and V_three == V3:\n                print(\"Yes\")\n                print(a1, b1, c1, a2, b2, c2, a3, b3, c3)\n                return\n    \n    # Try layered in one direction\n    for d in range(0, 8):\n        for e in range(0, 8):\n            a1, b1, c1 = 0, 0, 0\n            a2, b2, c2 = d, 0, 0\n            a3, b3, c3 = e, 0, 0\n            if any(abs(x) > 100 for x in [a1,b1,c1,a2,b2,c2,a3,b3,c3]):\n                continue\n            V_one, V_two, V_three = get_volume((a1,b1,c1), (a2,b2,c2), (a3,b3,c3))\n            if V_one == V1 and V_two == V2 and V_three == V3:\n                print(\"Yes\")\n                print(a1, b1, c1, a2, b2, c2, a3, b3, c3)\n                return\n    \n    # Nothing found\n    print(\"No\")\n\nsolve()\n```",
