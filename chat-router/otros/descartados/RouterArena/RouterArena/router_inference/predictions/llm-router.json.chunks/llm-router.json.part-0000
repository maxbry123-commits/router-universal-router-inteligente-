1)])  # (2,2) in 1-indexed is (1,1) in 0-indexed\n    visited[1][1] = True\n    reachable.add((1, 1))\n    \n    # Directions: up, down, left, right\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    \n    while queue:\n        r, c = queue.popleft()\n        \n        for dr, dc in directions:\n            nr, nc = r, c\n            \n            # Slide in this direction until hitting rock\n            while True:\n                next_r = nr + dr\n                next_c = nc + dc\n                \n                # Check if next cell is within bounds and is ice (can move)\n                if (0 <= next_r < N and 0 <= next_c < M and \n                    grid[next_r][next_c] == '.'):\n                    nr, nc = next_r, next_c\n                    reachable.add((nr, nc))\n                else:\n                    # Hit rock or boundary, stop sliding\n                    break\n            \n            # After sliding in this direction, check if we reached a new cell\n            if not visited[nr][nc]:\n                visited[nr][nc] = True\n                queue.append((nr, nc))\n    \n    print(len(reachable))\n\nsolve()\n```",
