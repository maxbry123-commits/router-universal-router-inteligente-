      "generated_answer": "```python\nimport sys\n\ndef solve() -> None:\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n\n    N = int(next(it))\n    M = int(next(it))\n\n    # DSU structures\n    parent = list(range(N + 1))\n    rank = [0] * (N + 1)\n\n    def find(x: int) -> int:\n        # iterative path compression\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(x: int, y: int) -> None:\n        rx = find(x)\n        ry = find(y)\n        if rx == ry:\n            return\n        # union by rank\n        if rank[rx] < rank[ry]:\n            parent[rx] = ry\n        elif rank[rx] > rank[ry]:\n            parent[ry] = rx\n        else:\n            parent[ry] = rx\n            rank[rx] += 1\n\n    # read edges and build components\n    for _ in range(M):\n        u = int(next(it))\n        v = int(next(it))\n        union(u, v)\n\n    K = int(next(it))\n    forbidden_pairs = set()\n    for _ in range(K):\n        x = int(next(it))\n        y = int(next(it))\n        rx = find(x)\n        ry = find(y)\n        # ensure rx < ry for canonical representation\n        if rx > ry:\n            rx, ry = ry, rx\n        forbidden_pairs.add((rx, ry))\n\n    Q = int(next(it))\n    out = []\n    for _ in range(Q):\n        p = int(next(it))\n        q = int(next(it))\n        rp = find(p)\n        rq = find(q)\n        if rp == rq:\n            out.append(\"Yes\")\n        else:\n            if rp > rq:\n                rp, rq = rq, rp\n            if (rp, rq) in forbidden_pairs:\n                out.append(\"No\")\n            else:\n                out.append(\"Yes\")\n\n    sys.stdout.write(\"\\n\".join(out))\n\nif __name__ == \"__main__\":\n    solve()\n```",
