        "input_tokens": 1276,
        "output_tokens": 109,
        "total_tokens": 1385
      },
      "provider": "openrouter",
      "error": null
    },
    "cost": 0.00020916,
    "accuracy": 0.23,
    "for_optimality": false
  },
