s from x=A to x=B-1 and y=C to y=D-1\n    \n    # Create a boolean array for all possible unit squares\n    covered = [[False] * 100 for _ in range(100)]\n    \n    for A, B, C, D in rectangles:\n        # Rectangle covers x in [A, B] and y in [C, D]\n        # So unit squares with lower-left corner at (x, y) where A ≤ x < B and C ≤ y < D\n        for x in range(A, B):\n            for y in range(C, D):\n                if 0 <= x < 100 and 0 <= y < 100:\n                    covered[x][y] = True\n    \n    # Count covered unit squares\n    total_area = 0\n    for i in range(100):\n        for j in range(100):\n            if covered[i][j]:\n                total_area += 1\n    \n    print(total_area)\n\nsolve()\n```",
