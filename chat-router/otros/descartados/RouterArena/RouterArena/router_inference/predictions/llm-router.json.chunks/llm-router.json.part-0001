      "generated_answer": "```python\nimport sys\n\ndef solve():\n    # Read input\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    n = int(input_data[0])\n    h = int(input_data[1])\n    w = int(input_data[2])\n    \n    tiles = []\n    idx = 3\n    for _ in range(n):\n        a = int(input_data[idx])\n        b = int(input_data[idx+1])\n        tiles.append((a, b))\n        idx += 2\n\n    # Grid represented as a bitmask or 2D array\n    # Since H, W <= 10, a tuple of tuples or a flat array works\n    grid = [[False for _ in range(w)] for _ in range(h)]\n\n    def can_place(r, c, dh, dw, current_grid):\n        if r + dh > h or c + dw > w:\n            return False\n        for i in range(r, r + dh):\n            for j in range(c, c + dw):\n                if current_grid[i][j]:\n                    return False\n        return True\n\n    def fill(r, c, dh, dw, current_grid, val):\n        for i in range(r, r + dh):\n            for j in range(c, c + dw):\n                current_grid[i][j] = val\n\n    def backtrack(tiles_used_mask, current_grid):\n        # Find first empty cell\n        first_empty = None\n        for r in range(h):\n            for c in range(w):\n                if not current_grid[r][c]:\n                    first_empty = (r, c)\n                    break\n            if first_empty: break\n        \n        if not first_empty:\n            return True\n        \n        r, c = first_empty\n        \n        for i in range(n):\n            if not (tiles_used_mask & (1 << i)):\n                a, b = tiles[i]\n                # Try both orientations (a x b) and (b x a)\n                orientations = set([(a, b), (b, a)])\n                for dh, dw in orientations:\n                    if can_place(r, c, dh, dw, current_grid):\n                        fill(r, c, dh, dw, current_grid, True)\n                        if backtrack(tiles_used_mask | (1 << i), current_grid):\n                            return True\n                        fill(r, c, dh, dw, current_grid, False)\n        return False\n\n    if backtrack(0, grid):\n        print(\"Yes\")\n    else:\n        print(\"No\")\n\nif __name__ == \"__main__\":\n    solve()\n```",
