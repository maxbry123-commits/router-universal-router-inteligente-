        "input_tokens": 376,
        "output_tokens": 84,
        "total_tokens": 460
      },
      "provider": "openrouter",
      "error": null
    },
    "cost": 7.616e-05,
    "accuracy": 0.8095238095238094,
    "for_optimality": false
  },
