        "input_tokens": 593,
        "output_tokens": 106,
        "total_tokens": 699
      },
      "provider": "openrouter",
      "error": null
    },
    "cost": 0.0001127,
    "accuracy": 0.5257142857142858,
    "for_optimality": false
  },
