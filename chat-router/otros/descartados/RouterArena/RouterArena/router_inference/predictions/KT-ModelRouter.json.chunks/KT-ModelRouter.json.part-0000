      "generated_answer": "```python\nimport sys\n\ndef solve():\n    # Read all input\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    H = int(input_data[0])\n    W = int(input_data[1])\n    grid = input_data[2:]\n    \n    MOD = 998244353\n    \n    # Initial green cells and red cells\n    green_cells = []\n    red_cells = []\n    for r in range(H):\n        for c in range(W):\n            if grid[r][c] == '#':\n                green_cells.append((r, c))\n            else:\n                red_cells.append((r, c))\n                \n    # Calculate current number of green connected components (C)\n    visited = [[False for _ in range(W)] for _ in range(H)]\n    current_components = 0\n    for r, c in green_cells:\n        if not visited[r][c]:\n            current_components += 1\n            stack = [(r, c)]\n            visited[r][c] = True\n            while stack:\n                curr_r, curr_c = stack.pop()\n                for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n                    nr, nc = curr_r + dr, curr_c + dc\n                    if 0 <= nr < H and 0 <= nc < W and grid[nr][nc] == '#' and not visited[nr][nc]:\n                        visited[nr][nc] = True\n                        stack.append((nr, nc))\n    \n    # DSU to find which component each green cell belongs to\n    parent = {}\n    def find(i):\n        if parent[i] == i:\n            return i\n        parent[i] = find(parent[i])\n        return parent[i]\n    \n    def union(i, j):\n        root_i = find(i)\n        root_j = find(j)\n        if root_i != root_j:\n            parent[root_i] = root_j\n            return True\n        return False\n\n    for r, c in green_cells:\n        parent[(r, c)] = (r, c)\n        \n    for r, c in green_cells:\n        for dr, dc in [(0, 1), (1, 0)]:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and grid[nr][nc] == '#':\n                union((r, c), (nr, nc))\n                \n    # For each red cell, calculate the change in components if it turns green\n    # New Components = Current Components + 1 - (number of distinct green components it connects)\n    total_sum = 0\n    for r, c in red_cells:\n        neighboring_components = set()\n        for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < H and 0 <= nc < W and grid[nr][nc] == '#':\n                neighboring_components.add(find((nr, nc)))\n        \n        components_after = current_components + 1 - len(neighboring_components)\n        total_sum = (total_sum + components_after) % MOD\n        \n    # Expected Value = total_sum / count of red cells\n    num_red = len(red_cells)\n    # Modulo inverse using Fermat's Little Theorem\n    inv_num_red = pow(num_red, MOD - 2, MOD)\n    \n    print((total_sum * inv_num_red) % MOD)\n\nif __name__ == \"__main__\":\n    # Increase recursion depth for deep DSU/DFS\n    sys.setrecursionlimit(2000000)\n    solve()\n```",
