    "generated_result": {
      "generated_answer": "```python\nimport sys\n\ndef rotate(shape):\n    \"\"\"Rotates a 4x4 grid 90 degrees clockwise.\"\"\"\n    new_shape = [['.' for _ in range(4)] for _ in range(4)]\n    for r in range(4):\n        for c in range(4):\n            new_shape[c][3-r] = shape[r][c]\n    return new_shape\n\ndef get_all_rotations(shape):\n    \"\"\"Returns a list of the 4 possible rotations of the 4x4 grid.\"\"\"\n    rots = []\n    curr = shape\n    for _ in range(4):\n        rots.append(curr)\n        curr = rotate(curr)\n    return rots\n\ndef get_normalized_coords(shape):\n    \"\"\"Extracts coordinates of '#' and shifts them to start at (0, 0).\"\"\"\n    coords = []\n    for r in range(4):\n        for c in range(4):\n            if shape[r][c] == '#':\n                coords.append((r, c))\n    if not coords:\n        return []\n    min_r = min(r for r, c in coords)\n    min_c = min(c for r, c in coords)\n    return sorted([(r - min_r, c - min_c) for r, c in coords])\n\ndef solve():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    raw_grids = []\n    for i in range(0, 12, 4):\n        grid = [list(row) for row in input_data[i:i+4]]\n        raw_grids.append(grid)\n    \n    # For each polyomino, generate all unique normalized shapes (rotations)\n    poly_shapes = []\n    for grid in raw_grids:\n        unique_shapes = set()\n        for rot in get_all_rotations(grid):\n            coords = tuple(get_normalized_coords(rot))\n            unique_shapes.add(coords)\n        poly_shapes.append(list(unique_shapes))\n\n    # Pre-calculate total number of # cells. Must be 16 for Yes.\n    total_cells = sum(sum(row.count('#') for row in grid) for grid in raw_grids)\n    if total_cells != 16:\n        print(\"No\")\n        return\n\n    grid_state = [[False for _ in range(4)] for _ in range(4)]\n\n    def can_place(coords, dr, dc):\n        for r, c in coords:\n            nr, nc = r + dr, c + dc\n            if not (0 <= nr < 4 and 0 <= nc < 4) or grid_state[nr][nc]:\n                return False\n        return True\n\n    def place(coords, dr, dc, val):\n        for r, c in coords:\n            grid_state[r + dr][c + dc] = val\n\n    def backtrack(poly_idx):\n        if poly_idx == 3:\n            # Check if all cells are filled\n            return all(all(row) for row in grid_state)\n        \n        for shape in poly_shapes[poly_idx]:\n            # Try all possible top-left positions for the normalized shape\n            for dr in range(4):\n                for dc in range(4):\n                    if can_place(shape, dr, dc):\n                        place(shape, dr, dc, True)\n                        if backtrack(poly_idx + 1):\n                            return True\n                        place(shape, dr, dc, False)\n        return False\n\n    if backtrack(0):\n        print(\"Yes\")\n    else:\n        print(\"No\")\n\nif __name__ == \"__main__\":\n    solve()\n\n```",
