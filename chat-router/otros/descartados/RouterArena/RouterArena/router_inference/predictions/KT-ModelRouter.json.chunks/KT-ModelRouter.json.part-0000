    "prediction": "google/gemma-4-31b-it",
    "generated_result": {
      "generated_answer": "```python\ndef getSmallestString(s: str, k: int) -> str:\n    res = list(s)\n    n = len(s)\n    \n    for i in range(n):\n        # Check characters from 'a' to 'z' to find the lexicographically smallest\n        for char_code in range(ord('a'), ord('z') + 1):\n            target_char = chr(char_code)\n            \n            # Calculate the cyclic distance between s[i] and target_char\n            diff = abs(ord(s[i]) - char_code)\n            dist = min(diff, 26 - diff)\n            \n            if k >= dist:\n                # We can afford to change s[i] to target_char\n                res[i] = target_char\n                k -= dist\n                break\n                \n    return \"\".join(res)\n```",
