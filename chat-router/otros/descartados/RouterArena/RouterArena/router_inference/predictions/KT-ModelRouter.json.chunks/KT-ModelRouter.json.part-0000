in range(m):\n        for j in range(26):\n            prefL[i+1][j] = prefL[i][j]\n            prefR[i+1][j] = prefR[i][j]\n        prefL[i+1][ord(L[i]) - ord('a')] += 1\n        prefR[i+1][ord(R_rev[i]) - ord('a')] += 1\n\n    # To check if L[i] == R_rev[i] in range [l, r] except for some sub-ranges:\n    # Use a prefix sum of mismatches.\n    mismatch = [0] * m\n    for i in range(m):\n        mismatch[i] = 1 if L[i] != R_rev[i] else 0\n    prefM = [0] * (m + 1)\n    for i in range(m):\n        prefM[i+1] = prefM[i] + mismatch[i]\n\n    def get_sum(pref, l, r):\n        if l > r: return 0\n        return pref[r+1] - pref[l]\n\n    def get_cnt(pref, l, r, char_idx):\n        if l > r: return 0\n        return pref[r+1][char_idx] - pref[l][char_idx]\n\n    results = []\n    for a, b, c, d in queries:\n        cp, dp = m - 1 - d, m - 1 - c\n        # 1. Check mismatch outside [a, b] U [cp, dp]\n        # The union is [min(a, cp), max(b, dp)]? No.\n        # It's simpler to check: total mismatches - mismatches in [a, b] - mismatches in [cp, dp] + mismatches in [a, b] ∩ [cp, dp]\n        overlap_l, overlap_r = max(a, cp), min(b, dp)\n        total_mismatches = prefM[m]\n        mismatches_in_union = get_sum(prefM, a, b) + get_sum(prefM, cp, dp) - (get_sum(prefM, overlap_l, overlap_r) if overlap_l <= overlap_r else 0)\n        \n        if total_mismatches - mismatches_in_union > 0:\n            results.append(False)\n            continue\n            \n        # 2. Check if pools are sufficient\n        # L_pool: characters in L[a...b]\n        # R_pool: characters in R_rev[cp...dp]\n        # Fixed requirements:\n        # For i in [cp, dp] but not in [a, b], L[i] must be in R_pool.\n        # For i in [a, b] but not in [cp, dp], R_rev[i] must be in L_pool.\n        # For i in [a, b] ∩ [cp, dp], they can be matched using whatever is left.\n        \n        L_pool = [get_cnt(prefL, a, b, j) for j in range(26)]\n        R_pool = [get_cnt(prefR, cp, dp, j) for j in range(26)]\n        \n        possible = True\n        # Requirements for R_pool from fixed L\n        # i in [cp, dp] \\ [a, b]\n        # This is [cp, a-1] and [b+1, dp]\n        for j in range(26):\n            needed = get_cnt(prefL, cp, a-1, j) + get_cnt(prefL, b+1, dp, j)\n            R_pool[j] -= needed\n            if R_pool[j] < 0:\n                possible = False\n                break\n        if not possible:\n            results.append(False)\n            continue\n            \n        # Requirements for L_pool from fixed R_rev\n        # i in [a, b] \\ [cp, dp]\n        # This is [a, cp-1] and [dp+1, b]\n        for j in range(26):\n            needed = get_cnt(prefR, a, cp-1, j) + get_cnt(prefR, dp+1, b, j)\n            L_pool[j] -= needed\n            if L_pool[j] < 0:\n                possible = False\n                break\n        if not possible:\n            results.append(False)\n            continue\n            \n        # Finally, the remaining pools must be identical for the overlap [overlap_l, overlap_r]\n        # The number of characters remaining in L_pool must equal the number of characters remaining in R_pool\n        # and their sums must match for each character.\n        # The remaining characters in L_pool and R_pool are exactly the ones available for the overlap.\n        # Since they must match one-to-one, the counts must be identical.\n        for j in range(26):\n            if L_pool[j] != R_pool[j]:\n                possible = False\n                break\n        \n        results.append(possible)\n        \n    return results\n```",
