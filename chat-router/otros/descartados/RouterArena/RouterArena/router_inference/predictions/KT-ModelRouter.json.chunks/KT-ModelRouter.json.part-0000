      \n    # Case 2: Last lowercase at index i\n    fixed_u_set = set()\n    q_count = 0\n    possible = True\n    \n    # Precompute prefix_ways for all i\n    prefix_ways = [0] * n\n    for i in range(n):\n        if possible:\n            q = q_count\n            fu = len(fixed_u_set)\n            ways = 0\n            # Precompute 26^(q-k) efficiently\n            p26 = pow(26, q, MOD)\n            inv26 = pow(26, MOD-2, MOD)\n            curr_inv_pow = 1\n            for k in range(min(q, 26 - fu) + 1):\n                term = (nCr_mod(q, k) * perm_mod(26 - fu, k)) % MOD\n                term = (term * p26) % MOD\n                term = (term * curr_inv_pow) % MOD\n                ways = (ways + term) % MOD\n                curr_inv_pow = (curr_inv_pow * inv26) % MOD\n            prefix_ways[i] = ways\n        \n        char = s[i]\n        if 'A' <= char <= 'Z':\n            if char in fixed_u_set: possible = False\n            fixed_u_set.add(char)\n        elif char == '?':\n            q_count += 1\n            \n    # Now iterate on the position of the last lowercase i\n    # For the suffix S[i+1...n-1], it must be all uppercase.\n    # Precompute suffix_upper_ways\n    suffix_upper_ways = [1] * (n + 1)\n    q_suffix = 0\n    possible_suffix = True\n    for i in range(n - 1, -1, -1):\n        char = s[i]\n        if 'a' <= char <= 'z':\n            possible_suffix = False\n        elif char == '?':\n            q_suffix += 1\n        \n        if not possible_suffix:\n            suffix_upper_ways[i] = 0\n        else:\n            suffix_upper_ways[i] = pow(26, q_suffix, MOD)\n            \n    for i in range(n):\n        # Last lowercase at index i\n        # S[i] must be lowercase\n        if 'A' <= s[i] <= 'Z': continue\n        ways_i = 26 if s[i] == '?' else 1\n        \n        # S[i+1...n-1] must be uppercase\n        ways_suffix = suffix_upper_ways[i+1]\n        \n        # S[0...i-1] must be handled\n        if i == n - 1:\n            ways_pref