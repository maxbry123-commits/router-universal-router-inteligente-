    "generated_result": {
      "generated_answer": "```python\ndef numberOfBeautifulIntegers(low: int, high: int, k: int) -> int:\n    from functools import lru_cache\n\n    def count_beautiful(n_str):\n        # dp(index, diff, remainder, is_less, is_started)\n        # diff: count of even digits - count of odd digits\n        # is_started: boolean to handle leading zeros\n        @lru_cache(None)\n        def dp(idx, diff, rem, is_less, is_started):\n            if idx == len(n_str):\n                return 1 if (is_started and diff == 0 and rem == 0) else 0\n            \n            res = 0\n            # Option to continue not starting the number (leading zeros)\n            if not is_started:\n                res += dp(idx + 1, 0, 0, True, False)\n            \n            limit = int(n_str[idx]) if not is_less else 9\n            \n            start_digit = 1 if not is_started else 0\n            for digit in range(start_digit, limit + 1):\n                new_is_less = is_less or (digit < limit)\n                new_diff = diff + (1 if digit % 2 == 0 else -1)\n                new_rem = (rem * 10 + digit) % k\n                res += dp(idx + 1, new_diff, new_rem, new_is_less, True)\n            \n            return res\n\n        return dp(0, 0, 0, False, False)\n\n    # The count of beautiful integers in [low, high] is count(high) - count(low - 1)\n    # Use a helper to clear cache between the two calls\n    ans_high = count_beautiful(str(high))\n    # We need to reset the cache for the second call because n_str changes\n    import sys\n    # Instead of clearing sys.cache, we just wrap the logic\n    # Since we are defining count_beautiful inside the main function, \n    # calling it twice with different strings will instantiate different dp functions.\n    \n    # To avoid potential issues with the logic above, I'll implement a clean split:\n    def solve(n):\n        if n == 0: return 0\n        s = str(n)\n        @lru_cache(None)\n        def f(idx, diff, rem, is_less, is_started):\n            if idx == len(s):\n                return 1 if (is_started and diff == 0 and rem == 0) else 0\n            res = 0\n            if not is_started:\n                res += f(idx + 1, 0, 0, True, False)\n            limit = int(s[idx]) if not is_less else 9\n            start = 1 if not is_started else 0\n            for d in range(start, limit + 1):\n                res += f(idx + 1, diff + (1 if d % 2 == 0 else -1), (rem * 10 + d) % k, is_less or (d < limit), True)\n            return res\n        return f(0, 0, 0, False, False)\n\n    return solve(high) - solve(low - 1)\n```",
