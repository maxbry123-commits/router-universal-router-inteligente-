      "generated_answer": "```python\nimport sys\n\ndef solve():\n    # Read all input\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    N = int(input_data[0])\n    M = int(input_data[1])\n    \n    # Use a large value for infinity\n    INF = float('inf')\n    dist = [[INF] * N for _ in range(N)]\n    for i in range(N):\n        dist[i][i] = 0\n        \n    idx = 2\n    for _ in range(M):\n        u = int(input_data[idx]) - 1\n        v = int(input_data[idx+1]) - 1\n        w = int(input_data[idx+2])\n        dist[u][v] = w\n        idx += 3\n        \n    # Floyd-Warshall to find shortest paths between all pairs\n    for k in range(N):\n        for i in range(N):\n            for j in range(N):\n                if dist[i][k] != INF and dist[k][j] != INF:\n                    if dist[i][j] > dist[i][k] + dist[k][j]:\n                        dist[i][j] = dist[i][k] + dist[k][j]\n    \n    # dp[mask][last_vertex] = min cost to visit all vertices in mask, ending at last_vertex\n    # The mask represents the set of vertices visited at least once.\n    dp = [[INF] * N for _ in range(1 << N)]\n    \n    # Initial states: start at any vertex i\n    for i in range(N):\n        dp[1 << i][i] = 0\n        \n    # Bitmask DP\n    for mask in range(1, 1 << N):\n        for u in range(N):\n            if dp[mask][u] == INF:\n                continue\n            \n            # Try moving to a vertex v that hasn't been visited (or even if it has, \n            # Floyd-Warshall shortest paths handle the \"intermediate\" visits)\n            for v in range(N):\n                if dist[u][v] == INF:\n                    continue\n                \n                new_mask = mask | (1 << v)\n                new_dist = dp[mask][u] + dist[u][v]\n                if dp[new_mask][v] > new_dist:\n                    dp[new_mask][v] = new_dist\n                    \n    # The answer is the minimum value in dp[(1 << N) - 1]\n    ans = min(dp[(1 << N) - 1])\n    \n    if ans == INF:\n        print(\"No\")\n    else:\n        print(int(ans))\n\nif __name__ == \"__main__\":\n    solve()\n\n```",
