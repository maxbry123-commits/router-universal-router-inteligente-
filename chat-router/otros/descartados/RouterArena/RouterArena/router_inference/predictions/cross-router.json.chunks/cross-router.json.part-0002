      "token_usage": {
        "input_tokens": 632,
        "output_tokens": 5,
        "total_tokens": 637
      },
      "provider": "openrouter",
      "error": null
    },
    "cost": 0.00016549999999999998,
    "accuracy": 1.0,
    "for_optimality": true
  },
