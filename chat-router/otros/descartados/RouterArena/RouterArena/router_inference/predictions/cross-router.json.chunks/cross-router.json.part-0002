      "generated_answer": "```python\ndef medianOfUniquenessArray(nums):\n    n = len(nums)\n    total_subarrays = n * (n + 1) // 2\n    median_pos = (total_subarrays + 1) // 2  # 1-indexed position of median\n\n    def count_at_most(k):\n        left = 0\n        count = 0\n        freq = {}\n        distinct = 0\n        for right in range(n):\n            val = nums[right]\n            freq[val] = freq.get(val, 0) + 1\n            if freq[val] == 1:\n                distinct += 1\n            while distinct > k:\n                left_val = nums[left]\n                freq[left_val] -= 1\n                if freq[left_val] == 0:\n                    distinct -= 1\n                left += 1\n            count += (right - left + 1)\n        return count\n\n    lo, hi = 1, n\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if count_at_most(mid) >= median_pos:\n            hi = mid\n        else:\n            lo = mid + 1\n    return lo\n```",
