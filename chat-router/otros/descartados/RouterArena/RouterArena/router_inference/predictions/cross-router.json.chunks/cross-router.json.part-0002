      "generated_answer": "```python\nimport sys\n\ndef solve() -> None:\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    N = int(next(it))\n    H = int(next(it))\n    W = int(next(it))\n    tiles = [(int(next(it)), int(next(it))) for _ in range(N)]\n\n    # Early check on total available area\n    total_area = sum(a * b for a, b in tiles)\n    if total_area < H * W:\n        print(\"No\")\n        return\n\n    # Sort tiles by area descending to improve backtracking performance\n    tiles.sort(key=lambda x: x[0] * x[1], reverse=True)\n\n    # Precompute orientations for each tile\n    oriented = []\n    for a, b in tiles:\n        if a == b:\n            oriented.append(((a, b),))\n        else:\n            oriented.append(((a, b), (b, a)))\n\n    grid = [[0] * W for _ in range(H)]\n    used = [False] * N\n\n    def backtrack() -> bool:\n        # Find the first uncovered cell (top-leftmost)\n        r = c = -1\n        for i in range(H):\n            for j in range(W):\n                if grid[i][j] == 0:\n                    r, c = i, j\n                    break\n            if r != -1:\n                break\n\n        if r == -1:          # All cells are covered\n            return True\n\n        for idx in range(N):\n            if used[idx]:\n                continue\n            for w, h in oriented[idx]:\n                if r + h > H or c + w > W:\n                    continue\n                # Check whether the rectangle is free\n                ok = True\n                for i in range(r, r + h):\n                    for j in range(c, c + w):\n                        if grid[i][j] == 1:\n                            ok = False\n                            break\n                    if not ok:\n                        break\n                if not ok:\n                    continue\n\n                # Place the tile\n                for i in range(r, r + h):\n                    for j in range(c, c + w):\n