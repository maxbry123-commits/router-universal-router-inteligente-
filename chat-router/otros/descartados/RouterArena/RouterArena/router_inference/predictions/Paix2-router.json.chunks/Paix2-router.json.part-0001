        "input_tokens": 845,
        "output_tokens": 79,
        "total_tokens": 924
      },
      "provider": "agnes",
      "error": null
    },
    "cost": 3.7199999999999996e-05,
    "accuracy": 0.7460815047021944,
    "for_optimality": false
  },
