        "input_tokens": 1238,
        "output_tokens": 27,
        "total_tokens": 1265
      },
      "provider": "agnes",
      "error": null
    },
    "cost": 4.119e-05,
    "accuracy": 0.47959183673469374,
    "for_optimality": false
