        "input_tokens": 1177,
        "output_tokens": 111,
        "total_tokens": 1288
      },
      "provider": "agnes",
      "error": null
    },
    "cost": 5.196e-05,
    "accuracy": 0.18888888888888886,
    "for_optimality": false
