      "token_usage": {
        "input_tokens": 587,
        "output_tokens": 55,
        "total_tokens": 642
      },
      "provider": "apiyi",
      "error": null
    },
    "cost": 0.00022925,
    "accuracy": 0.0,
    "for_optimality": true
