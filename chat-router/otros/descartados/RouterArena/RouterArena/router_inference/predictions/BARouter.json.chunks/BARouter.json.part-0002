        "input_tokens": 743,
        "output_tokens": 41,
        "total_tokens": 784
      },
      "provider": "apiyi",
      "error": null
    },
    "cost": 0.00024724999999999997,
    "accuracy": 1.0,
    "for_optimality": true
  },
