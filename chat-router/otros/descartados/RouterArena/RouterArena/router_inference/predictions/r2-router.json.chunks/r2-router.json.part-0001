      "generated_answer": "```python\nimport sys\nfrom collections import defaultdict, deque\n\ndef can_reach(graph, start, end, n):\n    if start == end:\n        return True\n    visited = [False] * (n + 1)\n    queue = deque([start])\n    visited[start] = True\n    \n    while queue:\n        node = queue.popleft()\n        for neighbor in graph[node]:\n            if neighbor == end:\n                return True\n            if not visited[neighbor]:\n                visited[neighbor] = True\n                queue.append(neighbor)\n    return False\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    # Parse input\n    idx = 0\n    N = int(data[idx])\n    M = int(data[idx + 1])\n    idx += 2\n    \n    graph = defaultdict(set)\n    \n    for _ in range(M):\n        u = int(data[idx])\n        v = int(data[idx + 1])\n        idx += 2\n        if u != v:  # ignore self-loop for connectivity\n            graph[u].add(v)\n            graph[v].add(u)\n    \n    K = int(data[idx])\n    idx += 1\n    forbidden_pairs = []\n    for _ in range(K):\n        x = int(data[idx])\n        y = int(data[idx + 1])\n        idx += 2\n        forbidden_pairs.append((x, y))\n    \n    Q = int(data[idx])\n    idx += 1\n    queries = []\n    for _ in range(Q):\n        p = int(data[idx])\n        q = int(data[idx + 1])\n        idx += 2\n        queries.append((p, q))\n    \n    # Process each query\n    for p, q in queries:\n        # Check if adding edge (p, q) creates a path between any forbidden pair\n        is_good = True\n        for x, y in forbidden_pairs:\n            # If there's already a path between x and y, then original graph isn't good \u2014 but problem says it is\n            # So we just check if adding (p,q) creates a new path between x and y\n            if can_reach(graph, x, y, N):\n                continue  # already connected, so still bad, but we know original is good so this shouldn't happen\n            # Try to see if adding (p,q) makes x and y connected\n            # We do BFS from x and see if we can reach y via the original graph plus the new edge\n            # But since we're only adding one edge, we can check if there's a path from x to p and from y to q, or x to q and y to p\n            # This is equivalent to checking if x and y become connected when we add (p,q)\n            \n            # Let's simulate adding the edge temporarily\n            # Instead of rebuilding the graph, we check if there exists a path from x to y through the new edge\n            # That means: (x -> p) and (q -> y) OR (x -> q) and (p -> y), possibly through other nodes\n            \n            # We'll run BFS from x, allowing use of the new edge once\n            visited = [False] * (N + 1)\n            queue = deque()\n            queue.append((x, False))  # (node, used_new_edge)\n            visited[x] = True\n            \n            found = False\n            while queue:\n                node, used = queue.popleft()\n                for neighbor in graph[node]:\n                    if neighbor == y:\n                        found = True\n                        break\n                    if not visited[neighbor]:\n                        visited[neighbor] = True\n                        queue.append((neighbor, used))\n                \n                if not used:\n                    # Try using the new edge\n                    if node == p and not visited[q]:\n                        visited[q] = True\n                        queue.append((q, True))\n                    elif node == q and not visited[p]:\n                        visited[p] = True\n                        queue.append((p, True))\n                \n                if found:\n                    break\n            \n            if found:\n                is_good = False\n                break\n        \n        print(\"Yes\" if is_good else \"No\")\n\nif __name__ == \"__main__\":\n    main()\n```",
