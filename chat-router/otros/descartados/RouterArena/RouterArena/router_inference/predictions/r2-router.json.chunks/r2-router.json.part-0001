 MOD\n    \n    return result\n\n\ndef sumOfPowers(nums):\n    MOD = 10**9 + 7\n    nums.sort()\n    n = len(nums)\n    result = 0\n    \n    for i in range(n):\n        min_val = nums[i]\n        cnt = 1\n        \n        for j in range(i, n):\n            max_val = nums[j]\n            power = (max_val * max_val % MOD) * min_val % MOD\n            power = (power * cnt) % MOD\n            result = (result + power) % MOD\n            cnt = (cnt * 2) % MOD\n    \n    return result\n```",
