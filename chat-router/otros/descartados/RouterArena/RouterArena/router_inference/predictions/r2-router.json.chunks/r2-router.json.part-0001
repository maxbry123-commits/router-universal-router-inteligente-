      "generated_answer": "```python\nimport sys\nfrom itertools import permutations\n\ndef solve():\n    data = sys.stdin.read().split()\n    n = int(data[0])\n    h = int(data[1])\n    w = int(data[2])\n    tiles = []\n    index = 3\n    for _ in range(n):\n        a = int(data[index])\n        b = int(data[index + 1])\n        tiles.append((a, b))\n        index += 2\n    \n    total_area = h * w\n    found = False\n    \n    # Try all subsets of tiles\n    from itertools import combinations\n    for r in range(1, n + 1):\n        if found:\n            break\n        for subset in combinations(tiles, r):\n            # Try all permutations of the subset\n            for perm in permutations(subset):\n                # Try all possible rotations (each tile can be used as (a,b) or (b,a))\n                def generate_orientations(tile_list):\n                    if not tile_list:\n                        yield []\n                    else:\n                        first = tile_list[0]\n                        rest = tile_list[1:]\n                        for orientation in [(first[0], first[1]), (first[1], first[0])]:\n                            for rest_orientation in generate_orientations(rest):\n                                yield [orientation] + rest_orientation\n                \n                for orientations in generate_orientations(perm):\n                    # Check if the total area matches\n                    area = sum(a * b for a, b in orientations)\n                    if area != total_area:\n                        continue\n                    \n                    # Try to place the rectangles in the grid\n                    grid = [[False] * w for _ in range(h)]\n                    \n                    def can_place(rect, r, c):\n                        a, b = rect\n                        if r + a > h or c + b > w:\n                            return False\n                        for i in range(r, r + a):\n                            for j in range(c, c + b):\n                                if grid[i][j]:\n                                    return False\n                        return True\n                    \n                    def place(rect, r, c, mark):\n                        a, b = rect\n                        for i in range(r, r + a):\n                            for j in range(c, c + b):\n                                grid[i][j] = mark\n                    \n                    def backtrack(idx):\n                        if idx == len(orientations):\n                            return True\n                        a, b = orientations[idx]\n                        for r in range(h):\n                            for c in range(w):\n                                if can_place((a, b), r, c):\n                                    place((a, b), r, c, True)\n                                    if backtrack(idx + 1):\n                                        return True\n                                    place((a, b), r, c, False)\n                                if can_place((b, a), r, c):\n                                    place((b, a), r, c, True)\n                                    if backtrack(idx + 1):\n                                        return True\n                                    place((b, a), r, c, False)\n                        return False\n                    \n                    if backtrack(0):\n                        found = True\n                        break\n            if found:\n                break\n    \n    print(\"Yes\" if found else \"No\")\n\nsolve()\n```",
