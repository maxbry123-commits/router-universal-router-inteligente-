      "generated_answer": "```python\ndef main():\n    import sys\n    data = sys.stdin.read().strip().split('\\n')\n    n = int(data[0])\n    rectangles = []\n    for i in range(1, n+1):\n        parts = list(map(int, data[i].split()))\n        rectangles.append(parts)\n    \n    # Use coordinate compression and 2D difference array\n    xs = set()\n    ys = set()\n    for a, b, c, d in rectangles:\n        xs.add(a)\n        xs.add(b)\n        ys.add(c)\n        ys.add(d)\n    \n    xs = sorted(xs)\n    ys = sorted(ys)\n    x_index = {x: i for i, x in enumerate(xs)}\n    y_index = {y: i for i, y in enumerate(ys)}\n    \n    # Create grid with size len(xs)-1 by len(ys)-1\n    diff = [[0] * (len(ys)) for _ in range(len(xs))]\n    \n    for a, b, c, d in rectangles:\n        x1 = x_index[a]\n        x2 = x_index[b]\n        y1 = y_index[c]\n        y2 = y_index[d]\n        diff[x1][y1] += 1\n        diff[x2][y1] -= 1\n        diff[x1][y2] -= 1\n        diff[x2][y2] += 1\n    \n    # Compute prefix sum to get actual coverage count\n    grid = [[0] * (len(ys)) for _ in range(len(xs))]\n    for i in range(len(xs)):\n        for j in range(len(ys)):\n            val = diff[i][j]\n            if i > 0:\n                val += grid[i-1][j]\n            if j > 0:\n                val += grid[i][j-1]\n            if i > 0 and j > 0:\n                val -= grid[i-1][j-1]\n            grid[i][j] = val\n    \n    # Calculate total area covered by at least one sheet\n    total_area = 0\n    for i in range(len(xs) - 1):\n        for j in range(len(ys) - 1):\n            if grid[i][j] > 0:\n                width = xs[i+1] - xs[i]\n                height = ys[j+1] - ys[j]\n                total_area += width * height\n    \n    print(total_area)\n\nif __name__ == \"__main__\":\n    main()\n```",
