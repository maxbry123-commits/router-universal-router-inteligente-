ts:\n        # Calculate total area of this subset\n        area = 0\n        subset_tiles = []\n        for i in subset:\n            a, b = tiles[i]\n            area += a * b\n            subset_tiles.append((a, b))\n        \n        if area != grid_area:\n            continue\n        \n        # For this subset, try to pack the tiles into HxW grid\n        # Try all permutations of this subset\n        for perm in permutations(subset_tiles):\n            # Try to fill grid row by row, left to right\n            # Use recursive backtracking\n            grid = [[False] * W for _ in range(H)]\n            \n            def place_tile(r, c, h, w, val):\n                # Place or unplace a tile of size h x w at position (r,c)\n                if r + h > H or c + w > W:\n                    return False\n                for i in range(r, r + h):\n                    for j in range(c, c + w):\n                        if grid[i][j] != (not val):\n                            return False\n                for i in range(r, r + h):\n                    for j in range(c, c + w):\n                        grid[i][j] = val\n                return True\n            \n            def solve_recursive(tile_idx):\n                if tile_idx >= len(perm):\n                    # Check if all cells are filled\n                    for i in range(H):\n                        for j in range(W):\n                            if not grid[i][j]:\n                                return False\n                    return True\n                \n                h, w = perm[tile_idx]\n                # Try without rotation\n                for r in range(H):\n                    for c in range(W):\n                        if not grid[r][c]:  # Find first empty cell\n                            # Try placing tile (h, w)\n                            if place_tile(r, c, h, w, True):\n                                if solve_recursive(tile_idx + 1):\n                                    return True\n                                place_tile(r, c, h, w, False)\n                            \n                            # Try placing tile (w, h) - rotated\n                            if h != w:  # Only try if different\n                                if place_tile(r, c, w, h, True):\n                                    if solve_recursive(tile_idx + 1):\n                                        return True\n                                    place_tile(r, c, w, h, False)\n                            \n                            # Only place at first empty cell\n                            return False\n                return False\n            \n            if solve_recursive(0):\n                found_solution = True\n                break\n        \n        if found_solution:\n            break\n    \n    print(\"Yes\" if found_solution else \"No\")\n\nsolve()\n```",
