\n00110\r\n10100",
    "prediction": "gemini-3-flash-preview",
    "generated_result": {
      "generated_answer": "```python\nimport sys\n\ndef shift_grid_outer_layer():\n    # Read all input from stdin\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    n = int(input_data[0])\n    grid = [list(row) for row in input_data[1:]]\n    \n    # Store the result in a new grid (copying the inner parts)\n    res = [row[:] for row in grid]\n    \n    # Define the coordinates of the outer squares in clockwise order\n    outer_coords = []\n    \n    # Top row: (0, 0) to (0, n-1)\n    for j in range(n):\n        outer_coords.append((0, j))\n    \n    # Right column: (1, n-1) to (n-1, n-1)\n    for i in range(1, n):\n        outer_coords.append((i, n-1))\n        \n    # Bottom row: (n-1, n-2) down to (n-1, 0)\n    for j in range(n-2, -1, -1):\n        outer_coords.append((n-1, j))\n        \n    # Left column: (n-2, 0) down to (1, 0)\n    for i in range(n-2, 0, -1):\n        outer_coords.append((i, 0))\n        \n    # Shift the values clockwise\n    # The value at outer_coords[i] should move to outer_coords[i+1]\n    # So res[outer_coords[i+1]] = grid[outer_coords[i]]\n    num_outer = len(outer_coords)\n    for k in range(num_outer):\n        curr_r, curr_c = outer_coords[k]\n        next_r, next_c = outer_coords[(k + 1) % num_outer]\n        res[next_r][next_c] = grid[curr_r][curr_c]\n        \n    # Print the resulting grid\n    for row in res:\n        print(\"\".join(row))\n\nif __name__ == \"__main__\":\n    shift_grid_outer_layer()\n```",
