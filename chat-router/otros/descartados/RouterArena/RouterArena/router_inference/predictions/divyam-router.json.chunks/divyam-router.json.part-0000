     val = heapq.heappop(top_heap)\n        top_sum -= val\n        top_size -= 1\n        return val\n\n    def add_to_rest(val):\n        nonlocal rest_size\n        heapq.heappush(rest_heap, -val)\n        rest_size += 1\n\n    def pop_from_rest():\n        nonlocal rest_size\n        clean(rest_heap, rest_del, True)\n        val = -heapq.heappop(rest_heap)\n        rest_size -= 1\n        return val\n\n    # Initialize heaps with dummy zeros to represent starting state\n    # We only need to push what's necessary to maintain sizes\n    for _ in range(K):\n        heapq.heappush(top_heap, 0)\n    for _ in range(N-K):\n        heapq.heappush(rest_heap, 0)\n\n    ptr = 3\n    results = []\n    for _ in range(Q):\n        idx = int(input_data[ptr])\n        new_val = int(input_data[ptr+1])\n        ptr += 2\n        \n        old_val = A[idx]\n        A[idx] = new_val\n        \n        # Remove old_val\n        clean(top_heap, top_del)\n        if top_heap and old_val >= top_heap[0]:\n            top_sum -= old_val\n            top_size -= 1\n            top_del[old_val] = top_del.get(old_val, 0) + 1\n        else:\n            rest_size -= 1\n            rest_del[old_val] = rest_del.get(old_val, 0) + 1\n        \n        # Add new_val (initially to rest, then rebalance)\n        add_to_rest(new_val)\n        \n        # Rebalance: top should have exactly K elements\n        while top_size < K:\n            add_to_top(pop_from_rest())\n        \n        # Ensure elements in top are all >= elements in rest\n        while True:\n            clean(top_heap, top_del)\n            clean(rest_heap, rest_del, True)\n            if top_heap and rest_heap and top_heap[0] < -rest_heap[0]:\n                t_val = pop_from_top()\n                r_val = pop_from_rest()\n                add_to_top(r_val)\n                add_to_rest(t_val)\n            else:\n                break\n        \n        results.append(str(top_sum))\n    \n    sys.stdout.write(\"\\n\".join(results)