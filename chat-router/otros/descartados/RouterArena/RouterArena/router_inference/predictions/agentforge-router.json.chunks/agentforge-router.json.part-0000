lack:\n                        nr, nc = r + offset_r, c + offset_c\n                        cut_grid[nr][nc] = '#'\n                    \n                    cut_str = [''.join(row) for row in cut_grid]\n                    if cut_str == X:\n                        print(\"Yes\")\n                        return\n    \n    print(\"No\")\n\nif __name__ == \"__main__\":\n    main()\n```",
