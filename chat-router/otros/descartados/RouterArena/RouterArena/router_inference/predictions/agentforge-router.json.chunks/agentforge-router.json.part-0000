                   mid * len(window[len(window)//2:]))\n                \n                best_cost = min(best_cost, cost)\n            \n            if best_cost < float('inf'):\n                total_moves = best_cost + 2 * c  # c changes × 2 moves each\n                ans = min(ans, total_moves)\n    \n    return ans\n```",
