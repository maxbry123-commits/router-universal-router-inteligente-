      "generated_answer": "```python\nimport sys\nfrom itertools import permutations\n\ndef solve():\n    data = sys.stdin.read().split()\n    H = int(data[0])\n    W = int(data[1])\n    \n    A = []\n    index = 2\n    for i in range(H):\n        row = list(map(int, data[index:index+W]))\n        A.append(row)\n        index += W\n    \n    B = []\n    for i in range(H):\n        row = list(map(int, data[index:index+W]))\n        B.append(row)\n        index += W\n    \n    # Check if multisets of elements are same\n    if sorted([x for row in A for x in row]) != sorted([x for row in B for x in row]):\n        print(-1)\n        return\n    \n    min_ops = float('inf')\n    \n    # Try all possible row permutations\n    for row_perm in permutations(range(H)):\n        # Try all possible column permutations\n        for col_perm in permutations(range(W)):\n            valid = True\n            # Check if this permutation transforms A to B\n            transformed = [[0]*W for _ in range(H)]\n            for i in range(H):\n                for j in range(W):\n                    transformed[i][j] = A[row_perm.index(i)][col_perm.index(j)]\n            \n            if transformed == B:\n                # Count row swaps needed for row_perm\n                row_list = list(row_perm)\n                row_swaps = 0\n                temp = row_list[:]\n                for i in range(H):\n                    if temp[i] != i:\n                        pos = temp.index(i)\n                        while pos > i:\n                            temp[pos], temp[pos-1] = temp[pos-1], temp[pos]\n                            pos -= 1\n                            row_swaps += 1\n                \n                # Count column swaps needed for col_perm\n                col_list = list(col_perm)\n                col_swaps = 0\n                temp = col_list[:]\n                for j in range(W):\n                    if temp[j] != j:\n                        pos = temp.index(j)\n        