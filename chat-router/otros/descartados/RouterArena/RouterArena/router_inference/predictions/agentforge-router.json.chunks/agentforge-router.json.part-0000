isited[i][j]:\n                q = deque()\n                q.append((i, j))\n                visited[i][j] = True\n                cells = []\n                boundary = set()\n                while q:\n                    ci, cj = q.popleft()\n                    cells.append((ci, cj))\n                    # check neighbors for safe cells to expand component\n                    for di, dj in [(0,1),(0,-1),(1,0),(-1,0)]:\n                        ni, nj = ci + di, cj + dj\n                        if 0 <= ni < H and 0 <= nj < W:\n                            if safe[ni][nj] and not visited[ni][nj]:\n                                visited[ni][nj] = True\n                                q.append((ni, nj))\n                            elif grid[ni][nj] == '.' and not safe[ni][nj]:\n                                boundary.add((ni, nj))\n                # store component info\n                comp_id = len(component_info)\n                for (ci, cj) in cells:\n                    component_id[ci][cj] = comp_id\n                component_info.append((len(cells), boundary))\n    \n    # compute reachable count for each safe cell\n    reachable = [[0] * W for _ in range(H)]\n    for i in range(H):\n        for j in range(W):\n            if grid[i][j] == '.':\n                if safe[i][j]:\n                    comp_id = component_id[i][j]\n                    size, boundary = component_info[comp_id]\n                    reachable[i][j] = size + len(boundary)\n                else:\n                    reachable[i][j] = 1\n    \n    # find maximum\n    ans = 0\n    for i in range(H):\n        for j in range(W):\n            if grid[i][j] == '.':\n                ans = max(ans, reachable[i][j])\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n```",
