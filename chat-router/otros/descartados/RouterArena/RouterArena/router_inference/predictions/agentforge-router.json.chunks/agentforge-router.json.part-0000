      "generated_answer": "```python\ndef minBalancedPartition(s):\n    n = len(s)\n    memo = {}\n    \n    def is_balanced(sub):\n        if not sub:\n            return False\n        freq = {}\n        for ch in sub:\n            freq[ch] = freq.get(ch, 0) + 1\n        values = list(freq.values())\n        return all(v == values[0] for v in values)\n    \n    def dp(i):\n        if i == n:\n            return 0\n        if i in memo:\n            return memo[i]\n        \n        res = float('inf')\n        for j in range(i + 1, n + 1):\n            if is_balanced(s[i:j]):\n                res = min(res, 1 + dp(j))\n        memo[i] = res\n        return res\n    \n    return dp(0)\n```",
