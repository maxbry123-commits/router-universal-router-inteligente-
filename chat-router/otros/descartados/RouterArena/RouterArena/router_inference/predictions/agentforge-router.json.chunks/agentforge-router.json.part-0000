\n00110\r\n10100",
    "prediction": "Qwen/Qwen3-Coder-Next",
    "generated_result": {
      "generated_answer": "```python\ndef main():\n    import sys\n    data = sys.stdin.read().splitlines()\n    N = int(data[0])\n    grid = [list(map(int, list(data[i+1]))) for i in range(N)]\n    \n    if N == 2:\n        print(''.join(map(str, grid[0])))\n        print(''.join(map(str, grid[1])))\n        return\n    \n    # Collect outer squares in clockwise order starting from (0,0)\n    outer = []\n    # Top row: left to right\n    for j in range(N):\n        outer.append(grid[0][j])\n    # Right column: top+1 to bottom\n    for i in range(1, N):\n        outer.append(grid[i][N-1])\n    # Bottom row: right-1 to left\n    for j in range(N-2, -1, -1):\n        outer.append(grid[N-1][j])\n    # Left column: bottom-1 to top+1\n    for i in range(N-2, 0, -1):\n        outer.append(grid[i][0])\n    \n    # Shift clockwise: move last element to front\n    shifted = [outer[-1]] + outer[:-1]\n    \n    # Reassign values back to outer positions\n    idx = 0\n    # Top row\n    for j in range(N):\n        grid[0][j] = shifted[idx]; idx += 1\n    # Right column\n    for i in range(1, N):\n        grid[i][N-1] = shifted[idx]; idx += 1\n    # Bottom row\n    for j in range(N-2, -1, -1):\n        grid[N-1][j] = shifted[idx]; idx += 1\n    # Left column\n    for i in range(N-2, 0, -1):\n        grid[i][0] = shifted[idx]; idx += 1\n    \n    for row in grid:\n        print(''.join(map(str, row)))\n\nmain()\n```",
