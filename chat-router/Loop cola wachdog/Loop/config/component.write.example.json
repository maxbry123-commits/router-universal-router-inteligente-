  "steps": [
    {
      "id": "S01",
      "kind": "MODEL",
      "depends_on": []
    },
    {
      "id": "S02",
      "kind": "TOOL",
      "depends_on": [
        "S01"
      ],
      "tool": "write_text",
      "args": {
        "path": "src/modulo.py",
        "text_from_model": "generated_code"
      }
    },
    {
      "id": "S03",
      "kind": "CHECK",
      "depends_on": [
        "S02"
      ]
    }
  ],
  "outputs": {
    "required_fields": [
      "generated_code"
    ],
    "acceptance": [
      "actual_tool_evidence"
    ],
    "require_tool_receipt": true,
    "require_readback": true
