{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/yaiwes/canvas-graph.v1.json",
  "title": "YAIWES Canvas Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "graph_id",
    "project_id",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_id": {
      "const": "yaiwes.canvas.graph.v1"
    },
    "graph_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "loop_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 160
    },
    "mode": {
      "enum": [
        "mindmap",
        "dag"
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 3000
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "x",
        "y"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "root",
            "group",
            "task",
            "component",
            "source",
            "check",
            "note"
          ]
        },
        "status": {
          "enum": [
            "UNKNOWN",
            "DRAFT",
            "RUNNING",
            "PASS",
            "FLAGGED",
            "NOT_APPLICABLE",
            "BLOCKED",
            "OFF"
          ]
        },
        "x": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "y": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "note": {
          "type": "string",
          "maxLength": 3000
        },
        "source_ref": {
          "type": "string",
          "maxLength": 500
        },
        "checkpoint_ref": {
          "type": "string",
          "maxLength": 500
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 240
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        }
      }
    }
  }
}
