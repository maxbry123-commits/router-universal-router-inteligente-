{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaiwes.local/schemas/loop_contract.schema.json",
  "title": "LOOP_CONTRACT_DAG_v1",
  "description": "Contrato DSL/DAG fail-closed para bucle NO-STOP sin escalamiento humano. Dos modos conmutables: agent_code y orchestrator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "gate", "mode_router", "input", "dag", "loop", "verdict_policy"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "contract_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "language": { "type": "string", "default": "es" },

    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "trigger_words"],
      "properties": {
        "required": { "const": true },
        "trigger_words": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "on_missing": { "const": "REJECT" }
      }
    },

    "mode_router": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "default_mode", "modes", "routes", "on_no_match"],
      "properties": {
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "allowed"],
          "properties": {
            "field": { "const": "mode" },
            "allowed": { "type": "array", "items": { "enum": ["agent_code", "orchestrator"] }, "minItems": 1, "uniqueItems": true }
          }
        },
        "default_mode": { "enum": ["agent_code", "orchestrator"] },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agent_code": { "$ref": "#/$defs/mode_agent_code" },
            "orchestrator": { "$ref": "#/$defs/mode_orchestrator" }
          }
        },
        "routes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/route" } },
        "on_no_match": { "enum": ["REJECT", "USE_DEFAULT_MODE"] }
      }
    },

    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "workspace", "task_source"],
      "properties": {
        "goal": { "type": "string", "minLength": 3 },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo"],
          "properties": {
            "repo": { "type": "string" },
            "branch": { "type": "string" },
            "worktree_isolation": { "type": "boolean", "default": true }
          }
        },
        "task_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["inline_dag", "features_file", "backlog_file", "issues"] },
            "path": { "type": "string" }
          }
        },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "forbidden_paths": { "type": "array", "items": { "type": "string" } }
      }
    },

    "dag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "condition": { "enum": ["on_passed", "on_terminal", "always"], "default": "on_passed" }
            }
          }
        },
        "max_parallel": { "type": "integer", "minimum": 1, "maximum": 64, "default": 4 }
      }
    },

    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "phases", "no_escalation", "completion", "on_stuck", "hard_limits", "state"],
      "properties": {
        "kind": { "const": "no_stop_until_done" },
        "phases": {
          "type": "array",
          "const": ["gather_context", "act", "verify", "repeat"]
        },
        "no_escalation": { "const": true },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["condition", "promise_token", "evaluator"],
          "properties": {
            "condition": { "const": "all_nodes_terminal AND all_required_checks_passed" },
            "promise_token": { "type": "string", "pattern": "^<<[A-Z_]{3,32}>>$" },
            "evaluator": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": { "enum": ["deterministic_script", "judge_model", "both"] },
                "script": { "type": "string" },
                "judge_model_tier": { "type": "string" },
                "judge_independent_of_builder": { "type": "boolean", "default": true }
              }
            }
          }
        },
        "on_stuck": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ladder", "no_progress_iterations_trigger"],
          "properties": {
            "no_progress_iterations_trigger": { "type": "integer", "minimum": 1 },
            "ladder": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["retry_with_error_context", "decompose_node", "switch_model_tier", "switch_executor", "reset_context_from_state", "alternative_approach", "rollback_to_checkpoint", "mark_blocked_with_evidence_and_continue"] }
            }
          }
        },
        "hard_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_iterations", "max_wall_clock_s", "max_cost_usd", "max_consecutive_no_progress", "on_limit"],
          "properties": {
            "max_iterations": { "type": "integer", "minimum": 1 },
            "max_wall_clock_s": { "type": "integer", "minimum": 60 },
            "max_cost_usd": { "type": "number", "exclusiveMinimum": 0 },
            "max_consecutive_no_progress": { "type": "integer", "minimum": 1 },
            "on_limit": { "const": "TERMINATE_WITH_REPORT" }
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["progress_file", "features_file", "checkpoint"],
          "properties": {
            "progress_file": { "type": "string" },
            "features_file": { "type": "string" },
            "checkpoint": {
              "type": "object",
              "additionalProperties": false,
              "required": ["strategy", "every"],
              "properties": {
                "strategy": { "enum": ["git_commit", "snapshot_file", "both"] },
                "every": { "enum": ["node_passed", "iteration"] }
              }
            },
            "fresh_context_per_iteration": { "type": "boolean", "default": true }
          }
        }
      }
    },

    "verdict_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fail_closed", "pass_requires_evidence", "terminal_states"],
      "properties": {
        "fail_closed": { "const": true },
        "pass_requires_evidence": { "const": true },
        "self_report_counts_as_evidence": { "const": false },
        "terminal_states": {
          "type": "array",
          "const": ["DONE", "DONE_WITH_BLOCKED", "TERMINATED_BY_LIMIT"]
        }
      }
    },

    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_log": { "type": "string" },
        "folio": { "type": "string" },
        "emit_events": { "type": "array", "items": { "type": "string" } }
      }
    }
  },

  "$defs": {
    "mode_agent_code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor", "tools", "verification"],
      "properties": {
        "executor": { "$ref": "#/$defs/executor" },
        "tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "permissions": { "enum": ["ask", "accept_edits", "allowlist_only"], "default": "allowlist_only" },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_commands"],
          "properties": {
            "required_commands": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "browser_verify": { "type": "boolean", "default": false }
          }
        },
        "subagents_allowed": { "type": "boolean", "default": false }
      }
    },

    "mode_orchestrator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrator_never_writes_code", "registry", "dispatch", "merge_policy"],
      "properties": {
        "orchestrator_never_writes_code": { "const": true },
        "orchestrator_executor": { "$ref": "#/$defs/executor" },
        "registry": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "capabilities"],
            "properties": {
              "id": { "type": "string" },
              "kind": { "enum": ["model", "subagent", "external_agent", "mcp_tool"] },
              "endpoint": { "type": "string" },
              "model_tier": { "type": "string" },
              "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "cost_class": { "enum": ["low", "medium", "high"] }
            }
          }
        },
        "dispatch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy"],
          "properties": {
            "strategy": { "enum": ["capability_match", "cost_aware", "round_robin", "explicit_only"] },
            "max_parallel": { "type": "integer", "minimum": 1, "default": 4 },
            "worker_context": { "enum": ["task_slice_only", "task_slice_plus_learnings"] }
          }
        },
        "merge_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["conflict", "regression_guard"],
          "properties": {
            "conflict": { "enum": ["serialize", "rebase_then_verify", "reject_and_requeue"] },
            "regression_guard": { "type": "boolean" }
          }
        }
      }
    },

    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": { "enum": ["self", "subagent", "model", "external_agent"] },
        "target": { "type": "string" },
        "model_tier": { "type": "string" }
      }
    },

    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match", "to"],
      "properties": {
        "id": { "type": "string" },
        "priority": { "type": "integer", "default": 100 },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode_requested": { "enum": ["agent_code", "orchestrator", "auto"] },
            "task_type": { "type": "array", "items": { "type": "string" } },
            "min_parallelizable_nodes": { "type": "integer", "minimum": 0 },
            "min_nodes": { "type": "integer", "minimum": 0 },
            "risk": { "enum": ["low", "medium", "high"] }
          }
        },
        "to": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["agent_code", "orchestrator"] },
            "model_tier": { "type": "string" },
            "executor_target": { "type": "string" }
          }
        }
      }
    },

    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "spec", "required"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["command", "file_exists", "regex_match", "json_schema", "test_suite", "git_state", "http_status", "diff_scope"] },
        "spec": { "type": "object" },
        "expect": {},
        "required": { "type": "boolean" },
        "timeout_s": { "type": "integer", "minimum": 1 }
      }
    },

    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "depends_on", "executor", "acceptance", "retry"],
      "properties": {
        "id": { "type": "string", "pattern": "^n[0-9]{2,4}_[a-z0-9_]+$" },
        "type": { "enum": ["init", "task", "fanout", "join", "verify", "gate", "final"] },
        "title": { "type": "string" },
        "task_type": { "type": "string" },
        "mode": { "enum": ["agent_code", "orchestrator", "inherit"], "default": "inherit" },
        "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "executor": { "$ref": "#/$defs/executor" },
        "instruction": { "type": "string" },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "acceptance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_attempts", "on_exhausted"],
          "properties": {
            "max_attempts": { "type": "integer", "minimum": 1, "maximum": 50 },
            "on_exhausted": { "enum": ["run_stuck_ladder", "mark_blocked_with_evidence_and_continue"] }
          }
        },
        "timeout_s": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["pending", "ready", "running", "verifying", "passed", "failed", "blocked_with_evidence", "skipped"], "default": "pending" }
      }
    }
  }
}
