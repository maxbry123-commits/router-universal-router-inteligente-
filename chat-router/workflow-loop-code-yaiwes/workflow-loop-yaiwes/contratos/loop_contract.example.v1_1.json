{
  "schema_version": "1.1.0",
  "contract_id": "yaiwes.loop.codigo-nostop",
  "language": "es",
  "gate": {
    "required": true,
    "trigger_words": [
      "INICIA",
      "RUN",
      "IMPUTA"
    ],
    "on_missing": "REJECT"
  },
  "mode_router": {
    "selector": {
      "field": "mode",
      "allowed": [
        "agent_code",
        "orchestrator"
      ]
    },
    "default_mode": "agent_code",
    "modes": {
      "agent_code": {
        "executor": {
          "kind": "model",
          "target": "claude-sonnet-5-5",
          "model_tier": "balanced"
        },
        "tools": [
          "Read",
          "Edit",
          "Write",
          "Bash",
          "Grep",
          "Glob"
        ],
        "permissions": "allowlist_only",
        "verification": {
          "required_commands": [
            "npm run lint",
            "npm test"
          ],
          "browser_verify": false
        },
        "subagents_allowed": false
      },
      "orchestrator": {
        "orchestrator_never_writes_code": true,
        "orchestrator_executor": {
          "kind": "model",
          "target": "claude-opus-5-5",
          "model_tier": "deep"
        },
        "registry": [
          {
            "id": "coder_fast",
            "kind": "model",
            "model_tier": "fast",
            "endpoint": "claude-haiku-5-5",
            "capabilities": [
              "edit_code",
              "refactor_small",
              "write_tests"
            ],
            "cost_class": "low"
          },
          {
            "id": "coder_main",
            "kind": "model",
            "model_tier": "balanced",
            "endpoint": "claude-sonnet-5-5",
            "capabilities": [
              "edit_code",
              "implement_feature",
              "debug"
            ],
            "cost_class": "medium"
          },
          {
            "id": "architect",
            "kind": "model",
            "model_tier": "deep",
            "endpoint": "claude-opus-5-5",
            "capabilities": [
              "design",
              "plan",
              "review",
              "hard_debug"
            ],
            "cost_class": "high"
          },
          {
            "id": "evaluator",
            "kind": "subagent",
            "model_tier": "balanced",
            "capabilities": [
              "verify",
              "judge"
            ],
            "cost_class": "medium"
          }
        ],
        "dispatch": {
          "strategy": "capability_match",
          "max_parallel": 4,
          "worker_context": "task_slice_plus_learnings"
        },
        "merge_policy": {
          "conflict": "rebase_then_verify",
          "regression_guard": true
        }
      }
    },
    "routes": [
      {
        "id": "r_force_agent",
        "priority": 10,
        "match": {
          "mode_requested": "agent_code"
        },
        "to": {
          "mode": "agent_code"
        }
      },
      {
        "id": "r_force_orch",
        "priority": 10,
        "match": {
          "mode_requested": "orchestrator"
        },
        "to": {
          "mode": "orchestrator"
        }
      },
      {
        "id": "r_auto_parallel",
        "priority": 50,
        "match": {
          "mode_requested": "auto",
          "min_parallelizable_nodes": 3
        },
        "to": {
          "mode": "orchestrator"
        }
      },
      {
        "id": "r_auto_high_risk",
        "priority": 60,
        "match": {
          "mode_requested": "auto",
          "risk": "high"
        },
        "to": {
          "mode": "orchestrator",
          "executor_target": "architect"
        }
      },
      {
        "id": "r_auto_default",
        "priority": 100,
        "match": {
          "mode_requested": "auto"
        },
        "to": {
          "mode": "agent_code"
        }
      }
    ],
    "on_no_match": "REJECT"
  },
  "input": {
    "goal": "Implementar el modulo X con pruebas y dejar el repo en verde",
    "workspace": {
      "repo": "maxbry123-commits/agentes",
      "branch": "feat/loop-nostop",
      "worktree_isolation": true
    },
    "task_source": {
      "kind": "inline_dag"
    },
    "constraints": [
      "Solo cambios aditivos",
      "Sin secretos en texto plano",
      "Un modulo, una autoridad"
    ],
    "forbidden_paths": [
      ".env",
      "secrets/",
      ".git/"
    ]
  },
  "dag": {
    "max_parallel": 4,
    "nodes": [
      {
        "id": "n01_init",
        "type": "init",
        "title": "Inicializar estado y lista de features",
        "depends_on": [],
        "executor": {
          "kind": "self",
          "target": "initializer"
        },
        "instruction": "Crear progress.json y features.json con todas las tareas en estado pending; crear checkpoint git inicial.",
        "outputs": [
          "state/progress.json",
          "state/features.json"
        ],
        "acceptance": [
          {
            "id": "a01_files",
            "kind": "file_exists",
            "spec": {
              "paths": [
                "state/progress.json",
                "state/features.json"
              ]
            },
            "required": true
          },
          {
            "id": "a01_schema",
            "kind": "json_schema",
            "spec": {
              "file": "state/features.json",
              "schema": "schemas/features.schema.json"
            },
            "required": true
          }
        ],
        "retry": {
          "max_attempts": 3,
          "on_exhausted": "run_stuck_ladder"
        }
      },
      {
        "id": "n02_analisis",
        "type": "task",
        "task_type": "plan",
        "title": "Analizar codigo existente y fijar plan",
        "depends_on": [
          "n01_init"
        ],
        "executor": {
          "kind": "subagent",
          "target": "architect"
        },
        "acceptance": [
          {
            "id": "a02_plan",
            "kind": "file_exists",
            "spec": {
              "paths": [
                "state/plan.md"
              ]
            },
            "required": true
          },
          {
            "id": "a02_scope",
            "kind": "diff_scope",
            "spec": {
              "allowed_globs": [
                "state/**"
              ]
            },
            "required": true
          }
        ],
        "retry": {
          "max_attempts": 3,
          "on_exhausted": "run_stuck_ladder"
        }
      },
      {
        "id": "n03_impl_a",
        "type": "task",
        "task_type": "implement_feature",
        "title": "Implementar parte A",
        "depends_on": [
          "n02_analisis"
        ],
        "executor": {
          "kind": "subagent",
          "target": "coder_main"
        },
        "acceptance": [
          {
            "id": "a03_tests",
            "kind": "test_suite",
            "spec": {
              "command": "npm test -- --testPathPattern=a"
            },
            "expect": {
              "exit_code": 0
            },
            "required": true,
            "timeout_s": 600
          },
          {
            "id": "a03_lint",
            "kind": "command",
            "spec": {
              "command": "npm run lint"
            },
            "expect": {
              "exit_code": 0
            },
            "required": true
          }
        ],
        "retry": {
          "max_attempts": 6,
          "on_exhausted": "run_stuck_ladder"
        },
        "timeout_s": 1800
      },
      {
        "id": "n04_impl_b",
        "type": "task",
        "task_type": "implement_feature",
        "title": "Implementar parte B (paralelo a A)",
        "depends_on": [
          "n02_analisis"
        ],
        "executor": {
          "kind": "subagent",
          "target": "coder_main"
        },
        "acceptance": [
          {
            "id": "a04_tests",
            "kind": "test_suite",
            "spec": {
              "command": "npm test -- --testPathPattern=b"
            },
            "expect": {
              "exit_code": 0
            },
            "required": true,
            "timeout_s": 600
          }
        ],
        "retry": {
          "max_attempts": 6,
          "on_exhausted": "run_stuck_ladder"
        },
        "timeout_s": 1800
      },
      {
        "id": "n05_join",
        "type": "join",
        "title": "Integrar A y B y correr regresion",
        "depends_on": [
          "n03_impl_a",
          "n04_impl_b"
        ],
        "executor": {
          "kind": "subagent",
          "target": "evaluator"
        },
        "acceptance": [
          {
            "id": "a05_full",
            "kind": "test_suite",
            "spec": {
              "command": "npm test"
            },
            "expect": {
              "exit_code": 0
            },
            "required": true,
            "timeout_s": 1200
          },
          {
            "id": "a05_git",
            "kind": "git_state",
            "spec": {
              "no_conflict_markers": true
            },
            "required": true
          }
        ],
        "retry": {
          "max_attempts": 4,
          "on_exhausted": "mark_blocked_with_evidence_and_continue"
        }
      },
      {
        "id": "n06_final",
        "type": "final",
        "title": "Compuerta final: todas las tareas terminales",
        "depends_on": [
          "n05_join"
        ],
        "executor": {
          "kind": "subagent",
          "target": "evaluator"
        },
        "acceptance": [
          {
            "id": "a06_all",
            "kind": "command",
            "spec": {
              "command": "python3 validate_contract.py --check-state state/progress.json"
            },
            "expect": {
              "exit_code": 0
            },
            "required": true
          }
        ],
        "retry": {
          "max_attempts": 3,
          "on_exhausted": "mark_blocked_with_evidence_and_continue"
        }
      }
    ],
    "edges": [
      {
        "from": "n01_init",
        "to": "n02_analisis"
      },
      {
        "from": "n02_analisis",
        "to": "n03_impl_a"
      },
      {
        "from": "n02_analisis",
        "to": "n04_impl_b"
      },
      {
        "from": "n03_impl_a",
        "to": "n05_join"
      },
      {
        "from": "n04_impl_b",
        "to": "n05_join"
      },
      {
        "from": "n05_join",
        "to": "n06_final",
        "condition": "on_terminal"
      }
    ]
  },
  "loop": {
    "kind": "no_stop_until_done",
    "phases": [
      "gather_context",
      "act",
      "verify",
      "repeat"
    ],
    "no_escalation": true,
    "completion": {
      "condition": "all_nodes_terminal AND all_required_checks_passed",
      "promise_token": "<<TODO_COMPLETO>>",
      "evaluator": {
        "kind": "both",
        "script": "validate_contract.py",
        "judge_model_tier": "balanced",
        "judge_independent_of_builder": true
      }
    },
    "on_stuck": {
      "no_progress_iterations_trigger": 3,
      "ladder": [
        "retry_with_error_context",
        "decompose_node",
        "switch_model_tier",
        "switch_executor",
        "reset_context_from_state",
        "alternative_approach",
        "rollback_to_checkpoint",
        "mark_blocked_with_evidence_and_continue"
      ]
    },
    "hard_limits": {
      "max_iterations": 500,
      "max_wall_clock_s": 43200,
      "max_cost_usd": 150,
      "max_consecutive_no_progress": 15,
      "on_limit": "TERMINATE_WITH_REPORT"
    },
    "state": {
      "progress_file": "state/progress.json",
      "features_file": "state/features.json",
      "checkpoint": {
        "strategy": "both",
        "every": "node_passed"
      },
      "fresh_context_per_iteration": true
    }
  },
  "verdict_policy": {
    "fail_closed": true,
    "pass_requires_evidence": true,
    "self_report_counts_as_evidence": false,
    "terminal_states": [
      "DONE",
      "DONE_WITH_BLOCKED",
      "TERMINATED_BY_LIMIT"
    ]
  },
  "observability": {
    "event_log": "state/events.jsonl",
    "folio": "LOOP-{YYYYMMDD}-{seq}",
    "emit_events": [
      "node_started",
      "node_passed",
      "node_failed",
      "stuck_ladder_step",
      "mode_switched",
      "limit_reached",
      "terminal"
    ]
  },
  "model_params": {
    "protocol": "openai_chat_completions",
    "defaults": {
      "stream": true,
      "max_tokens": 16000
    },
    "by_phase": {
      "plan": {
        "temperature": 0.6,
        "max_tokens": 32000
      },
      "execute": {
        "temperature": 0.2,
        "max_tokens": 16000
      },
      "verify": {
        "temperature": 0.0,
        "max_tokens": 8000
      }
    }
  },
  "autonomy_policy": {
    "ask_user": "forbidden",
    "on_missing_info": [
      "read_state_files",
      "discover_by_tool",
      "search_web",
      "assume_and_log"
    ],
    "assumptions_file": "state/assumptions.md",
    "must_act_each_turn": true,
    "max_consecutive_reads": 3,
    "allowed_pause_points": [
      "frontend_approval",
      "results_review"
    ],
    "pause_is_nonblocking": true
  },
  "anti_repeat_guard": {
    "loop_detection_basis": "tool_call_signature",
    "dedupe_tool_calls": {
      "window": 12,
      "max_identical": 2,
      "on_exceed": "use_cache"
    },
    "read_cache": {
      "enabled": true,
      "key": "path+mtime+range"
    },
    "repeated_question": {
      "max_same_question": 1,
      "on_detect": "answer_from_state"
    }
  },
  "instruction_adherence": {
    "pin_instructions": {
      "inject_every_iteration": true,
      "sections": [
        "goal",
        "constraints",
        "forbidden_paths",
        "acceptance",
        "autonomy_rules"
      ]
    },
    "requirement_checklist": {
      "file": "state/requirements.json",
      "each_item_needs_evidence": true
    },
    "drift_guard": {
      "check_every": "node_passed",
      "checks": [
        "diff_scope",
        "forbidden_paths",
        "no_unrequested_files",
        "no_scope_creep",
        "requirements_not_regressed"
      ],
      "allowed_globs": [
        "src/**",
        "tests/**",
        "state/**",
        "package.json"
      ],
      "on_drift": "revert_and_retry"
    }
  },
  "reasoning_policy": {
    "by_phase": {
      "plan": "high",
      "execute": "none",
      "verify": "low"
    },
    "tool_choice_by_phase": {
      "plan": "auto",
      "execute": "auto",
      "verify": "auto"
    },
    "thinking_budget_tokens": 8000,
    "replay_history": {
      "strip_thinking_blocks": true,
      "keep_tool_results": true
    }
  },
  "tool_policy": {
    "results_must_return_to_model": true,
    "parallel_tool_calls": true,
    "max_tool_result_chars": 20000,
    "on_result_truncated": "read_next_range",
    "tools": [
      {
        "name": "read_file",
        "kind": "read",
        "idempotent": true
      },
      {
        "name": "grep",
        "kind": "read",
        "idempotent": true
      },
      {
        "name": "edit_file",
        "kind": "write",
        "idempotent": false
      },
      {
        "name": "bash",
        "kind": "exec",
        "idempotent": false
      },
      {
        "name": "web_search",
        "kind": "search",
        "idempotent": true,
        "max_calls_per_node": 5
      },
      {
        "name": "web_fetch",
        "kind": "fetch",
        "idempotent": true,
        "max_calls_per_node": 5
      }
    ]
  },
  "research_policy": {
    "enabled": true,
    "triggers": [
      "unknown_error",
      "missing_api_info",
      "stuck_ladder_step"
    ],
    "max_searches_per_node": 5,
    "prefer_sources": [
      "official_docs",
      "repo_issues",
      "changelog"
    ],
    "record_to": "state/research.md",
    "must_log_source_in_state": true
  },
  "context_policy": {
    "state_injection": {
      "files": [
        "state/progress.json",
        "state/requirements.json",
        "state/assumptions.md"
      ],
      "max_tokens": 3000
    },
    "compaction": {
      "trigger_ratio": 0.7,
      "keep": [
        "pinned_instructions",
        "progress_state",
        "last_tool_results",
        "open_errors"
      ]
    }
  },
  "review_points": [
    {
      "id": "rp01_front",
      "after_node": "n05_join",
      "kind": "frontend_approval",
      "artifact": "state/preview.md",
      "blocking": false,
      "on_timeout": "continue_independent_nodes"
    }
  ],
  "harness_selftest": {
    "enabled": true,
    "run_before_loop": true,
    "on_fail": "REJECT_START",
    "cases": [
      {
        "id": "t01",
        "description": "Pedir leer un archivo y luego usar su contenido SIN volver a leerlo",
        "assert": {
          "kind": "tool_result_visible_next_turn"
        }
      },
      {
        "id": "t02",
        "description": "Tarea con dato faltante: debe asumir y registrar, no preguntar",
        "assert": {
          "kind": "no_repeated_question"
        }
      },
      {
        "id": "t03",
        "description": "Tarea simple de edicion: debe ejecutar una accion en N turnos",
        "assert": {
          "kind": "acts_within_n_turns",
          "n": 3
        }
      },
      {
        "id": "t04",
        "description": "El historial reenviado no contiene bloques de thinking",
        "assert": {
          "kind": "thinking_blocks_not_replayed"
        }
      },
      {
        "id": "t05",
        "description": "Llamada de herramienta forzada se ejecuta realmente",
        "assert": {
          "kind": "forced_tool_call_executes"
        }
      }
    ]
  }
}