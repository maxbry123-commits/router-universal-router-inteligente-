{
  "name": "openclaw-plugin-swe-selector",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Selector central SWE y tools del Router Yaiwes para OpenClaw UI (sobre el bridge SWE CODE).",
  "scripts": {
    "build": "tsc -p tsconfig.json && openclaw plugins build",
    "validate": "openclaw plugins validate --json",
    "pack": "openclaw plugins pack --json",
    "test": "tsc -p tsconfig.json && node --test test/"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.10.9"
  },
  "dependencies": {
    "typebox": "^1.3.17"
  },
  "devDependencies": {
    "openclaw": "latest",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "controlUi": "./src/control-ui.ts",
    "compat": {
      "pluginApi": ">=2026.10.9"
    },
    "build": {
      "openclawVersion": "2026.10.9"
    }
  }
}
