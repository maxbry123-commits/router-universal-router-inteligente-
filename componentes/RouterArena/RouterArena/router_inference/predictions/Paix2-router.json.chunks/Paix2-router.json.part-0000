ere is a chain of merges connecting 1 and M.\n        # Does u itself contain M? Yes.\n        # So if u is in target sets, we are done.\n        \n        # However, we check this when we pop? Or when we push?\n        # Let's check when pushing to save time.\n        \n        for e in element_in_set[u]:\n            if used_element[e]:\n                continue\n            \n            # Mark element as used so we don't process its connections again\n            used_element[e] = True\n            \n            # Iterate over all sets containing this element\n            for v in sets_of_element[e]:\n                if not visited_set[v]:\n                    visited_set[v] = True\n                    dist[v] = d + 1\n                    \n                    # Check if target set v contains M\n                    # We can check if M is in element_in_set[v]\n                    # But checking membership in list is O(A_v). Total could be large?\n                    # Sum of A_v is limited, but we might check many times?\n                    # No, each set is visited once. So total cost of checking is sum of A_i which is 5e5. Acceptable.\n                    \n                    # Optimization: Precompute boolean flags for \"contains 1\" and \"contains M\"\n                    # Let's add that.\n                    \n                    if contains_M[v]:\n                        print(dist[v])\n                        return\n                    if contains_1[v]:\n                        # Should already be visited if it was a start set, but just in case\n                        pass\n                        \n                    queue.append(v)\n                    \n    print(-1)\n\n# Precompute contains_1 and contains_M\n# Re-read logic to ensure efficiency\n# Let's refactor slightly to include precomputation\n\ndef solve_refactored():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n\n    iterator = iter(input_data)\n    \n    try:\n        N = int(next(iterator))\n        M = int(next(iterator))\n    except StopIteration:\n        return\n\n    sets_of_element = [[] for _ in range(M + 1)]\n    element_in_set = [[] for _ in range(N)]\n    contains_1 = [False] * N\n    contains_M = [False] * N\n    \n    for i in range(N):\n        try:\n            A_i = int(next(iterator))\n            elems = []\n            for _ in range(A_i):\n                s_val = int(next(iterator))\n                elems.append(s_val)\n                sets_of_element[s_val].append(i)\n                if s_val == 1:\n                    contains_1[i] = True\n                if s_val == M:\n                    contains_M[i] = True\n            element_in_set[i] = elems\n        except StopIteration:\n            break\n            \n    # Check if any set contains both 1 and M initially\n    for i in range(N):\n        if contains_1[i] and contains_M[i]:\n            print(0)\n            return\n\n    # BFS\n    from collections import deque\n    queue = deque()\n    visited_set = [False] * N\n    dist = [-1] * N\n    used_element = [False] * (M + 1)\n    \n    # Initialize with sets containing 1\n    # We can iterate over sets_of_element[1] directly\n    for s_idx in sets_of_element[1]:\n        if not visited_set[s_idx]:\n            visited_set[s_idx] = True\n            dist[s_idx] = 0\n            queue.append(s_idx)\n            \n    while queue:\n        u = queue.popleft()\n        d = dist[u]\n        \n        for e in element_in_set[u]:\n            if used_element[e]:\n                continue\n            \n            used_element[e] = True\n            \n            for v in sets_of_element[e]:\n                if not visited_set[v]:\n                    visited_set[v] = True\n                    dist[v] = d + 1\n                    \n                    if contains_M[v]:\n                        print(dist[v])\n                        return\n                        \n                    queu