# freq: e:1, c:2, a:1, d:1. odd_count=3 (e,a,d).\n        # m=1 (odd).\n        # odd_count=3 > 0.\n        # Condition: k >= odd_count - 1 = 2.\n        # k=4 >= 2. YES.\n        # Correct.\n        \n        # Sample 13: n=5, k=3, s=\"debca\".\n        # freq: d:1, e:1, b:1, c:1, a:1. odd_count=5.\n        # m=2 (even).\n        # Condition: k >= 5.\n        # k=3 >= 5? NO.\n        # Correct.\n        \n        # Sample 14: n=5, k=3, s=\"abaac\".\n        # freq: a:3, b:1, c:1. odd_count=3.\n        # m=2 (even).\n        # Condition: k >= 3.\n        # k=3 >= 3. YES.\n        # Correct.\n        \n        # So the logic holds.\n        \n        # Implementation:\n        \n        m = n - k\n        odd_count = sum(1 for v in freq.values() if v % 2 == 1)\n        \n        if m % 2 == 0:\n            if k >= odd_count:\n                results.append(\"YES\")\n            else:\n                results.append(\"NO\")\n        else:\n            if odd_count > 0:\n                if k >= odd_count - 1:\n                    results.append(\"YES\")\n                else:\n                    results.append(\"NO\")\n            else:\n                if k >= 1:\n                    results.append(\"YES\")\n                else:\n                    results.append(\"NO\")\n\n    print('\\n'.join(results))\n\nsolve()\n```",
