ol_counts[j]['B'] != 1 or col_counts[j]['C'] != 1:\n                    return False\n                \n                # Check topmost character constraint for column j\n                # Find which char has the smallest row index\n                min_r = float('inf')\n                min_char_idx = -1 # 0:A, 1:B, 2:C\n                for k, char in enumerate(['A', 'B', 'C']):\n                    r = col_min_row[j][k]\n                    if r < min_r:\n                        min_r = r\n                        min_char_idx = k\n                \n                expected_char = C[j]\n                actual_char = ['A', 'B', 'C'][min_char_idx]\n                if actual_char != expected_char:\n                    return False\n            return True\n        \n        # Try all valid triples for current row\n        for triple in row_options[row_idx]:\n            a_col, b_col, c_col = triple\n            \n            # Check if placing these causes immediate conflict in columns\n            # Conflict if any column already has the same character being placed\n            # Or if placing this character makes count > 1\n            \n            # Temporarily check\n            conflicts = False\n            \n            # Check A\n            if col_counts[a_col]['A'] >= 1:\n                conflicts = True\n            else:\n                # Update A stats\n                col_counts[a_col]['A'] += 1\n                if row_idx < col_min_row[a_col][0]:\n                    col_min_row[a_col][0] = row_idx\n            \n            if conflicts:\n                # Undo A if partially updated\n                if not conflicts: pass # Should not happen here due to structure\n                # Better to rollback properly\n                # Let's do a cleaner rollback strategy\n                pass\n\n            # Let's rewrite the loop with proper rollback\n            # Save state\n            saved_counts = [dict(c) for c in col_counts]\n            saved_min_row = [list(m) for m in col_min_row]\n            \n            # Apply A\n            ok = True\n            if col_counts[a_col]['A'] >= 1:\n                ok = False\n            else:\n                col_counts[a_col]['A'] += 1\n                if row_idx < col_min_row[a_col][0]:\n                    col_min_row[a_col][0] = row_idx\n                    \n            if not ok:\n                # Rollback A\n                col_counts[a_col]['A'] -= 1\n                col_min_row[a_col][0] = saved_min_row[a_col][0]\n                # Restore others\n                for j in range(N):\n                    col_counts[j] = saved_counts[j]\n                    col_min_row[j] = saved_min_row[j]\n                continue\n                \n            # Check B\n            if col_counts[b_col]['B'] >= 1:\n                ok = False\n            else:\n                col_counts[b_col]['B'] += 1\n                if row_idx < col_min_row[b_col][1]:\n                    col_min_row[b_col][1] = row_idx\n                    \n            if not ok:\n                # Rollback A and B\n                col_counts[b_col]['B'] -= 1\n                col_min_row[b_col][1] = saved_min_row[b_col][1]\n                col_counts[a_col]['A'] -= 1\n                col_min_row[a_col][0] = saved_min_row[a_col][0]\n                for j in range(N):\n                    col_counts[j] = saved_counts[j]\n                    col_min_row[j] = saved_min_row[j]\n                continue\n                \n            # Check C\n            if col_counts[c_col]['C'] >= 1:\n                ok = False\n            else:\n                col_counts[c_col]['C'] += 1\n                if row_idx < col_min_row[c_col][2]:\n                    col_min_row[c_col][2] = row_idx\n                    \n            if not ok:\n                # Rollback A, B, C\n                col_counts[c_col]['C'] -= 1\n                col_min_row[c_col][2] = saved_min_row[c_col][2]\n                col_counts[b_col]['B'