 for c in range(1, W + 1):\n        ct = col_time[c]\n        col_time_freq[ct] += 1\n        \n    # Prefix sum: num_cols_with_time_le[t]\n    # We need num_cols_with_time_lt[t] = sum(col_time_freq[0...t-1])\n    # Let's make an array where idx t stores sum(freq[0...t])\n    col_time_prefix = [0] * (M + 2)\n    current_sum = 0\n    for t in range(M + 1):\n        current_sum += col_time_freq[t]\n        col_time_prefix[t] = current_sum\n    # col_time_prefix[t] is number of cols with time <= t\n    # Number of cols with time < t is col_time_prefix[t-1] if t>0 else 0\n    \n    for r in range(1, H + 1):\n        rt = row_time[r]\n        rc = row_color[r]\n        \n        if rt == 0:\n            continue # Row never updated, so row_time[r]=0. \n                     # It only wins if col_time[c] < 0, which is impossible.\n                     # So rows with rt=0 contribute 0 cells via \"row win\".\n        \n        # Number of cols with time < rt\n        # Since rt >= 1, we look at col_time_prefix[rt - 1]\n        num_cols_won = col_time_prefix[rt - 1]\n        \n        if num_cols_won > 0:\n            color_counts[rc] += num_cols_won\n            \n    # Step 3 & 4: Cols winning\n    row_time_freq = [0] * (M + 1)\n    for r in range(1, H + 1):\n        rt = row_time[r]\n        row_time_freq[rt] += 1\n        \n    row_time_prefix = [0] * (M + 2)\n    current_sum = 0\n    for t in range(M + 1):\n        current_sum += row_time_freq[t]\n        row_time_prefix[t] = current_sum\n        \n    for c in range(1, W + 1):\n        ct = col_time[c]\n        cc = col_color[c]\n        \n        if ct == 0:\n            continue\n            \n        # Number of rows with time < ct\n        num_rows_won = row_time_prefix[ct - 1]\n        \n        if num_rows_won > 0:\n            color_counts[cc] += num_rows_won\n            \n    # Step 5: Initial cells (both row_time[r]==0 and col_time[c]==0)\n    num_init_rows = 0\n    for r in range(1, H + 1):\n        if row_time[r] == 0:\n            num_init_rows += 1\n            \n    num_init_cols = 0\n    for c in range(1, W + 1):\n        if col_time[c] == 0:\n            num_init_cols += 1\n            \n    init_cells_count = num_init_rows * num_init_cols\n    if init_cells_count > 0:\n        color_counts[0] += init_cells_count\n        \n    # Prepare output\n    # Get distinct colors with positive count\n    sorted_colors = sorted([c for c, cnt in color_counts.items() if cnt > 0])\n    K = len(sorted_colors)\n    \n    print(K)\n    for c in sorted_colors:\n        print(f\"{c} {color_counts[c]}\")\n\nsolve()\n```",
