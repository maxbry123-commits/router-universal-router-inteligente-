                return len(s1) + len(s2) - k\n        return len(s1) + len(s2)\n\n    # There are 3! = 6 permutations of the three strings.\n    # For each permutation (x, y, z), we want to merge them.\n    # Merging x and y first, then merging the result with z.\n    # However, the optimal superstring might not be formed by simple sequential merging if overlaps interact complexly.\n    # But with only 3 strings, we can try all permutations and all pairwise merge orders?\n    # Actually, for 3 strings, the standard approach is:\n    # 1. Remove any string that is a substring of another.\n    # 2. Try all permutations of the remaining strings.\n    # 3. For each permutation, greedily merge them.\n    # Since N=3 is small, we can also consider that the shortest superstring is formed by merging them in some order.\n    \n    # Step 1: Filter out strings that are substrings of others.\n    # We keep track of original indices or just values. Let's work with the list.\n    strs = [a, b, c]\n    n = len(strs)\n    \n    # Remove duplicates and substrings\n    # Sort by length descending to help with filtering, but we need to be careful with lex order later.\n    # Actually, let's just create a list of unique strings that are not substrings of other unique strings.\n    \n    unique_strs = []\n    for i in range(n):\n        is_substring = False\n        for j in range(n):\n            if i != j and strs[j] in strs[i]:\n                is_substring = True\n                break\n        if not is_substring:\n            unique_strs.append(strs[i])\n            \n    # If all are removed or reduced, handle edge cases.\n    # If unique_strs has 1 element, that's the answer.\n    # If 2 elements, try both merge orders.\n    # If 3 elements, try all permutations.\n    \n    candidates = []\n    \n    if len(unique_strs) == 1:\n        candidates.append(unique_strs[0])\n    elif len(unique_strs) == 2:\n        s1, s2 = unique_strs\n        # Merge s1+s2\n        candidates.append(merge(s1, s2))\n        # Merge s2+s1\n        candidates.append(merge(s2, s1))\n    else:\n        import itertools\n        for p in itertools.permutations(unique_strs):\n            # Greedily merge p[0], p[1], p[2]\n            current = merge(p[0], p[1])\n            current = merge(current, p[2])\n            candidates.append(current)\n            \n    # Find the shortest candidate, then lexicographically smallest\n    if not candidates:\n        return \"\"\n        \n    min_len = min(len(c) for c in candidates)\n    best_candidates = [c for c in candidates if len(c) == min_len]\n    best_candidates.sort()\n    \n    return best_candidates[0]\n```",
