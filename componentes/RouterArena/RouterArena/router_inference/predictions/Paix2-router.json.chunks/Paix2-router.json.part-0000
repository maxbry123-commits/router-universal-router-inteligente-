e 0\n            new_len2 = len(w) + min_len - overlap2\n            new_first2 = w[0]\n            new_last2 = l\n            \n            # Update new_dp for both options\n            for nf, nl, nlen in [(new_first1, new_last1, new_len1), (new_first2, new_last2, new_len2)]:\n                if (nf, nl) not in new_dp or new_dp[(nf, nl)] > nlen:\n                    new_dp[(nf, nl)] = nlen\n        \n        dp = new_dp\n    \n    Return min(dp.values()) if dp else 0\n    \"\"\"\n    if not words:\n        return 0\n    \n    # Initialize DP with the first word\n    first_word = words[0]\n    start_char = first_word[0]\n    end_char = first_word[-1]\n    dp = {(start_char, end_char): len(first_word)}\n    \n    for i in range(1, len(words)):\n        w = words[i]\n        w_len = len(w)\n        w_start = w[0]\n        w_end = w[-1]\n        \n        new_dp = {}\n        \n        for (f, l), min_len in dp.items():\n            # Option 1: Append w to the right: current_str + w\n            # Overlap occurs if last char of current (l) matches first char of w (w_start)\n            overlap_append = 1 if l == w_start else 0\n            len_append = min_len + w_len - overlap_append\n            new_first_append = f\n            new_last_append = w_end\n            \n            # Option 2: Prepend w to the left: w + current_str\n            # Overlap occurs if last char of w (w_end) matches first char of current (f)\n            overlap_prepend = 1 if w_end == f else 0\n            len_prepend = w_len + min_len - overlap_prepend\n            new_first_prepend = w_start\n            new_last_prepend = l\n            \n            # Process Option 1\n            key_append = (new_first_append, new_last_append)\n            if key_append not in new_dp or new_dp[key_append] > len_append:\n                new_dp[key_append] = len_append\n                \n            # Process Option 2\n            key_prepend = (new_first_prepend, new_last_prepend)\n            if key_prepend not in new_dp or new_dp[key_prepend] > len_prepend:\n                new_dp[key_prepend] = len_prepend\n        \n        dp = new_dp\n    \n    return min(dp.values()) if dp else 0\n```",
