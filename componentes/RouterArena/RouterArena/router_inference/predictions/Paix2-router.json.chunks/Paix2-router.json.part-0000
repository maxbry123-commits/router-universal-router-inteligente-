[0] * n\n    suff_max_u = [0] * n\n    suff_min_v = [0] * n\n    suff_max_v = [0] * n\n    \n    suff_min_u[n-1] = us[n-1]\n    suff_max_u[n-1] = us[n-1]\n    suff_min_v[n-1] = vs[n-1]\n    suff_max_v[n-1] = vs[n-1]\n    \n    for i in range(n-2, -1, -1):\n        suff_min_u[i] = min(suff_min_u[i+1], us[i])\n        suff_max_u[i] = max(suff_max_u[i+1], us[i])\n        suff_min_v[i] = min(suff_min_v[i+1], vs[i])\n        suff_max_v[i] = max(suff_max_v[i+1], vs[i])\n    \n    def get_range_min_max(prefix_min, prefix_max, suffix_min, suffix_max, idx):\n        \"\"\"Get min and max of array excluding index idx, using prefix/suffix arrays.\"\"\"\n        if idx == 0:\n            return suffix_min[idx+1], suffix_max[idx+1]\n        elif idx == n - 1:\n            return prefix_min[idx-1], prefix_max[idx-1]\n        else:\n            left_min, left_max = prefix_min[idx-1], prefix_max[idx-1]\n            right_min, right_max = suffix_min[idx+1], suffix_max[idx+1]\n            overall_min = min(left_min, right_min)\n            overall_max = max(left_max, right_max)\n            return overall_min, overall_max\n    \n    ans = float('inf')\n    \n    for i in range(n):\n        min_u, max_u = get_range_min_max(pref_min_u, pref_max_u, suff_min_u, suff_max_u, i)\n        min_v, max_v = get_range_min_max(pref_min_v, pref_max_v, suff_min_v, suff_max_v, i)\n        \n        max_dist = max(max_u - min_u, max_v - min_v)\n        if max_dist < ans:\n            ans = max_dist\n            \n    return ans\n```",
