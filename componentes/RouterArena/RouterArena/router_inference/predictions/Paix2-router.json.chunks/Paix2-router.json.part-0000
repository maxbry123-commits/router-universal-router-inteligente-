sal\n    # State: 0 = not visited, 1 = currently visiting, 2 = fully visited (no cycle found starting here or processed)\n    state = [0] * n\n    parent = [-1] * n # To reconstruct the cycle if needed, though we can just trace back from the collision point\n    \n    for i in range(n):\n        if state[i] != 0:\n            continue\n            \n        curr = i\n        path = []\n        \n        while True:\n            if state[curr] == 1:\n                # Found a cycle!\n                # The current node 'curr' is in the current path.\n                # Find its index in the path to extract the cycle.\n                try:\n                    idx = path.index(curr)\n                except ValueError:\n                    # This shouldn't happen if logic is correct because state==1 implies it's in current path\n                    break\n                \n                cycle = path[idx:]\n                \n                # Output result\n                # Convert to 1-indexed\n                cycle_1_indexed = [str(x + 1) for x in cycle]\n                print(len(cycle))\n                print(\" \".join(cycle_1_indexed))\n                return\n\n            if state[curr] == 2:\n                # Reached a previously processed component, no new cycle found in this branch\n                break\n            \n            # Mark as visiting\n            state[curr] = 1\n            path.append(curr)\n            \n            # Move to next\n            next_node = adj[curr]\n            \n            # Check if next_node was already visited in a previous main loop iteration (state 2)\n            # Or if it's part of the current path (state 1, handled above)\n            # Or unvisited (state 0)\n            \n            curr = next_node\n            \n            # Optimization/Safety: If path gets too long, something is wrong, but N=2e5 is fine.\n            # However, we must ensure we don't infinite loop if logic is flawed.\n            # The state check handles it.\n\n        # After exiting the while loop, mark all nodes in path as fully visited (state 2)\n        for node in path:\n            state[node] = 2\n\nsolve()\n```",
