] &= grid[r+dr_k][c+dc_k].\n    # For r, c outside this range, the term grid[...] is out of bounds, so it becomes 0.\n    # Thus, valid_starts[r][c] becomes 0.\n    \n    # So:\n    # 1. Zero out valid_starts for r, c where r+dr_k < 0 or r+dr_k >= H or c+dc_k < 0 or c+dc_k >= W.\n    # 2. For valid r, c, perform bitwise AND.\n    \n    # This reduces the constant factor significantly because we only touch the overlapping region.\n    \n    for k in range(1, N + 1):\n        d_r = dr[k]\n        d_c = dc[k]\n        \n        # Determine the range of r, c such that (r+d_r, c+d_c) is within [0, H-1] x [0, W-1]\n        r_min = max(0, -d_r)\n        r_max = min(H - 1, H - 1 - d_r)\n        c_min = max(0, -d_c)\n        c_max = min(W - 1, W - 1 - d_c)\n        \n        # If no overlap, all valid_starts become 0.\n        if r_min > r_max or c_min > c_max:\n            valid_starts = [[0]*W for _ in range(H)]\n            break\n            \n        # Zero out the regions outside the overlap\n        # Top part\n        for r in range(r_min):\n            valid_starts[r] = [0] * W\n        # Bottom part\n        for r in range(r_max + 1, H):\n            valid_starts[r] = [0] * W\n        # Left/Right parts for rows in [r_min, r_max]\n        for r in range(r_min, r_max + 1):\n            row = valid_starts[r]\n            # Set left part to 0\n            for c in range(c_min):\n                row[c] = 0\n            # Set right part to 0\n            for c in range(c_max + 1, W):\n                row[c] = 0\n            # Perform AND with grid for middle part\n            # grid_row_idx = r + d_r\n            grid_row_idx = r + d_r\n            grid_row = grid[grid_row_idx]\n            for c in range(c_min, c_max + 1):\n                row[c] &= grid_row[c + d_c]\n                \n    # Step 5: Count unique end positions.\n    # End position for start (r, c) is (r + dr[N], c + dc[N]).\n    # We only consider starts where valid_starts[r][c] == 1.\n    \n    end_pos