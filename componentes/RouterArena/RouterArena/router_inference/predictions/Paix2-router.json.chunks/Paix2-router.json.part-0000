, a is.\" (for pressing Shift+'a')\n            \n            # So if CapsLock is ON:\n            # Press 'a' -> A (cost X)\n            # Press Shift+'a' -> a (cost Y)\n            \n            if char == 'a':\n                cost_type = Y\n            else: # 'A'\n                cost_type = X\n        \n        candidate_from_on_on = prev_on + cost_type\n        if candidate_from_on_on < curr_on:\n            curr_on = candidate_from_on_on\n            \n        # Option 2: Came from OFF at step i\n        # First, turn ON CapsLock (cost Z), then type char with CapsLock ON\n        if char == 'a':\n            cost_type = Y\n        else: # 'A'\n            cost_type = X\n            \n        candidate_from_off_on = prev_off + Z + cost_type\n        if candidate_from_off_on < curr_on:\n            curr_on = candidate_from_off_on\n            \n        prev_off = curr_off\n        prev_on = curr_on\n        \n    print(min(prev_off, prev_on))\n\nsolve()\n```",
