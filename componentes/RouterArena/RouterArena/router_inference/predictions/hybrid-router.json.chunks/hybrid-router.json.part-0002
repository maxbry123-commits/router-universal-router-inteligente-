ardless of order)\n            # and update accordingly\n            min_dist = float('inf')\n            best_char = current_char\n\n            for c in range(ord('a'), ord('z') + 1):\n                dist = min(abs(ord(current_char) - ord(c)), 26 - abs(ord(current_char) - ord(c)))\n                if dist < min_dist:\n                    min_dist = dist\n                    best_char = chr(c)\n\n            # Update the character and reduce k\n            t[i] = best_char\n            k -= min_dist\n\n    return ''.join(t)\n```",
