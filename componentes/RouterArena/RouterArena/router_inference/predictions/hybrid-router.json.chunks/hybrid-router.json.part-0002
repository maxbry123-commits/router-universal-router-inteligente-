t\n    def is_connected_with_adj(u, v, adj):\n        visited = [False] * (N + 1)\n        q = deque()\n        q.append(u)\n        visited[u] = True\n        while q:\n            node = q.popleft()\n            if node == v:\n                return True\n            for neighbor in adj[node]:\n                if not visited[neighbor]:\n                    visited[neighbor] = True\n                    q.append(neighbor)\n        return False\n\n    # Process each query\n    for p, q in queries:\n        # Check if p and q are already connected in the original graph\n        if is_connected(p, q):\n            # Adding the edge won't change connectivity, but we still need to check forbidden pairs\n            # So we proceed with the new adjacency list\n            new_adj = [adj.copy() for _ in range(N+1)]\n            new_adj[p].append(q)\n            new_adj[q].append(p)\n            result = True\n            for x, y in forbidden:\n                if is_connected_with_adj(x, y, new_adj):\n                    result = False\n                    break\n            print(\"Yes\" if result else \"No\")\n        else:\n            # Check if adding the edge creates a path between any forbidden pair\n            # We need to check if there's any path from x to y that goes through p or q\n            # So we need to check if p or q is on any path between x and y in the original graph\n            # If so, adding the edge (p,q) would create a new path between x and y\n            # So we need to check if p is on any path from x to y or q is on any path from x to y\n            # But this is complex, so we'll just check all forbidden pairs with the new edge\n            new_adj = [adj.copy() for _ in range(N+1)]\n            new_adj[p].append(q)\n            new_adj[q].append(p)\n            result = True\n            for x, y in forbidden:\n                if is_connected_with_adj(x, y, new_adj):\n                    result = False\n                    break\n            print(\"Yes\" if result else \"No\")\n\n# Run the function\nsolve()\n```\n\nHowever, the above solution might be inefficient for large inputs due to the BFS being called for each query. Here's an optimized version that preprocesses the graph to answer connectivity queries more efficiently:\n\n```python\nimport sys\nfrom collections import deque\n\ndef solve():\n    input = sys.stdin.read().split()\n    ptr = 0\n    N, M = map(int, input[ptr:ptr+2])\n    ptr += 2\n\n    # Build adjacency list for original graph\n    adj = [[] for _ in range(N+1)]\n    for _ in range(M):\n        u, v = map(int, input[ptr:ptr+2])\n        ptr += 2\n        adj[u].append(v)\n        adj[v].append(u)\n\n    # Read K forbidden pairs\n    K = int(input[ptr])\n    ptr += 1\n    forbidden = []\n    for _ in range(K):\n        x, y = map(int, input[ptr:ptr+2])\n        ptr += 2\n        forbidden.append((x, y))\n\n    # Read Q queries\n    Q = int(input[ptr])\n    ptr += 1\n    queries = []\n    for _ in range(Q):\n        p, q = map(int, input[ptr:ptr+2])\n        ptr += 2\n        queries.append((p, q))\n\n    # Function to check if two nodes are connected in the current graph\n    def is_connected(u, v):\n        visited = [False] * (N + 1)\n        q = deque()\n        q.append(u)\n        visited[u] = True\n        while q:\n            node = q.popleft()\n            if node == v:\n                return True\n            for neighbor in adj[node]:\n                if not visited[neighbor]:\n                    visited[neighbor] = True\n                    q.append(neighbor)\n        return False\n\n    # Function to check if adding edge (p, q) makes any forbidden pair connected\n    def check_good(p, q):\n        # Create a new adjacency list with the edge added\n        new_adj = [adj.copy() for _ in range(N+1)]\n        new_adj[p].append(q)\n        new_adj[q].append(p)\n\n        # Check all forbidden pairs\n        for x, y in forbidden:\n            if is_connected_with_adj(x, y, new_adj):\n                return False\n        return True\n\n    # Helper function for BFS with custom adjacency list\n    def is_connected_with_adj(u, v, adj):\n        visited = [False] * (N + 1)\n        q = deque()\n        q.append(u)\n        visited[u] = True\n        while q:\n            node = q.popleft()\n            if node == v:\n                return True\n            for neighbor in adj[node]:\n                if not visited[neighbor]:\n                    visited[neighbor] = True\n                    q.append(neighbor)\n        return False\n\n    # Process each query\n    for p, q in queries:\n        # Check if p and q are already connected in the original graph\n        if is_connected(p, q):\n            # Adding the edge won't change connectivity, but we still need to check forbidden pairs\n            # So we proceed with the new adjacency list\n            new_adj = [adj.copy() for _ in range(N+1)]\n            new_adj[p].append(q)\n            new_adj[q].append(p)\n            result = True\n            for x, y in forbidden:\n                if is_connected_with_adj(x, y, new_adj):\n                    result = False\n                    break\n            print(\"Yes\" if result else \"No\")\n        else:\n            # Check if adding the edge creates a path between any forbidden pair\n            # We need to check if there's any path from x to y that goes through p or q\n            # So we need to check if p is on any path from x to y or q is on any path from x to y\n            # This can be done by checking if p is reachable from x and y is reachable from p,\n            # or q is reachable from x and y is reachable from q\n            # But this is complex, so we'll just check all forbidden pairs with the new edge\n            new_adj = [adj.copy() for _ in range(N+1)]\n            new_adj[p].append(q)\n            new_adj[q].append(p)\n            result = True\n            for x, y in forbidden:\n                if is_connected_with_adj(x, y, new_adj):\n                    result = False\n                    break\n            print(\"Yes\" if result else \"No\")\n\n# Optimized version using Union-Find (Disjoint Set Union)\nclass UnionFind:\n    def __init__(self, size):\n        self.parent = list(range(size + 1))  # 1-based indexing\n\n    def find(self, x):\n        if self.parent[x] != x:\n            self.parent[x] = self.find(self.parent[x])\n        return self.parent[x]\n\n    def union(self, x, y):\n        root_x = self.find(x)\n        root_y = self.find(y)\n        if root_x != root_y:\n            self.parent[root_y] = root_x\n\ndef solve_optimized():\n    input = sys.stdin.read().split()\n    ptr = 0\n    N, M = map(int, input[ptr:ptr+2])\n    ptr += 2\n\n    # Build adjacency list for original graph\n    adj = [[] for _ in range(N+1)]\n    for _ in range(M):\n        u, v = map(int, input[ptr:ptr+2])\n        ptr += 2\n        adj[u].append(v)\n        adj[v].append(u)\n\n    # Read K forbidden pairs\n    K = int(input[ptr])\n    ptr += 1\n    forbidden = []\n    for _ in range(K):\n        x, y = map(int, input[ptr:ptr+2])\n        ptr += 2\n        forbidden.append((x, y))\n\n    # Read Q queries\n    Q = int(input[ptr])\n    ptr += 1\n    queries = []\n    for _ in range(Q):\n        p, q = map(int, input[ptr:ptr+2])\n        ptr += 2\n        queries.append((p, q))\n\n    # Function to check if two nodes are connected in the current graph\n    def is_connected(u, v):\n        uf = UnionFind(N)\n        for node in range(1, N+1):\n            uf.parent[node] = node\n        for node in range(1, N+1):\n            for neighbor in adj[node]:\n                if neighbor > node:  # Avoid duplicate unions\n                    uf.union(node, neighbor)\n        return uf.find(u) == uf.find(v)\n\n    # Process each query\n    for p, q in queries:\n        # Create a new UnionFind structure for the graph with the new edge\n        uf = UnionFind(N)\n        for node in range(1, N+1):\n            uf.parent[node] = node\n        for node in range(1, N+1):\n            for neighbor in adj[node]:\n                if neighbor > node:  # Avoid duplicate unions\n                    uf.union(node, neighbor)\n        uf.union(p, q)\n\n        # Check all forbidden pairs\n        result = True\n        for x, y in forbidden:\n            if uf.find(x) == uf.find(y):\n                result = False\n                break\n        print(\"Yes\" if result else \"No\")\n\nsolve_optimized()\n```\n\nThe optimized version uses the Union-Find (Disjoint Set Union) data structure to efficiently check connectivity. Here's how it works:\n\n1. For each query, it creates a new Union-Find structure.\n2. It unions all original edges.\n3. Then it unions the new edge (p, q).\n4. Finally, it checks if any forbidden pair (x, y) is connected in the new graph.\n\nThis approach is more efficient for large inputs because Union-Find operations are nearly constant time due to path compression and union by rank (though the above implementation doesn't include union by rank for simplicity). For very large inputs, you might want to implement union by rank for better performance.",
