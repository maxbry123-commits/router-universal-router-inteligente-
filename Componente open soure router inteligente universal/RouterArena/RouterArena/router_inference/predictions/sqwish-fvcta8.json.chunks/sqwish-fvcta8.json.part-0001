      "generated_answer": "\\boxed{B}",
      "success": true,
      "token_usage": {
        "input_tokens": 489,
        "output_tokens": 106,
        "total_tokens": 595
      },
      "provider": "openrouter",
      "error": null
    },
    "accuracy": 1.0,
    "cost": 9.814e-05
  },
