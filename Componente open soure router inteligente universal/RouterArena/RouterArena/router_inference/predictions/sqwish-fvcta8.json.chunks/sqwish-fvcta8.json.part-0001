      "token_usage": {
        "input_tokens": 599,
        "output_tokens": 67,
        "total_tokens": 666
      },
      "provider": "openrouter",
      "error": null
    },
    "accuracy": 0.5833333333333333,
    "cost": 0.00010262000000000002
