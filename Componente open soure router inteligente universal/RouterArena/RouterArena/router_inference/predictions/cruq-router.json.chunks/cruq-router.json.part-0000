def main():\n    import sys\n    input = sys.stdin.read\n    data = input().split()\n    \n    it = iter(data)\n    N = int(next(it)); Q = int(next(it))\n    S = next(it)\n    \n    # Fenw for flip difference array (additive)\n    fenw_flip = Fenw(N + 10)\n    # Fenw for bad array (sum of bad[i] for i in [1, N-1])\n    fenw_bad = Fenw(N + 10)\n    # bad_arr[i] for i in 1 to N-1\n    bad_arr = [0] * (N + 1)  # 1-indexed, index 0 unused\n    \n    # Helper function to get current char at pos i (1-indexed)\n    def get_char(i):\n        orig = 1 if S[i - 1] == '1' else 0\n        total_flips = fenw_flip.query(i)  # total additive flips at i\n        return (orig + total_flips) % 2\n    \n    # Initialize bad_arr for positions 1 to N-1\n    for i in range(1, N):  # i from 1 to N-1\n        c1 = get_char(i)\n        c2 = get_char(i + 1)\n        if c1 == c2:\n            bad_arr[i] = 1\n            fenw_bad.update(i, 1)\n        else:\n            bad_arr[i] = 0\n    \n    out_lines = []\n    \n    for _ in range(Q):\n        t = int(next(it)); L = int(next(it)); R = int(next(it))\n        if t == 1:\n            # Flip [L, R]: update difference array\n            fenw_flip.update(L, 1)\n            if R + 1 <= N:\n                fenw_flip.update(R + 1, -1)\n            # We can update beyond N, but our Fenw is size N+10, so safe\n            # But to avoid index out of bound, we do:\n            # Actually, we did N+10, so R+1 up to N+1 is fine.\n            fenw_flip.update(R + 1, -1)\n            \n            # Update bad_arr at positions: L-1 and R (if in [1, N-1])\n            for pos in [L - 1, R]:\n                if 1 <= pos <= N - 1:\n                    old_val = bad_arr[pos]\n                    c1 = get_char(pos)\n                    c2 = get_char(pos + 1)\n                    new_val = 1 if c1 == c2 else 0\n                    if old_val != new_val:\n                        delta = new_val - old_val\n                        fenw_bad.update(pos, delta)\n   