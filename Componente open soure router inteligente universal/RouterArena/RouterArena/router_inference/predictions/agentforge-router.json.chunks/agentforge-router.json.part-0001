      "generated_answer": "```python\ndef sumOfPowers(nums, k):\n    MOD = 10**9 + 7\n    nums.sort()\n    n = len(nums)\n    if n == 0 or k == 0:\n        return 0\n\n    max_diff = nums[-1] - nums[0]\n\n    # collect all possible differences between two elements\n    diffs = set()\n    for i in range(n):\n        for j in range(i + 1, n):\n            diffs.add(nums[j] - nums[i])\n\n    # critical points where count_ge(d) changes\n    breakpoints = {1}\n    for d in diffs:\n        breakpoints.add(d + 1)\n    breakpoints.add(max_diff + 1)\n    breakpoints = sorted(breakpoints)\n\n    # count subsequences of length k with minimum difference >= d\n    def count_ge(d):\n        # dp[i][j] = ways ending at index i\n        dp = [[0] * (k + 1) for _ in range(n)]\n        for i in range(n):\n            dp[i][1] = 1\n\n        for j in range(2, k + 1):\n            # prefix sum of dp[*][j-\n            pref = [0] * n\n            acc = 0\n            for i in range(n):\n                acc = (acc + dp[i][j - 1]) % MOD\n                pref[i] = acc\n\n            left = -1\n            for i in range(n):\n                # move left pointer\n                while left + 1 < i and nums[i] - nums[left + 1] >= d:\n                    left += 1\n                if left >= 0:\n                    dp[i][j] = pref[left]\n                else:\n                    dp[i][j] = 0\n\n        total = sum(dp[i][k] for i in range(n)) % MOD\n        return total\n\n    ans = 0\n    for idx in range(len(breakpoints) - 1):\n        b = breakpoints[idx]\n        nxt = breakpoints[idx + 1]\n        end = min(nxt - 1, max_diff)\n        if b <= end:\n            cnt = count_ge(b)\n            ans = (ans + cnt * (end - b + 1)) % MOD\n\n    return ans\n```",
