      "generated_answer": "```python\nimport sys\nfrom collections import defaultdict, deque\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    n = int(next(it)); m = int(next(it))\n    \n    graph = defaultdict(list)\n    for _ in range(m):\n        u = int(next(it)); v = int(next(it))\n        if u != v:  # Skip self-loops\n            graph[u].append(v)\n            graph[v].append(u)\n    \n    k = int(next(it))\n    bad_pairs = set()\n    for _ in range(k):\n        x = int(next(it)); y = int(next(it))\n        bad_pairs.add((min(x, y), max(x, y)))\n    \n    # Find connected components using BFS/DFS\n    visited = [False] * (n + 1)\n    comp_id = [0] * (n + 1)\n    comp_count = 0\n    \n    for i in range(1, n + 1):\n        if not visited[i]:\n            comp_count += 1\n            queue = deque([i])\n            visited[i] = True\n            comp_id[i] = comp_count\n            while queue:\n                node = queue.popleft()\n                for neighbor in graph[node]:\n                    if not visited[neighbor]:\n                        visited[neighbor] = True\n                        comp_id[neighbor] = comp_count\n                        queue.append(neighbor)\n    \n    q = int(next(it))\n    results = []\n    for _ in range(q):\n        p = int(next(it)); q_val = int(next(it))\n        p, q_val = min(p, q_val), max(p, q_val)\n        if comp_id[p] == comp_id[q_val]:  # Already connected\n            # Check if this new edge creates a bad pair\n            if (p, q_val) in bad_pairs:\n                results.append(\"No\")\n            else:\n                # We need to check if adding edge (p,q) connects any bad pair\n                # Since we added an edge within same component, no new connectivity between components\n                # So only bad pairs that are exactly (p,q) matter\n                results.append(\"Yes\")\n        else:\n            # p and q are in different components\n            # Adding edge connects two components\n            # Now check if any bad pair (x,y) has x in comp_id[p] and y in comp_id[q]\n            bad_found = False\n            for x, y in bad_pairs:\n                if (comp_id[x] == comp_id[p] and comp_id[y] == comp_id[q_val]) or \\\n                   (comp_id[x] == comp_id[q_val] and comp_id[y] == comp_id[p]):\n                    bad_found = True\n                    break\n            results.append(\"No\" if bad_found else \"Yes\")\n    \n    for res in results:\n        print(res)\n\nmain()\n```",
