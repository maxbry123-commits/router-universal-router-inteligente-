      "generated_answer": "```python\nimport sys\n\ndef solve() -> None:\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    N = int(next(it))\n    M = int(next(it))\n\n    # parent list for nodes 2..N\n    p = [0] * (N + 1)  # 1-indexed, p[1] unused\n    for i in range(2, N + 1):\n        p[i] = int(next(it))\n\n    # build children adjacency\n    children = [[] for _ in range(N + 1)]\n    for i in range(2, N + 1):\n        children[p[i]].append(i)\n\n    # maximum y for each node (0 means no insurance)\n    max_cover = [0] * (N + 1)\n    for _ in range(M):\n        x = int(next(it))\n        y = int(next(it))\n        if y > max_cover[x]:\n            max_cover[x] = y\n\n    # iterative DFS\n    stack = [(1, -1)]          # (node, remaining coverage from ancestors)\n    ans = 0\n    while stack:\n        node, rem_parent = stack.pop()\n        # coverage remaining for this node\n        rem = max(rem_parent - 1, max_cover[node])\n        if rem >= 0:\n            ans += 1\n        for child in children[node]:\n            stack.append((child, rem))\n\n    print(ans)\n```",
