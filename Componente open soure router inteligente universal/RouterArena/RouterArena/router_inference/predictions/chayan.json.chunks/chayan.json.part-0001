 f(1,1)) = f(0,3) = 4$.\n$f(1,3) = f(0, f(1,2)) = f(0,4) = 0$.\n$f(1,4) = f(0, f(1,3)) = f(0,0) = 1$.\nSo for $i=1$, the sequence $f(1,0), f(1,1), f(1,2), f(1,3), f(1,4)$ is $2, 3, 4, 0, 1$.\n\n$f(2,0) = f(1,1) = 3$.\n$f(2,1) = f(1, f(2,0)) = f(1,3) = 0$.\n$f(2,2) = f(1, f(2,1)) = f(1,0) = 2$.\n$f(2,3) = f(1, f(2,2)) = f(1,2) = 4$.\n$f(2,4) = f(1, f(2,3)) = f(1,4) = 1$.\nSo for $i=2$, the sequence $f(2,0), f(2,1), f(2,2), f(2,3), f(2,4)$ is $3, 0, 2, 4, 1$.\n\n$f(3,0) = f(2,1) = 0$.\n$f(3,1) = f(2, f(3,0)) = f(2,0) = 3$.\n$f(3,2) = f(2, f(3,1)) = f(2,3) = 4$.\n$f(3,3) = f(2, f(3,2)) = f(2,4) = 1$.\n$f(3,4) = f(2, f(3,3)) = f(2,1) = 0$.\nSo for $i=3$, the sequence $f(3,0), f(3,1), f(3,2), f(3,3), f(3,4)$ is $0, 3, 4, 1, 0$.\n\nWe are interested in $f(2015, 2)$. Let's look at the values of $f(i,2)$ for $i=0, 1, 2, 3$:\n$f(0,2) = 3$\n$f(1,2) = 4$\n$f(2,2) = 2$\n$f(3,2) = 4$\n\nThis pattern is not straightforward. Let's consider the expression $f(i,j) \\pmod 5$.\nConsider the sequence $f(i,2)$ for some values of $i$:\n$f(0,2) = 3$\n$f(1,2) = f(0, f(1,1)) = f(0, 3) = 4$\n$f(2,2) = f(1, f(2,1)) = f(1, 0) = 2$\n$f(3,2) = f(2, f(3,1)) = f(2, 3) = 4$\n$f(4,2) = f(3, f(4,1)) = f(3, 1) = 3$\n$f(5,2) = f(4, f(5,1)) = f(4, f(4,0)) = f(4, 3)$\n$f(4,0) = f(3,1) = 3$\n$f(4,1) = f(3, f(4,0)) = f(3,3) = 1$\n$f(5,1) = f(4, f(5,0)) = f(4, f(4,1)) = f(4,1) = 1$.\n$f(5,2) = f(4, f(5,1)) = f(4,1) = 1$.\n\nLet's look at the function modulo some number.\nConsider $f(i,j+1) = f(i-1, f(i,j))$ for $j \\ge 1$.\n$f(i,j) = f(i-1, f(i,j-1))$.\n$f(2015,2) = f(2014, f(2015,1))$.\n$f(2015,1) = f(2014, f(2015,0)) = f(2014, f(2014,1))$.\n\nLet's observe $f(i,j)$ for small values of $i$ looking at the pattern for $j=2$.\n$f(0,2) = 3$\n$f(1,2) = 4$\n$f(2,2) = 2$\n$f(3,2) = 4$\n$f(4,2) = 3$\n$f(5,2) = 3$\n\nLet's evaluate $f(i,1)$ again:\n$f(0,1) = 2$\n$f(1,1) = 3$\n$f(2,1) = 0$\n$f(3,1) = 3$\n$f(4,1) = 1$\n$f(5,1) = f(4, f(5,0)) = f(4, f(4,1)) = f(4,1) = 1$\n$f(6,1) = f(5, f(6,0)) = f(5, f(5,1)) = f(5,1) = 1$\nFor $i \\ge 4$, $f(i,1) = 1$.\n\nNow let's recompute $f(i,2)$:\n$f(0,2) = 3$\n$f(1,2) = f(0, f(1,1)) = f(0,3) = 4$\n$f(2,2) = f(1, f(2,1)) = f(1,0) = 2$\n$f(3,2) = f(2, f(3,1)) = f(2,3) = 4$\n$f(4,2) = f(3, f(4,1)) = f(3,1) = 3$\n$f(5,2) = f(4, f(5,1)) = f(4,1) = 1$\n$f(6,2) = f(5, f(6,1)) = f(5,1) = 1$\nFor $i \\ge 5$, $f(i,2) = 1$.\n\nSince $2015 \\ge 5$, we have $f(2015,2) = 1$.\n\nThe final answer is $\\boxed{{1}}$.",
