# Never commit HF model weights downloaded by agent-10 (Jobs curl Hub inside container)
router inteligente universal/agents-yaiwes/agent-10-model-install/steps/**/results/models/
**/agent-10-model-install/steps/**/results/models/
__pycache__/
*.pyc
router inteligente universal/plugins/fichas_qwen/riu_data/

# estado de ejecucion de LOOP/Cola/Watchdog (se crea al correr)
chat router/Loop cola wachdog/*/state/
