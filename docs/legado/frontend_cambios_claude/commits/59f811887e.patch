+html body .chat-history .message.meta{font-size:12px;line-height:1.4;padding:6px 10px}
+html body .chat-history .message .copiar,html body .chat-history .message .editar{top:-11px;right:10px;padding:4px 7px;background:var(--surface-alt);border:1px solid var(--border);border-radius:8px;z-index:2}
+html body .chat-history .message .editar{right:44px}
+html body .chat-history .riu-code{white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;max-width:100%;font-size:13px}
+html body .chat-history .message table{display:block;max-width:100%;overflow-x:auto}
+html body .chat-history .message img,html body .chat-history .message video{max-width:100%;height:auto}
+html body .chat-history .message .txt{white-space:pre-wrap}
+html body #histories .riu-bajar{opacity:.9}
+html body .chat-history .message .mx-continuar{margin-top:8px;min-height:38px;padding:0 16px;border-radius:999px;background:var(--status-blue);border:0;color:#fff;font-weight:700}
+@media(max-width:720px){html body section:has(> #histories){height:auto;min-height:0;flex:1 1 auto}html body #histories{min-height:46dvh}}
+
+/* ---------- avisos (toast), estado del Router ---------- */
+html body #notice:not(:empty){position:fixed;top:calc(54px + env(safe-area-inset-top,0px));bottom:auto;left:50%;transform:translateX(-50%);width:max-content;max-width:min(92vw,460px);z-index:120;padding:11px 16px;border-radius:10px;border:1px solid var(--border-strong);border-left:3px solid var(--status-blue);background:var(--panel);color:var(--title);font-size:13px;line-height:1.4;text-align:left;white-space:normal;box-shadow:0 10px 35px rgba(0,0,0,.35)}
+html body #notice.err:not(:empty){border-left-color:var(--status-red);color:var(--title)}
+#movil-status::before{content:"";display:inline-block;width:7px;height:7px;margin-right:6px;border-radius:50%;background:var(--quiet-2);vertical-align:middle}
+#movil-status[data-estado=ok]::before{background:var(--status-green)}#movil-status[data-estado=err]::before{background:var(--status-red)}
+
+/* ---------- selectores: una sola capa, sin bordes dobles ---------- */
+html body .selectores{margin-top:12px}
+html body .sel-fila{background:transparent;border:0;padding:0;gap:8px}
+html body .sel-fila .sel-pill{border-radius:12px;min-height:46px;height:auto;padding:8px 14px;background:var(--panel);border:1px solid var(--border);justify-content:space-between}
+html body .sel-fila.activa .sel-pill{border-color:var(--status-blue);background:var(--status-soft-blue)}
+html body #sel-power .sel-fila .sel-pill{height:46px;font-size:14px}
+
+/* ---------- ventanas propias (herramientas, conexiones, ROOM, pendientes): filas tipo setting-row del skill ---------- */
+html body .tv-fila,html body .cv-fila,html body .pp-n{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:10px 12px;margin:6px 0}
+html body .tv-sub{margin:14px 2px 4px;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--quiet-2);opacity:1}
+html body .tv-sec,html body .cv-sec,html body .pp-sec{margin:16px 2px 6px;font-weight:650;color:var(--title)}
+html body .tv-tool .toggle,html body .cv-fila .toggle{min-width:92px;min-height:36px;padding:0 14px;font-size:13px}
+html body .cv-form input,html body .cv-form select,html body .cv-form textarea{min-height:42px;padding:0 12px;border-radius:10px;background:var(--surface-alt);border:1px solid var(--border)}
+html body .cv-form textarea{padding:10px 12px}
+html body .cv-est{padding:2px 4px}
+html body .cv-msg{border-radius:12px}
+@media(max-width:560px){html body .cv-form input,html body .cv-form select,html body .cv-form textarea{flex:1 1 100%}html body .cv-form .action{flex:1 1 100%;min-height:44px}}
+.tag-status{display:inline-flex;gap:6px;align-items:center;font-size:11px;font-weight:750;padding:6px 9px;border-radius:8px}
+.tag-status.progress{color:var(--status-green);background:var(--status-soft-green)}.tag-status.enabled{color:var(--status-blue);background:var(--status-soft-blue)}.tag-status.warning{color:var(--status-red);background:var(--status-soft-red)}.tag-status.pending{color:var(--quiet);background:var(--module-selected)}
+
+@media(prefers-reduced-motion:reduce){html body #composer *{transition:none!important}}
+
+/* ---------- cabecera de escritorio y botón Enviar ---------- */
+@media(min-width:721px){html body .topbar .access{flex-wrap:nowrap;align-items:center;justify-content:flex-end;gap:10px;width:auto}html body .topbar .access .riu-campana{width:40px;height:40px;min-height:40px}html body .topbar .access .riu-estado{white-space:nowrap;display:inline-flex;align-items:center;gap:6px;font-size:13px}}
+html body #composer .env-txt{display:none!important}
