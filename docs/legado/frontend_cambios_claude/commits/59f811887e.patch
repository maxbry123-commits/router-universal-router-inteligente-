+html body #composer .mx-grande:hover,html body #composer .mx-grande[aria-pressed=true]{background:var(--panel);border-color:var(--border);color:var(--title)}
+html body #composer .mx-chips{display:flex;flex-wrap:wrap;align-items:center;gap:6px;padding:4px 0 10px;border-top:1px solid var(--border);margin-top:4px;padding-top:10px}
