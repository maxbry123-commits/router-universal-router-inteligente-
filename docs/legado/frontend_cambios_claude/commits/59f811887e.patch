+:root{--mx-tap:44px;--status-soft-green:rgba(18,216,106,.13);--status-soft-blue:rgba(8,72,247,.2);--status-soft-red:rgba(255,71,95,.13)}
+.mx-ico{width:20px;height:20px;flex:none;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
+
+/* ---------- composer: editor amplio + fila principal ---------- */
+html body #composer{position:sticky;bottom:8px;width:100%;max-width:920px;margin-inline:auto;padding:12px 14px 12px;background:var(--surface-alt);border:1px solid var(--border-strong);border-radius:20px;box-shadow:0 8px 28px rgba(0,0,0,.28)}
