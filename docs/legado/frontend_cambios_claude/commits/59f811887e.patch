+@media(max-width:380px){html body #composer .mx-chips .ms-btn,html body #composer .mx-chips .mx-chip,html body #composer .mx-chips #btn-tools{padding:0 9px!important;font-size:12px!important}html body #composer .composer-bar .action{min-width:var(--mx-tap)!important;width:var(--mx-tap)!important;padding:0!important}html body #composer .composer-bar .action::after{display:none}}
+
+/* ---------- bandeja «Agregar al chat» ---------- */
+#mx-hoja .mx-bandeja{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:4px 0 8px}
+#mx-hoja .mx-bandeja>button{display:flex!important;flex-direction:column;align-items:center;justify-content:center;gap:8px;width:auto!important;max-width:none!important;height:auto!important;min-height:84px!important;aspect-ratio:auto!important;padding:12px 4px!important;border-radius:14px!important;background:var(--panel)!important;border:1px solid var(--border)!important;color:var(--title)!important}
+#mx-hoja .mx-bandeja>button::after{content:attr(data-mx);font-size:12px;line-height:1.2;color:var(--quiet);text-align:center;overflow-wrap:anywhere}
+#mx-hoja .mx-bandeja>button svg{width:24px!important;height:24px!important}
+#mx-hoja .mx-bandeja>button:active{background:var(--module-selected)!important}
+#mx-hoja .mx-fila-ajustes{display:flex;align-items:center;gap:12px;width:100%;padding:14px;border-radius:12px;background:var(--panel);border:1px solid var(--border);color:var(--title);text-align:left}
+#mx-hoja .mx-fila-ajustes span{flex:1;display:grid;gap:2px}#mx-hoja .mx-fila-ajustes small{color:var(--quiet);font-size:12px}
+#mx-hoja .mx-der{transform:rotate(-90deg);color:var(--quiet)}
+
+/* ---------- salida: ancha, sin recortes ---------- */
+html body #histories .chat-history{padding:6px 2px 12px;gap:12px}
+html body .chat-history .message{width:100%;max-width:100%;min-width:0;padding:12px 14px;font-size:16px;line-height:1.6;overflow-wrap:anywhere;word-break:break-word}
