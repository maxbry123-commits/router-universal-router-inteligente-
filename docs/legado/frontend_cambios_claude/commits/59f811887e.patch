+html body #composer .mx-chips .ms-btn[data-locked=true],html body #composer .mx-chips .mx-chip[aria-pressed=true],html body #composer .mx-chips #btn-tools[aria-pressed=true]{background:var(--status-soft-blue)!important;border-color:var(--status-blue)!important;color:var(--title)!important}
+html body #composer .mx-chips #btn-tools::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--quiet-2);flex:none}
+html body #composer .mx-chips #btn-tools[aria-pressed=true]::before{background:var(--status-blue);box-shadow:0 0 8px var(--status-blue)}
+html body #composer .mx-chips .mx-chip .mx-ico{width:16px;height:16px}
+html body #composer .composer-bar{display:flex;flex-wrap:wrap;align-items:center;justify-content:flex-start;gap:8px;margin:0;padding:0}
+html body #composer .composer-bar>.secondary{flex:0 0 auto!important;width:var(--mx-tap)!important;max-width:none!important;height:var(--mx-tap)!important;min-height:var(--mx-tap)!important;aspect-ratio:1/1!important;padding:0!important;display:inline-flex;align-items:center;justify-content:center;border-radius:50%;background:var(--panel);border:1px solid var(--border);color:var(--title)}
+html body #composer .composer-bar>.secondary[hidden],html body #composer #btn-detener[hidden]{display:none!important}
+html body #composer .composer-bar>.secondary svg{width:20px;height:20px}
+html body #composer .composer-bar>.secondary#mx-mas{background:var(--module-selected);border-color:var(--border-strong)}
