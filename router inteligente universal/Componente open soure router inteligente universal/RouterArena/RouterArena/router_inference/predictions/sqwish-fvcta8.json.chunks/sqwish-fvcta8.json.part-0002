      "generated_answer": "```python\nimport sys\n\ndef solve():\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    N = int(next(it))\n    M = int(next(it))\n\n    parent = list(range(N + 1))\n    rank = [0] * (N + 1)\n\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(x, y):\n        rx, ry = find(x), find(y)\n        if rx == ry:\n            return\n        if rank[rx] < rank[ry]:\n            parent[rx] = ry\n        elif rank[rx] > rank[ry]:\n            parent[ry] = rx\n        else:\n            parent[ry] = rx\n            rank[rx] += 1\n\n    for _ in range(M):\n        u = int(next(it))\n        v = int(next(it))\n        union(u, v)\n\n    K = int(next(it))\n    forbidden = set()\n    for _ in range(K):\n        x = int(next(it))\n        y = int(next(it))\n        cx, cy = find(x), find(y)\n        if cx != cy:\n            forbidden.add((cx, cy) if cx < cy else (cy, cx))\n\n    Q = int(next(it))\n    out = []\n    for _ in range(Q):\n        p = int(next(it))\n        q = int(next(it))\n        cp, cq = find(p), find(q)\n        if cp == cq:\n            out.append(\"Yes\")\n        else:\n            key = (cp, cq) if cp < cq else (cq, cp)\n            out.append(\"No\" if key in forbidden else \"Yes\")\n\n    sys.stdout.write(\"\\n\".join(out))\n\nif __name__ == \"__main__\":\n    solve()\n```",
