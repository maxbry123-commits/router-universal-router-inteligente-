      "generated_answer": "```python\nimport sys\n\ndef solve():\n    input = sys.stdin.read\n    data = input().split()\n    if not data:\n        return\n    \n    N = int(data[0])\n    M = int(data[1])\n    \n    parent = list(range(N + 1))\n    \n    def find(i):\n        path = []\n        while parent[i] != i:\n            path.append(i)\n            i = parent[i]\n        for node in path:\n            parent[node] = i\n        return i\n\n    def union(i, j):\n        root_i = find(i)\n        root_j = find(j)\n        if root_i != root_j:\n            parent[root_i] = root_j\n\n    idx = 2\n    for _ in range(M):\n        u, v = int(data[idx]), int(data[idx+1])\n        idx += 2\n        union(u, v)\n        \n    K = int(data[idx])\n    idx += 1\n    \n    forbidden = set()\n    for _ in range(K):\n        x, y = int(data[idx]), int(data[idx+1])\n        idx += 2\n        rx = find(x)\n        ry = find(y)\n        if rx > ry:\n            rx, ry = ry, rx\n        forbidden.add((rx, ry))\n        \n    Q = int(data[idx])\n    idx += 1\n    \n    ans = []\n    for _ in range(Q):\n        p, q = int(data[idx]), int(data[idx+1])\n        idx += 2\n        rp = find(p)\n        rq = find(q)\n        if rp > rq:\n            rp, rq = rq, rp\n        if (rp, rq) in forbidden:\n            ans.append(\"No\")\n        else:\n            ans.append(\"Yes\")\n            \n    print('\\n'.join(ans))\n\nif __name__ == '__main__':\n    solve()\n```",
