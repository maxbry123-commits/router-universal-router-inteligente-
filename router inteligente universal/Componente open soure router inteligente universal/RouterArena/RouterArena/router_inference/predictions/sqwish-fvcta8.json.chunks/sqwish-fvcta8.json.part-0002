      "generated_answer": "```python\nimport sys\n\ndef solve() -> None:\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    N = int(data[0])\n    M = int(data[1])\n    S = data[2].strip()\n    ans = 0\n    cnt1 = cnt2 = 0\n    for ch in S:\n        if ch == '0':\n            # end of a segment\n            need = cnt2 + max(0, cnt1 - M)\n            if need > ans:\n                ans = need\n            cnt1 = cnt2 = 0\n        elif ch == '1':\n            cnt1 += 1\n        else:  # ch == '2'\n            cnt2 += 1\n    # last segment\n    need = cnt2 + max(0, cnt1 - M)\n    if need > ans:\n        ans = need\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n```",
