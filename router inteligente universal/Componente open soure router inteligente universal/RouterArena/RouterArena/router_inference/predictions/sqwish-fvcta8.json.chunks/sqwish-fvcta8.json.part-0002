      "generated_answer": "```python\nimport sys\n\ndef solve():\n    input = sys.stdin.read().split()\n    if not input:\n        return\n    idx = 0\n    t = int(input[idx])\n    idx += 1\n    results = []\n    \n    for _ in range(t):\n        n = int(input[idx])\n        idx += 1\n        a = [int(x) for x in input[idx:idx + n]]\n        idx += n\n        \n        prefix_sum = [0] * (n + 1)\n        for i in range(n):\n            prefix_sum[i + 1] = prefix_sum[i] + a[i]\n            \n        divs = []\n        for i in range(1, int(n**0.5) + 1):\n            if n % i == 0:\n                divs.append(i)\n                if i*i != n:\n                    divs.append(n // i)\n                    \n        max_diff = 0\n        for k in divs:\n            min_w = float('inf')\n            max_w = float('-inf')\n            for i in range(0, n, k):\n                s = prefix_sum[i + k] - prefix_sum[i]\n                if s < min_w: min_w = s\n                if s > max_w: max_w = s\n            if max_w - min_w > max_diff:\n                max_diff = max_w - min_w\n        results.append(str(max_diff))\n    \n    sys.stdout.write(\"\\n\".join(results) + \"\\n\")\n\nif __name__ == '__main__':\n    solve()\n```",
