      "generated_answer": "```python\nimport sys\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n\n    N, H, W = data[0], data[1], data[2]\n    areas = []\n    oris = []\n    p = 3\n\n    for _ in range(N):\n        a, b = data[p], data[p + 1]\n        p += 2\n        areas.append(a * b)\n        if a == b:\n            oris.append(((a, b),))\n        else:\n            oris.append(((a, b), (b, a)))\n\n    cells = H * W\n    full = (1 << cells) - 1\n    total_area = sum(areas)\n\n    masks = []\n    for i in range(N):\n        by_pos = [[[] for _ in range(W)] for _ in range(H)]\n        for h, w in oris[i]:\n            row_mask = (1 << w) - 1\n            for r in range(H - h + 1):\n                for c in range(W - w + 1):\n                    mask = 0\n                    for dr in range(h):\n                        mask |= row_mask << ((r + dr) * W + c)\n                    by_pos[r][c].append(mask)\n        masks.append(by_pos)\n\n    def dfs(filled, used, avail_area):\n        if filled == full:\n            return True\n\n        if cells - filled.bit_count() > avail_area:\n            return False\n\n        pos = 0\n        while filled & (1 << pos):\n            pos += 1\n\n        r, c = divmod(pos, W)\n\n        for i in range(N):\n            if used & (1 << i):\n                continue\n            for m in masks[i][r][c]:\n                if m & filled:\n                    continue\n                if dfs(filled | m, used | (1 << i), avail_area - areas[i]):\n                    return True\n\n        return False\n\n    print(\"Yes\" if dfs(0, 0, total_area) else \"No\")\n\nif __name__ == \"__main__\":\n    solve()\n```",
