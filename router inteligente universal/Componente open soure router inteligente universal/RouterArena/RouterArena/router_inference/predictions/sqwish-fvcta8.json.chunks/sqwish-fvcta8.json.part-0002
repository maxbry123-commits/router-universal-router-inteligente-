      "generated_answer": "import sys\n\ndef solve():\n    input = sys.stdin.read().split()\n    if not input: return\n    N = int(input[0])\n    grid = [[False for _ in range(101)] for _ in range(101)]\n    idx = 1\n    for _ in range(N):\n        A, B, C, D = map(int, input[idx:idx+4])\n        for x in range(A, B):\n            for y in range(C, D):\n                grid[x][y] = True\n        idx += 4\n    \n    count = sum(row.count(True) for row in grid)\n    print(count)\n\nsolve()",
