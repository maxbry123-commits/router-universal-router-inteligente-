      "generated_answer": "import sys\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data: return\n    N, H, W = map(int, data[:3])\n    tiles = []\n    idx = 3\n    for _ in range(N):\n        tiles.append((int(data[idx]), int(data[idx+1])))\n        idx += 2\n    \n    grid = [[False for _ in range(W)] for _ in range(H)]\n    \n    def can_place(r, c, h, w):\n        if r + h > H or c + w > W: return False\n        for i in range(r, r + h):\n            for j in range(c, c + w):\n                if grid[i][j]: return False\n        return True\n\n    def fill(r, c, h, w, val):\n        for i in range(r, r + h):\n            for j in range(c, c + w):\n                grid[i][j] = val\n\n    def backtrack(used_mask):\n        r, c = -1, -1\n        for i in range(H):\n            for j in range(W):\n                if not grid[i][j]:\n                    r, c = i, j\n                    break\n            if r != -1: break\n        \n        if r == -1: return True\n        \n        for i in range(N):\n            if not (used_mask & (1 << i)):\n                h, w = tiles[i]\n                for th, tw in [(h, w), (w, h)]:\n                    if can_place(r, c, th, tw):\n                        fill(r, c, th, tw, True)\n                        if backtrack(used_mask | (1 << i)): return True\n                        fill(r, c, th, tw, False)\n        return False\n\n    print(\"Yes\" if backtrack(0) else \"No\")\n\nsolve()",
