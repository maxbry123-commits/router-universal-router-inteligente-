      "generated_answer": "```python\nimport sys\n\ndef solve():\n    input = sys.stdin.read\n    data = input().split()\n    if not data:\n        return\n    \n    N = int(data[0])\n    events = []\n    idx = 1\n    for _ in range(N):\n        t = int(data[idx])\n        x = int(data[idx+1])\n        events.append((t, x))\n        idx += 2\n        \n    needs = [0] * (N + 1)\n    ans = []\n    \n    event1_count = sum(1 for t, x in events if t == 1)\n    ans = [0] * event1_count\n    \n    curr_event1 = event1_count - 1\n    \n    for t, x in reversed(events):\n        if t == 2:\n            needs[x] += 1\n        elif t == 1:\n            if needs[x] > 0:\n                needs[x] -= 1\n                ans[curr_event1] = 1\n            curr_event1 -= 1\n            \n    if sum(needs) > 0:\n        print(\"-1\")\n        return\n        \n    curr_potions = 0\n    max_potions = 0\n    curr_event1 = 0\n    \n    for t, x in events:\n        if t == 1:\n            if ans[curr_event1] == 1:\n                curr_potions += 1\n                if curr_potions > max_potions:\n                    max_potions = curr_potions\n            curr_event1 += 1\n        elif t == 2:\n            curr_potions -= 1\n            \n    print(max_potions)\n    print(\" \".join(map(str, ans)))\n\nsolve()\n```",
