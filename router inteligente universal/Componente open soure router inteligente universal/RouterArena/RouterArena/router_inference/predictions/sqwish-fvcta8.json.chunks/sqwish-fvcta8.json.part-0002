           for k in range(q + 1):\n                    remainder = f - k * (group_size + 1)\n                    if remainder >= 0 and remainder % group_size == 0:\n                        total_groups += k + remainder // group_size\n                        found = True\n                        break\n                if not found:\n                    valid = False\n                    break\n        if valid:\n            return total_groups\n    return len(nums)\n```",
