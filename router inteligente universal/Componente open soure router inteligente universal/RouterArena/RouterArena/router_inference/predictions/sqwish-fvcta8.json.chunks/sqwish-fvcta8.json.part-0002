      "generated_answer": "```python\nimport sys\n\ndef main():\n    sys.setrecursionlimit(1 << 25)\n    input = sys.stdin.readline\n\n    N, M = map(int, input().split())\n    g = [[] for _ in range(N + 1)]\n    for _ in range(M):\n        u, v = map(int, input().split())\n        if u != v:\n            g[u].append(v)\n            g[v].append(u)\n\n    K = int(input())\n    forbidden = []\n    for _ in range(K):\n        x, y = map(int, input().split())\n        forbidden.append((x, y))\n\n    # Bridge finding\n    ord = [0] * (N + 1)\n    low = [0] * (N + 1)\n    parent = [0] * (N + 1)\n    edge_id = [0] * (N + 1)\n    bridges = set()\n    t = 0\n\n    for s in range(1, N + 1):\n        if ord[s]:\n            continue\n        stack = [(s, 0, 0)]\n        parent[s] = 0\n        while stack:\n            v, p, idx = stack.pop()\n            if idx == 0:\n                if ord[v] == 0:\n                    t += 1\n                    ord[v] = low[v] = t\n            if idx < len(g[v]):\n                to = g[v][idx]\n                stack.append((v, p, idx + 1))\n                if to == p:\n                    continue\n                if ord[to] == 0:\n                    parent[to] = v\n                    stack.append((to, v, 0))\n                else:\n                    low[v] = min(low[v], ord[to])\n            else:\n                if p != 0:\n                    low[p] = min(low[p], low[v])\n                    if ord[p] < low[v]:\n                        a, b = p, v\n                        if a > b:\n                            a, b = b, a\n                        bridges.add((a, b))\n\n    # DSU ignoring bridges -> 2-edge-connected components\n    dsu = list(range(N + 1))\n    rank = [0] * (N + 1)\n\n    def find(x):\n        while dsu[x] != x:\n            dsu[x] = dsu[dsu[x]]\n            x = dsu[x]\n        return x\n\n    def union(a, b):\n        ra, rb = find(a), find(b)\n        if ra == rb:\n            return\n        if rank[ra] < rank[rb]:\n            ra, rb = rb, ra\n        dsu[rb] = ra\n        if rank[ra] == rank[rb]:\n            rank[ra] += 1\n\n    for u in range(1, N + 1):\n        for v in g[u]:\n            if u < v:\n                a, b = u, v\n                if a > b:\n                    a, b = b, a\n                if (a, b) not in bridges:\n                    union(u, v)\n\n    comp = [find(i) for i in range(N + 1)]\n\n    # Build bridge tree\n    tree = {}\n    for a, b in bridges:\n        ca, cb = comp[a], comp[b]\n        if ca == cb:\n            continue\n        tree.setdefault(ca, []).append(cb)\n        tree.setdefault(cb, []).append(ca)\n\n    # LCA preprocess on bridge tree forest\n    nodes = list(set(comp[1:]))\n    idx = {c: i for i, c in enumerate(nodes)}\n    T = len(nodes)\n    adj = [[] for _ in range(T)]\n    for c in nodes:\n        for nb in tree.get(c, []):\n            adj[idx[c]].append(idx[nb])\n\n    LOG = (T).bit_length()\n    up = [[-1] * T for _ in range(LOG)]\n    depth = [0] * T\n    vis = [False] * T\n\n    for i in range(T):\n        if vis[i]:\n            continue\n        stack = [i]\n        vis[i] = True\n        up[0][i] = i\n        while stack:\n            v = stack.pop()\n            for to in adj[v]:\n                if not vis[to]:\n                    vis[to] = True\n                    depth[to] = depth[v] + 1\n                    up[0][to] = v\n                    stack.append(to)\n\n    for k in range(1, LOG):\n        for v in range(T):\n            up[k][v] = up[k - 1][up[k - 1][v]]\n\n    def lca(a, b):\n        a = idx[a]\n        b = idx[b]\n        if depth[a] < depth[b]:\n            a, b = b, a\n        diff = depth[a] - depth[b]\n        k = 0\n        while diff:\n            if diff & 1:\n                a = up[k][a]\n            diff >>= 1\n            k += 1\n        if a == b:\n            return a\n        for k in range(LOG - 1, -1, -1):\n            if up[k][a] != up[k][b]:\n                a = up[k][a]\n                b = up[k][b]\n        return up[0][a]\n\n    Q = int(input())\n    out = []\n    for _ in range(Q):\n        p, q = map(int, input().split())\n        cp, cq = comp[p], comp[q]\n        ok = True\n        for x, y in forbidden:\n            cx, cy = comp[x], comp[y]\n            # path between x and y appears iff added edge connects their components\n            if lca(cx, cy) == lca(cx, cp) or lca(cx, cy) == lca(cx, cq) or lca(cx, cy) == lca(cy, cp) or lca(cx, cy) == lca(cy, cq):\n                pass\n        # Simpler and correct: adding one edge creates path only if it connects the two components of some forbidden pair.\n        bad = False\n        s = {cp, cq}\n        for x, y in forbidden:\n            if comp[x] in s and comp[y] in s and comp[x] != comp[y]:\n                bad = True\n                break\n        out.append(\"No\" if bad else \"Yes\")\n\n    print(\"\\n\".join(out))\n\nmain()\n```",
