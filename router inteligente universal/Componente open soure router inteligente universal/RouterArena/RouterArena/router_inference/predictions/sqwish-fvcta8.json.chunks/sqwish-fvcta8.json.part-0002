be v1, v2, ..., vm.\n    # Total sum = sum_{i=1 to m} v_i * (Count(min_diff == v_i))\n    # Count(min_diff == v_i) = f(v_i) - f(v_{i+1})\n    # Total sum = v1*(f(v1) - f(v2)) + v2*(f(v2) - f(v3)) + ... + vm*f(vm)\n    #           = v1*f(v1) + (v2-v1)*f(v2) + (v3-v2)*f(v3) + ... + (vm-v_{m-1})*f(vm)\n    \n    ans = 0\n    prev_f = 0\n    \n    # Iterate through sorted differences\n    # We need to be careful with the range of v.\n    # f(v) is the number of subsequences with min diff >= v.\n    \n    total_sum = 0\n    last_v = 0\n    \n    # We calculate f(v) for each v in sorted_diffs.\n    # Let v_0 = 0. f(0) is the total number of subsequences of length k, which is C(n, k).\n    # But the formula above is more direct.\n    \n    f_values = []\n    for v in sorted_diffs:\n        f_values.append(count_subsequences_with_min_diff(v))\n    \n    # Sum = v_1 * (f(v_1) - f(v_2)) + v_2 * (f(v_2) - f(v_3)) + ...\n    # This assumes f(v_{m+1}) = 0.\n    \n    for i in range(len(sorted_diffs)):\n        v_current = sorted_diffs[i]\n        f_current = f_values[i]\n        f_next = f_values[i+1] if i + 1 < len(sorted_diffs) else 0\n        \n        term = (v_current * (f_current - f_next)) % MOD\n        total_sum = (total_sum + term) % MOD\n        \n    return total_sum\n```",
