      "generated_answer": "```python\nimport sys\n\ndef solve():\n    input = sys.stdin.readline\n    N, M = map(int, input().split())\n    p = [0] + list(map(int, input().split()))\n    children = [[] for _ in range(N + 1)]\n    for i in range(2, N + 1):\n        children[p[i]].append(i)\n\n    tins = []\n    touts = []\n\n    for _ in range(M):\n        x, y = map(int, input().split())\n        tins.append((x, y))\n\n    tin = [0] * (N + 1)\n    tout = [0] * (N + 1)\n    depth = [0] * (N + 1)\n    order = []\n    stack = [(1, 0)]\n    t = 0\n    while stack:\n        v, state = stack.pop()\n        if state == 0:\n            t += 1\n            tin[v] = t\n            order.append(v)\n            stack.append((v, 1))\n            for c in reversed(children[v]):\n                depth[c] = depth[v] + 1\n                stack.append((c, 0))\n        else:\n            tout[v] = t\n\n    maxd = max(depth)\n    bydepth = [[] for _ in range(maxd + 1)]\n    for v in range(1, N + 1):\n        bydepth[depth[v]].append(tin[v])\n\n    events = [[] for _ in range(maxd + 2)]\n    for x, y in tins:\n        d = depth[x]\n        l = tin[x]\n        r = tout[x]\n        if d + y <= maxd:\n            events[d].append((l, r, 1))\n            events[d + y + 1].append((l, r, -1))\n\n    ans = 0\n    bit = [0] * (N + 2)\n\n    def add(i, v):\n        while i <= N:\n            bit[i] += v\n            i += i & -i\n\n    def sum_(i):\n        s = 0\n        while i > 0:\n            s += bit[i]\n            i -= i & -i\n        return s\n\n    for d in range(maxd + 1):\n        for l, r, sgn in events[d]:\n            add(l, sgn)\n            add(r + 1, -sgn)\n        for t in bydepth[d]:\n            if sum_(t) > 0:\n                ans += 1\n\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n```",
