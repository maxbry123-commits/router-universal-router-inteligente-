      "generated_answer": "```python\ndef solve():\n    import sys\n    input = sys.stdin.read\n    data = input().split()\n    idx = 0\n    N = int(data[idx])\n    idx += 1\n    rects = []\n    for _ in range(N):\n        a = int(data[idx]); b = int(data[idx+1]); c = int(data[idx+2]); d = int(data[idx+3])\n        idx += 4\n        rects.append((a, b, c, d))\n    \n    # Collect all unique x-coordinates and y-coordinates that are edges\n    xs = set()\n    ys = set()\n    for a, b, c, d in rects:\n        xs.add(a)\n        xs.add(b)\n        ys.add(c)\n        ys.add(d)\n    \n    xs = sorted(xs)\n    ys = sorted(ys)\n    \n    # Map coordinates to indices for grid\n    x_to_idx = {x: i for i, x in enumerate(xs)}\n    y_to_idx = {y: i for i, y in enumerate(ys)}\n    \n    # Create a grid of cells (each cell is a small rectangle between consecutive x and y lines)\n    rows = len(ys) - 1\n    cols = len(xs) - 1\n    covered = [[False] * cols for _ in range(rows)]\n    \n    # For each sheet, mark cells it covers\n    for a, b, c, d in rects:\n        x_start = x_to_idx[a]\n        x_end = x_to_idx[b]\n        y_start = y_to_idx[c]\n        y_end = y_to_idx[d]\n        for i in range(y_start, y_end):\n            for j in range(x_start, x_end):\n                covered[i][j] = True\n    \n    # Calculate total area\n    total_area = 0\n    for i in range(rows):\n        cell_height = ys[i+1] - ys[i]\n        for j in range(cols):\n            if covered[i][j]:\n                cell_width = xs[j+1] - xs[j]\n                total_area += cell_width * cell_height\n    \n    print(total_area)\n\nif __name__ == \"__main__\":\n    solve()\n```",
