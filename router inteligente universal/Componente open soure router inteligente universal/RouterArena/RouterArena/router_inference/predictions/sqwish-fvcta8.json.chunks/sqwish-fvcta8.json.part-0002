      "generated_answer": "```python\nimport sys\nfrom itertools import permutations\n\ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    \n    n = int(data[0])\n    h = int(data[1])\n    w = int(data[2])\n    tiles = []\n    index = 3\n    for i in range(n):\n        a = int(data[index])\n        b = int(data[index + 1])\n        index += 2\n        tiles.append((a, b))\n    \n    total_area = h * w\n    tile_areas = [a * b for a, b in tiles]\n    \n    # If total tile area is less than grid area, impossible\n    if sum(tile_areas) < total_area:\n        print(\"No\")\n        return\n    \n    # Try all permutations of tile orders and orientations\n    def can_cover(grid, tiles_used, pos):\n        if pos == h * w:\n            return True\n        \n        if grid[pos // w][pos % w] != 0:\n            return can_cover(grid, tiles_used, pos + 1)\n        \n        for i in range(n):\n            if tiles_used[i]:\n                continue\n            a, b = tiles[i]\n            # Try both orientations\n            for wa, hb in [(a, b), (b, a)]:\n                if pos // w + hb > h or pos % w + wa > w:\n                    continue\n                # Check if placement is valid\n                valid = True\n                for dh in range(hb):\n                    for dw in range(wa):\n                        if grid[pos // w + dh][pos % w + dw] != 0:\n                            valid = False\n                            break\n                    if not valid:\n                        break\n                if not valid:\n                    continue\n                # Place tile\n                for dh in range(hb):\n                    for dw in range(wa):\n                        grid[pos // w + dh][pos % w + dw] = i + 1\n                tiles_used[i] = True\n                if can_cover(grid, tiles_used, pos + 1):\n                    return True\n                # Backtrack\n                for dh in range(hb):\n                    for dw in range(wa):\n                        grid[pos // w + dh][pos % w + dw] = 0\n                tiles_used[i] = False\n        return False\n    \n    grid = [[0] * w for _ in range(h)]\n    tiles_used = [False] * n\n    \n    if can_cover(grid, tiles_used, 0):\n        print(\"Yes\")\n    else:\n        print(\"No\")\n\nsolve()\n```",
