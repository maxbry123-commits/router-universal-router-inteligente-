    "generated_result": {
      "generated_answer": "```python\nimport sys\nfrom itertools import permutations\n\ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    N = int(next(it))\n    H = int(next(it))\n    W = int(next(it))\n    tiles = []\n    for _ in range(N):\n        a = int(next(it))\n        b = int(next(it))\n        tiles.append((a, b))\n    \n    total_cells = H * W\n    # Try all subsets and permutations of tiles to cover exactly total_cells.\n    # Since N ≤ 7, we can brute-force over all permutations of subsets.\n    # For each subset, compute sum of areas, and try to tile.\n    \n    def can_tile_with_tiles(used_tiles, rows, cols):\n        # used_tiles: list of (h, w) of tiles to place\n        # grid: rows x cols, all False initially\n        grid = [[False] * cols for _ in range(rows)]\n        \n        def backtrack(idx):\n            if idx == len(used_tiles):\n                return all(grid[r][c] for r in range(rows) for c in range(cols))\n            h, w = used_tiles[idx]\n            # Try both orientations\n            for rot in [(h, w), (w, h)]:\n                rh, rw = rot\n                if rh > rows or rw > cols:\n                    continue\n                # Find first empty cell in row-major order\n                for r in range(rows):\n                    for c in range(cols):\n                        if not grid[r][c]:\n                            # Try to place tile at (r, c)\n                            if r + rh > rows or c + rw > cols:\n                                continue\n                            # Check all cells in rectangle are empty\n                            ok = True\n                            for dr in range(rh):\n                                for dc in range(rw):\n                                    if grid[r+dr][c+dc]:\n                                        ok = False\n                                        break\n                                if not ok:\n                                    break\n                            if not ok:\n                                continue\n                            # Place tile\n                            for dr in range(rh):\n                                for dc in range(rw):\n                                    grid[r+dr][c+dc] = True\n                            if backtrack(idx + 1):\n                                return True\n                            # Undo\n                            for dr in range(rh):\n                                for dc in range(rw):\n                                    grid[r+dr][c+dc] = False\n            return False\n        \n        return backtrack(0)\n    \n    # Try all non-empty subsets of tiles (including using fewer than N tiles)\n    found = False\n    for mask in range(1, 1 << N):\n        # Compute total area of this subset\n        area = 0\n        subset = []\n        for i in range(N):\n            if mask & (1 << i):\n                h, w = tiles[i]\n                area += h * w\n                subset.append((h, w))\n        if area != total_cells:\n            continue\n        # Try all permutations of this subset\n        for perm in permutations(subset):\n            if can_tile_with_tiles(list(perm), H, W):\n                found = True\n                break\n        if found:\n            break\n    \n    print(\"Yes\" if found else \"No\")\n\nif __name__ == \"__main__\":\n    solve()\n```",
