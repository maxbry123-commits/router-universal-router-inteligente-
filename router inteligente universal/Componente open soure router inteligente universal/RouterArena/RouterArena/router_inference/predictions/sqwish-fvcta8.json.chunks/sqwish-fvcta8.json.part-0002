      "generated_answer": "import sys\nfrom functools import lru_cache\n\ndef solve():\n    input = sys.stdin.readline\n    N, H, W = map(int, input().split())\n    tiles = [tuple(map(int, input().split())) for _ in range(N)]\n\n    area = [a * b for a, b in tiles]\n    total = H * W\n\n    # Quick prune by subset sums of areas\n    possible = {0}\n    for x in area:\n        possible |= {s + x for s in list(possible)}\n    if total not in possible:\n        print(\"No\")\n        return\n\n    shapes = []\n    for a, b in tiles:\n        s = {(a, b), (b, a)}\n        shapes.append(list(s))\n\n    full = (1 << (H * W)) - 1\n\n    @lru_cache(None)\n    def dfs(used_mask, covered_mask):\n        if covered_mask == full:\n            return True\n        # find first uncovered cell\n        i = 0\n        while (covered_mask >> i) & 1:\n            i += 1\n        r, c = divmod(i, W)\n\n        for t in range(N):\n            if (used_mask >> t) & 1:\n                continue\n            for h, w in shapes[t]:\n                if r + h > H or c + w > W:\n                    continue\n                m = 0\n                ok = True\n                for rr in range(r, r + h):\n                    for cc in range(c, c + w):\n                        bit = rr * W + cc\n                        if (covered_mask >> bit) & 1:\n                            ok = False\n                            break\n                        m |= 1 << bit\n                    if not ok:\n                        break\n                if ok and dfs(used_mask | (1 << t), covered_mask | m):\n                    return True\n        return False\n\n    print(\"Yes\" if dfs(0, 0) else \"No\")\n\nsolve()",
