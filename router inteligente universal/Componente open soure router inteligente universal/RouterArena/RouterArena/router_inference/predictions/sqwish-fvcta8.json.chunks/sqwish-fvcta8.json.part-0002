 of zeros (0 to zero_count).\n    # Since there are (zero_count + 1) possible ways to include zeros,\n    # multiply the result by (zero_count + 1).\n    ans = sum(dp[l:r+1]) % MOD\n    ans = (ans * (zero_count + 1)) % MOD\n    \n    return ans\n\n```",
