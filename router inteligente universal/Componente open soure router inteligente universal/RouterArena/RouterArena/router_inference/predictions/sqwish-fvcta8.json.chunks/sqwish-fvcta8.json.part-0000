 counts are either 0 or 2\n4. Return \"Yes\" or \"No\"\n\n```python\ndef solve():\n    S = input().strip()\n    \n    # Count frequency of each character\n    char_count = {}\n    for char in S:\n        char_count[char] = char_count.get(char, 0) + 1\n    \n    # Count how many characters have each frequency\n    freq_count = {}\n    for count in char_count.values():\n        freq_count[count] = freq_count.get(count, 0) + 1\n    \n    # Check if all frequency counts are 0 or 2\n    # Note: freq_count contains only frequencies that actually occur\n    # Any frequency not in freq_count has count 0, which is valid\n    for count in freq_count.values():\n        if count != 0 and count != 2:\n            print(\"No\")\n            return\n    \n    print(\"Yes\")\n\nsolve()\n```",
