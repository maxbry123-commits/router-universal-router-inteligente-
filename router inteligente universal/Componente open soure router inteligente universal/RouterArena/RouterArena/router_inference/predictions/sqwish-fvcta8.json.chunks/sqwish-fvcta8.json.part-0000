lit()\n    if not data:\n        return\n    \n    it = iter(data)\n    N = int(next(it)); K = int(next(it)); Q = int(next(it))\n    \n    queries = []\n    values_set = {0}\n    for _ in range(Q):\n        x = int(next(it)); y = int(next(it))\n        queries.append((x, y))\n        values_set.add(y)\n    \n    # Coordinate compression in descending order\n    sorted_vals = sorted(values_set, reverse=True)\n    val_to_idx = {val: idx for idx, val in enumerate(sorted_vals)}\n    M = len(sorted_vals)\n    \n    # Initialize Fenwick trees\n    freq_tree = Fenw(M)\n    sum_tree = Fenw(M)\n    \n    # Initial array: all zeros\n    A = [0] * (N + 1)  # 1-indexed\n    \n    # Initially, N zeros\n    idx0 = val_to_idx[0]\n    freq_tree.update(idx0, N)\n    # sum_tree.update(idx0, 0)  # adding 0, so skip\n    \n    # Process each query\n    out_lines = []\n    for x, y in queries:\n        old_val = A[x]\n        A[x] = y\n        \n        # Remove old_val\n        if old_val != y:  # only if changed\n            i_old = val_to_idx[old_val]\n            freq_tree.update(i_old, -1)\n            sum_tree.update(i_old, -old_val)\n        \n            # Add new_val\n            i_new = val_to_idx[y]\n            freq_tree.update(i_new, 1)\n            sum_tree.update(i_new, y)\n        \n        # Query: find smallest index i (in sorted_vals) such that prefix_freq(i) >= K\n        low, high = 0, M - 1\n        ans_idx = M - 1\n        while low <= high:\n            mid = (low + high) // 2\n            if freq_tree.prefix_sum(mid) >= K:\n                ans_idx = mid\n                high = mid - 1\n            else:\n                low = mid + 1\n        \n        # Now, ans_idx is the smallest index with prefix_freq >= K\n        prev_freq = freq_tree.prefix_sum(ans_idx - 1)  # cumulative frequency before ans_idx\n        prev_sum = sum_tree.prefix_sum(ans_idx - 1)\n        needed = K - prev_freq\n        current_val = sorted_vals[ans_idx]\n        total_sum = prev_sum + n