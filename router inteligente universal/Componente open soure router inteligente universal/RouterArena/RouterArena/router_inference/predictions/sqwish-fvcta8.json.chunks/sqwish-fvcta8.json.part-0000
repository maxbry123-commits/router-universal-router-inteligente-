g\n    points = [(nums1[i], nums2[i], nums1[i] + nums2[i]) for i in range(n)]\n    points.sort(key=lambda x: -x[0])\n    \n    # Sort queries by x descending, keeping original index\n    sorted_queries = [(x, y, i) for i, (x, y) in enumerate(queries)]\n    sorted_queries.sort(key=lambda x: -x[0])\n    \n    # Process queries\n    answer = [-1] * len(queries)\n    ptr = 0\n    for x, y, idx in sorted_queries:\n        # Add all points with nums1[i] >= x\n        while ptr < n and points[ptr][0] >= x:\n            a, b, s = points[ptr]\n            pos = comp[b]\n            update(pos, s)\n            ptr += 1\n        # Query for any point with b >= y\n        pos_y = comp[y]\n        res = query(pos_y)\n        answer[idx] = res\n    \n    return answer\n```",
