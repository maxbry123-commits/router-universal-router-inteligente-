ecial_colors[i]] = special_prices[i]\n    \n    # Calculate total cost\n    total = 0\n    for plate_color in plates:\n        if plate_color in color_to_price:\n            total += color_to_price[plate_color]\n        else:\n            total += P_0\n    \n    print(total)\n\nsolve()\n```",
