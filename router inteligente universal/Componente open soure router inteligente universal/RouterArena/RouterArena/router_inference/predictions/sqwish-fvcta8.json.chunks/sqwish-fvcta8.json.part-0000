      "generated_answer": "```python\ndef minOperations(nums, target):\n    cnt = [0] * 32\n    total = 0\n\n    for x in nums:\n        total += x\n        cnt[x.bit_length() - 1] += 1\n\n    if total < target:\n        return -1\n\n    ans = 0\n\n    for i in range(31):\n        if (target >> i) & 1:\n            if cnt[i] == 0:\n                j = i + 1\n                while j < 32 and cnt[j] == 0:\n                    j += 1\n\n                if j == 32:\n                    return -1\n\n                while j > i:\n                    cnt[j] -= 1\n                    cnt[j - 1] += 2\n                    j -= 1\n                    ans += 1\n\n            cnt[i] -= 1\n\n        cnt[i + 1] += cnt[i] // 2\n        cnt[i] %= 2\n\n    return ans\n```",
