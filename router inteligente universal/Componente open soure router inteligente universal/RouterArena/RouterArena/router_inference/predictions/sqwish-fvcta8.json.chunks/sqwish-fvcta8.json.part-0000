 range(H):\n        grid.append(input().strip())\n    \n    # The target pattern\n    pattern = \"snuke\"\n    \n    # BFS: (row, col, step)\n    # Note: using 0-indexed for grid, so (1,1) becomes (0,0)\n    queue = deque()\n    # Start at (0,0) with step 1\n    if grid[0][0] == pattern[0]:  # First character should be 's'\n        queue.append((0, 0, 1))\n    \n    # Keep track of visited states to avoid cycles\n    # We need to track (row, col, step_mod) because the same cell can be visited at different steps\n    # But since the pattern repeats every 5, we only need to track step % 5\n    visited = set()\n    visited.add((0, 0, 1 % 5))\n    \n    while queue:\n        row, col, step = queue.popleft()\n        \n        # Check if we reached the destination\n        if row == H - 1 and col == W - 1:\n            print(\"Yes\")\n            return\n        \n        # Explore adjacent cells (up, down, left, right)\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n        for dr, dc in directions:\n            new_row, new_col = row + dr, col + dc\n            \n            # Check bounds\n            if 0 <= new_row < H and 0 <= new_col < W:\n                next_step = step + 1\n                expected_char = pattern[(next_step - 1) % 5]\n                \n                # Check if the character matches and we haven't visited this state\n                if grid[new_row][new_col] == expected_char:\n                    state = (new_row, new_col, next_step % 5)\n                    if state not in visited:\n                        visited.add(state)\n                        queue.append((new_row, new_col, next_step))\n    \n    print(\"No\")\n\nsolve()\n```",
