    C = len(candies)  # number of candies\n    \n    # Distance matrix between key points\n    INF = 10**15\n    dist_matrix = [[INF] * n for _ in range(n)]\n    \n    # Directions for BFS\n    dx = [0, 0, 1, -1]\n    dy = [1, -1, 0, 0]\n    \n    # For each key point, run BFS to compute distances to all other key points\n    for idx in range(n):\n        r0, c0 = points[idx]\n        dist = [[-1] * W for _ in range(H)]\n        q = deque()\n        q.append((r0, c0))\n        dist[r0][c0] = 0\n        \n        while q:\n            r, c = q.popleft()\n            for dr, dc in zip(dx, dy):\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < H and 0 <= nc < W and grid[nr][nc] != '#' and dist[nr][nc] == -1:\n                    dist[nr][nc] = dist[r][c] + 1\n                    q.append((nr, nc))\n        \n        # Now extract distances to all key points\n        for j in range(n):\n            rj, cj = points[j]\n            d_val = dist[rj][cj]\n            if d_val != -1:\n                dist_matrix[idx][j] = d_val\n            # else remains INF\n    \n    # If no candies, just check S -> G\n    S_idx = 0\n    G_idx = 1\n    if C == 0:\n        if dist_matrix[S_idx][G_idx] <= T:\n            print(0)\n        else:\n            print(-1)\n        return\n    \n    # DP over subsets of candies\n    # dp[mask][i] = minimum distance to start at S, collect candies in mask, ending at candy i (i in 0..C-1)\n    dp = [[INF] * C for _ in range(1 << C)]\n    \n    # Initialize: S to each candy\n    for i in range(C):\n        d = dist_matrix[S_idx][i+2]  # S to candy i\n        if d < INF:\n            dp[1 << i][i] = d\n    \n    # Iterate over masks\n    for mask in range(1 << C):\n        for i in range(C):\n            if dp[mask][i] >= INF:\n                continue\n            for j in range(C):\n                if mask & (1 << j):\n                    continue\n                # Try to go from candy i to candy j\n                d = dist_mat