    "generated_result": {
      "generated_answer": "```python\ndef maxPartitions(s: str, k: int) -> int:\n    n = len(s)\n    arr = [ord(c) - 97 for c in s]  # convert to integers 0..25\n\n    # ---------- original greedy partition ----------\n    next_start = [0] * n          # first index of next segment\n    freq = [0] * 26\n    distinct = 0\n    r = 0\n    for l in range(n):\n        while r < n:\n            c = arr[r]\n            if distinct + (1 if freq[c] == 0 else 0) <= k:\n                if freq[c] == 0:\n                    distinct += 1\n                freq[c] += 1\n                r += 1\n            else:\n                break\n        next_start[l] = r\n        # remove s[l] from window\n        c = arr[l]\n        freq[c] -= 1\n        if freq[c] == 0:\n            distinct -= 1\n\n    dp = [0] * (n + 1)           # dp[i] = number of partitions from i\n    for i in range(n - 1, -1, -1):\n        dp[i] = 1 + dp[next_start[i]]\n\n    # segment start and prefix count for each index\n    seg_start = [0] * n\n    seg_pre = [0] * n\n    pos = 0\n    seg_idx = 0\n    while pos < n:\n        end = next_start[pos] - 1\n        for i in range(pos, end + 1):\n            seg_start[i] = pos\n            seg_pre[i] = seg_idx\n        pos = next_start[pos]\n        seg_idx += 1\n\n    # ---------- helper arrays for a change at a single position ----------\n    # d[i] = first index j >= i with exactly k distinct characters in s[i..j] (or n)\n    d = [n] * n\n    freq2 = [0] * 26\n    distinct2 = 0\n    r = 0\n    for l in range(n):\n        while r < n and distinct2 < k:\n            c = arr[r]\n            if freq2[c] == 0:\n                distinct2 += 1\n            freq2[c] += 1\n            r += 1\n        if distinct2 == k:\n            d[l] = r - 1\n        else:\n            d[l] = n\n        # remove s[l]\n        c = arr[l]\n        freq2[c] -= 1\n        if freq2[c] == 0:\n            distinct2 -= 1\n\n    # f[i] = max partitions from i when we are allowed to change s[i] only\n    f = [0] * n\n    for i in range(n):\n        if i + 1 < n and d[i + 1] < n:\n            f[i] = 1 + dp[d[i + 1]]\n        else:\n            f[i] = 1\n\n    # ---------- try every possible position to change ----------\n    best = dp[0]                 # original number of partitions\n    pos = 0\n    while pos < n:\n        start = pos\n        end = next_start[start] - 1\n        pre = seg_pre[start]     # partitions before this segment\n\n        # first_k = smallest index in this segment where distinct count == k\n        first_k = None\n        freq_seg = [0] * 26\n        distinct_seg = 0\n        for i in range(start, end + 1):\n            c = arr[i]\n            if freq_seg[c] == 0:\n                distinct_seg += 1\n            freq_seg[c] += 1\n            if distinct_seg == k:\n                first_k = i\n                break\n        if first_k is None:      # segment cannot reach k distinct -> no improvement\n            pos = next_start[start]\n            continue\n\n        # next occurrence of same character inside the segment\n        seg_len = end - start + 1\n        next_same = [-1] * seg_len\n        last = [-1] * 26\n        for i in range(end, start - 1, -1):\n            c = arr[i]\n            next_same[i - start] = last[c]\n            last[c] = i\n\n        # scan every position in this segment\n        last_prev = [-1] * 26\n        for i in range(start, end + 1):\n            c = arr[i]\n            prev_occ = last_prev[c]\n            last_prev[c] = i\n            next_occ = next_same[i - start]\n\n            # find the earliest overflow position t_min >= i\n            if prev_occ != -1:\n                t_cand = max(i, first_k)\n                t_min = t_cand if t_cand <= end else end + 1\n            elif next_occ != -1:\n                t_cand = max(next_occ, first_k)\n                t_min = t_cand if t_cand <= end else end + 1\n            else:\n                t_min = end + 1\n\n            if t_min == i:\n                # the changed character becomes the start of the next segment\n                total = pre + 1 + f[i]\n            else:\n                # the changed character lies inside the first segment\n                total = pre + 1 + dp[t_min]\n\n            if total > best:\n                best = total\n\n        pos = next_start[start]\n\n    return best\n```",
