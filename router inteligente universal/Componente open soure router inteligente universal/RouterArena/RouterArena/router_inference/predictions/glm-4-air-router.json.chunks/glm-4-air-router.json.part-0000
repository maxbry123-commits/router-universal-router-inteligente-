u, v)\n    \n    # Read number of queries (Q)\n    Q = int(input())\n    \n    # Process each query\n    results = []\n    for _ in range(Q):\n        p, q = map(int, input().split())\n        if p in graph[q] or find(p) == find(q):\n            results.append('No')\n        else:\n            results.append(is_good_after_addition((p, q)))\n    \n    # Output all results\n    for result in results:\n        put(result)\n\n# Run the solution\nthreading.Thread(target=solve).start()\n```",
