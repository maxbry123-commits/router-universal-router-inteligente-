307262781240755\n3 7 12070267388230\n3 8 700247263184082\n4 5 560567890325333\n4 6 704726113717147\n4 7 588263818615687\n4 8 549007536393172\n5 6 779230871080408\n5 7 825982583786498\n5 8 713928998174272\n6 7 751331074538826\n6 8 449873635430228\n7 8 11298381761479\n\nSample Output 3\n\n11360716373\n\nNote that the input and the answer may not fit into a 32\\operatorname{{bit}} integer.",
    "prediction": "glm-4-air",
    "generated_result": {
      "generated_answer": "```python\nfrom heapq import heappush, heappop\nfrom collections import defaultdict\nimport sys\ninput = sys.stdin.read\n\ndef find_minimum_spanning_tree_cost():\n    data = input().split()\n    index = 0\n    N = int(data[index])\n    index += 1\n    M = int(data[index])\n    index += 1\n    K = int(data[index])\n    index += 1\n\n    edges = []\n    for _ in range(M):\n        u = int(data[index])\n        index += 1\n        v = int(data[index])\n        index += 1\n        w = int(data[index])\n        index += 1\n        edges.append((w, u, v))\n\n    # Kruskal's algorithm to find the minimum spanning tree (MST)\n    # Sort edges by weight\n    edges.sort()\n\n    # Union-Find data structure\n    parent = list(range(N + 1))\n    rank = [0] * (N + 1)\n\n    def find(x):\n        if parent[x] != x:\n            parent[x] = find(parent[x])\n        return parent[x]\n\n    def union(x, y):\n        rootX = find(x)\n        rootY = find(y)\n        if rootX != rootY:\n            if rank[rootX] > rank[rootY]:\n                parent[rootY] = rootX\n            elif rank[rootX] < rank[rootY]:\n                parent[rootX] = rootY\n            else:\n                parent[rootY] = rootX\n                rank[rootX] += 1\n            return True\n        return False\n\n    # Kruskal's algorithm to construct MST\n    mst_cost = 0\n    num_edges = 0\n    for w, u, v in edges:\n        if union(u, v):\n            mst_cost += w\n            num_edges += 1\n            if num_edges == N - 1:\n                break\n\n    # Output the cost of the MST modulo K\n    print(mst_cost % K)\n\n# Call the function to execute\nfind_minimum_spanning_tree_cost()\n```",
