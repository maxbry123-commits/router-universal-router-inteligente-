      "generated_answer": "<think>\nBFS from 1 in first component, BFS from N1+N2 in second. Max distance in first from 1 + max in second from N1+N2 + 1.\n</think>\n\n```python\nimport sys\nfrom collections import deque\n\ndef main():\n    input_data = sys.stdin.buffer.read().split()\n    idx = 0\n    N1 = int(input_data[idx]); idx+=1\n    N2 = int(input_data[idx]); idx+=1\n    M = int(input_data[idx]); idx+=1\n    N = N1 + N2\n    adj = [[] for _ in range(N+1)]\n    for _ in range(M):\n        a = int(input_data[idx]); idx+=1\n        b = int(input_data[idx]); idx+=1\n        adj[a].append(b)\n        adj[b].append(a)\n    \n    def bfs(start, limit_low, limit_high):\n        dist = [-1]*(N+1)\n        dist[start] = 0\n        q = deque([start])\n        maxd = 0\n        while q:\n            u = q.popleft()\n            for v in adj[u]:\n                if dist[v]==-1:\n                    dist[v] = dist[u]+1\n                    if limit_low <= v <= limit_high:\n                        if dist[v]>maxd: maxd = dist[v]\n                    q.append(v)\n        return maxd\n    \n    d1 = bfs(1, 1, N1)\n    d2 = bfs(N, N1+1, N)\n    print(d1 + d2 + 1)\n\nmain()\n```",
