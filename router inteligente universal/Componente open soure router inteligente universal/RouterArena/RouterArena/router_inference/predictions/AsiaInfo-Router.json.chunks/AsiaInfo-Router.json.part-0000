fs.append(None)  # sentinel\n    counts = {}\n    for i, d in enumerate(diffs[:-1]):\n        counts[d] = cnt(d)\n    \n    for i in range(len(diffs)-1):\n        d = diffs[i]\n        nxt = diffs[i+1]\n        c_next = counts[nxt] if nxt is not None else 0\n        ans = (ans + d * (counts[d] - c_next)) % MOD\n    \n    return ans % MOD\n```\n\nWait the sentinel None issue. Let me fix.\n\nAlso we need cnt at value diffs[i+1] which is next distinct diff. Then cnt(d_i) - cnt(d_{i+1}) = # with min = d_i.\n\nLet me clean up:\n\n```python\ndef sumOfPower(nums, k):\n    MOD = 10**9+7\n    nums.sort()\n    n = len(nums)\n    diffs = set()\n    for i in range(n):\n        for j in range(i+1, n):\n            diffs.add(nums[j]-nums[i])\n    diffs = sorted(diffs)\n    \n    def cnt(v):\n        dp = [[0]*(k+1) for _ in range(n)]\n        for i in range(n):\n            dp[i][1] = 1\n        for j in range(2, k+1):\n            for i in range(n):\n                s = 0\n                for i2 in range(i):\n                    if nums[i]-nums[i2] >= v:\n                        s = (s + dp[i2][j-1]) % MOD\n                dp[i][j] = s\n        return sum(dp[i][k] for i in range(n)) % MOD\n    \n    counts = [cnt(d) for d in diffs]\n    ans = 0\n    for i, d in enumerate(diffs):\n        nxt_cnt = counts[i+1] if i+1 < len(diffs) else 0\n        ans = (ans + d * (counts[i] - nxt_cnt)) % MOD\n    \n    return ans % MOD\n```\n\nHandle negative modulo: (counts[i]-nxt_cnt) could be negative, use %MOD.\n\nLet me verify with example 1: nums=[1,2,3,4], k=3. Sorted same. Diffs: 1,2,3. cnt(1) = # subseq length 3 with all adj diffs >=1 = C(4,3)=4. cnt(2): need adj diffs >=2 in sorted order. Length 3 subseq: [1,2,3](no), [1,2,4](adj diffs 1,2, no), [1,3,4](2,1,no),[2,3,4](1,1,no). So cnt(2)=0. cnt(3)=0.\n\nAnswer = 1*(4-0) + 2*(0-0) + 3*(0-0) = 4. ✓\n\nExample 3: nums=[4,3,-1] sorted [-1,3,4], k=2. Diffs: 4, 5, 1. Sorted: 1,4,5. cnt(1)=C(3,2)=3. cnt(4)=# pairs with diff>=4 = pairs (-1,3)diff4, (-1,4)diff5, (3,4)diff1. So 2. cnt(5)=1.\nAnswer = 1*(3-2)+4*(2-1)+5*(1-0) = 1+4+5=10. ✓\n\nGood.\n</think>\n\n```python\ndef sumOfPower(nums, k):\n    MOD = 10**9 + 7\n    nums.sort()\n    n = len(nums)\n    diffs = set()\n    for i in range(n):\n        for j in range(i + 1, n):\n            diffs.add(nums[j] - nums[i])\n    diffs = sorted(diffs)\n    \n    def cnt(v):\n        dp = [[0] * (k + 1) for _ in range(n)]\n        for i in range(n):\n            dp[i][1] = 1\n        for j in range(2, k + 1):\n            for i in range(n):\n                s = 0\n                for i2 in range(i):\n                    if nums[i] - nums[i2] >= v:\n                        s += dp[i2][j - 1]\n                dp[i][j] = s % MOD\n        return sum(dp[i][k] for i in range(n)) % MOD\n    \n    counts = [cnt(d) for d in diffs]\n    ans = 0\n    for i, d in enumerate(diffs):\n        nxt = counts[i + 1] if i + 1 < len(diffs) else 0\n        ans = (ans + d * ((counts[i] - nxt) % MOD)) % MOD\n    return ans % MOD\n```",
