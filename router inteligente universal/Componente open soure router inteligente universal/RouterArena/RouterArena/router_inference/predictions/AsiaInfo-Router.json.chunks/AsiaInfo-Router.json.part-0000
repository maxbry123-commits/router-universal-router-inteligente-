+ 1)\n    visited[1] = True\n    q = deque([1])\n    while q:\n        u = q.popleft()\n        order.append(u)\n        for v in adj[u]:\n            if not visited[v]:\n                visited[v] = True\n                parent[v] = u\n                q.append(v)\n    \n    size = [1] * (N + 1)\n    for u in reversed(order):\n        if parent[u] > 0:\n            size[parent[u]] += size[u]\n    \n    max_child = 0\n    for v in adj[1]:\n        if size[v] > max_child:\n            max_child = size[v]\n    \n    print(N - max_child)\n\nmain()\n```",
