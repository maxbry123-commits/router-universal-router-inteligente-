\n    \n    size = N + Q + 5\n    xs = [0] * size\n    ys = [0] * size\n    head = Q  # start head at index Q, so we have Q slots to the left\n    # Fill positions: index head+i-1 holds part i initially => (i, 0)\n    for i in range(N):\n        xs[head + i] = i + 1\n        ys[head + i] = 0\n    \n    out = []\n    dx = {'R': 1, 'L': -1, 'U': 0, 'D': 0}\n    dy = {'R': 0, 'L': 0, 'U': 1, 'D': -1}\n    \n    for _ in range(Q):\n        t = input_data[idx]; idx += 1\n        if t == b'1':\n            c = input_data[idx].decode(); idx += 1\n            nx = xs[head] + dx[c]\n            ny = ys[head] + dy[c]\n            head -= 1\n            xs[head] = nx\n            ys[head] = ny\n        else:\n            p = int(input_data[idx]); idx += 1\n            out.append(f\"{xs[head + p - 1]} {ys[head + p - 1]}\")\n    \n    sys.stdout.write('\\n'.join(out) + ('\\n' if out else ''))\n\nmain()\n```",
