n                            v23 = ox23 * oy23 * oz23\n                            v123 = ox123 * oy123 * oz123\n                            S1 = 3 * 343\n                            S2 = v12 + v13 + v23\n                            S3 = v123\n                            e3 = S3\n                            e2 = S2 - 3*S3\n                            e1 = S1 - 2*S2 + 3*S3\n                            if e1 == V1 and e2 == V2 and e3 == V3:\n                                print(\"Yes\")\n                                print(0, 0, 0, a2, b2, c2, a3, b3, c3)\n                                return\n    print(\"No\")\n\nsolve()\n```",
