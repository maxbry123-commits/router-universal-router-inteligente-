      "generated_answer": "```python\nimport sys\n\nclass FenwickTree:\n    def __init__(self, size):\n        self.size = size\n        self.tree = [0] * (size + 2)\n\n    def update(self, index, delta):\n        while index <= self.size:\n            self.tree[index] += delta\n            index += index & -index\n\n    def prefix(self, index):\n        res = 0\n        orig_index = index\n        while index > 0:\n            res += self.tree[index]\n            index -= index & -index\n        return res\n\ndef sum_smallest(m, ftc, fts, V, MM):\n    if m == 0:\n        return 0\n    lo = 1\n    hi = MM\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if ftc.prefix(mid) >= m:\n            hi = mid\n        else:\n            lo = mid + 1\n    r = lo\n    cnt_left = ftc.prefix(r - 1) if r > 1 else 0\n    sum_left = fts.prefix(r - 1) if r > 1 else 0\n    need = m - cnt_left\n    valr = V[r - 1]\n    return sum_left + need * valr\n\ndef main():\n    input_data = sys.stdin.read().split()\n    idx = 0\n    N = int(input_data[idx]); idx += 1\n    K = int(input_data[idx]); idx += 1\n    Q = int(input_data[idx]); idx += 1\n\n    updates = []\n    possible = set([0])\n    for _ in range(Q):\n        X = int(input_data[idx]); idx += 1\n        Y = int(input_data[idx]); idx += 1\n        updates.append((X, Y))\n        possible.add(Y)\n\n    V = sorted(possible)\n    MM = len(V)\n    rank_of = {V[i]: i + 1 for i in range(MM)}\n\n    curr = [0] * N\n    ft_count = FenwickTree(MM)\n    ft_sum = FenwickTree(MM)\n    rank0 = rank_of[0]\n    ft_count.update(rank0, N)\n    total_sum = 0\n    M_small = N - K\n\n    outputs = []\n    for X, Y in updates:\n        x = X - 1\n        old = curr[x]\n        if old != Y:\n            ro = rank_of[old]\n            ft_count.update(ro, -1)\n            ft_sum.update(ro, -old)\n            rn = rank_of[Y]\n            ft_count.update(rn, 1)\n            ft_sum.update(rn, Y)\n            curr[x] = Y\n            total_sum += Y - old\n        small = sum_smallest(M_small, ft_count, ft_sum, V, MM)\n        f = total_sum - small\n        outputs.append(str(f))\n    print('\\n'.join(outputs))\n\nmain()\n```",
