      "generated_answer": "```python\nimport sys\n\nclass Fenwick:\n    def __init__(self, size):\n        self.size = size\n        self.tree = [0] * size\n\n    def update(self, idx, val):\n        while idx < self.size:\n            self.tree[idx] += val\n            idx += idx & -idx\n\n    def prefix(self, idx):\n        res = 0\n        while idx > 0:\n            res += self.tree[idx]\n            idx -= idx & -idx\n        return res\n\n    def query(self, left, right):\n        if left > right:\n            return 0\n        return self.prefix(right) - self.prefix(left - 1)\n\ndef query_fenwicks(fens, a1, a2):\n    res = 0\n    for zi in range(a2):\n        res += fens[zi].query(a1 + 1, 100)\n    return res\n\ndef compute_1d_overlap_counts(queries, points, get1, get2):\n    if not queries:\n        return []\n    pts = sorted((get1(b), get2(b)) for b in points)\n    qlist = sorted((get2(b), get1(b), i) for i, b in enumerate(queries))\n    ft = Fenwick(102)\n    j = 0\n    res = [0] * len(queries)\n    for z2q, z1q, qi in qlist:\n        while j < len(pts) and pts[j][0] < z2q:\n            ft.update(pts[j][1], 1)\n            j += 1\n        res[qi] = ft.query(z1q + 1, 100)\n    return res\n\ndef process_direction(L_lists, R_lists, get_sweep1, get_sweep2, get_act1, get_act2, ans):\n    for p in range(101):\n        L_list = L_lists[p]\n        R_list = R_lists[p]\n        if not L_list or not R_list:\n            continue\n        events_sweep = [[] for _ in range(101)]\n        for box in L_list:\n            s1 = get_sweep1(box)\n            s2 = get_sweep2(box)\n            events_sweep[s1].append(('ADD_L', box))\n            events_sweep[s2].append(('REMOVE_L', box))\n        for box in R_list:\n            s1 = get_sweep1(box)\n            s2 = get_sweep2(box)\n            events_sweep[s1].append(('ADD_R', box))\n            events_sweep[s2].append(('REMOVE_R', box))\n        fensL = [Fenwick(102) for _ in range(101)]\n        fensR = [Fenwick(102) for _ in range(101)]\n        for sw in range(101):\n            events_here = events_sweep[sw]\n            # removes\n            for typ, box in events_here:\n                if typ == 'REMOVE_L':\n                    a1 = get_act1(box)\n                    a2 = get_act2(box)\n                    fensL[a1].update(a2, -1)\n                elif typ == 'REMOVE_R':\n                    a1 = get_act1(box)\n                    a2 = get_act2(box)\n                    fensR[a1].update(a2, -1)\n            # collect new\n            new_L = []\n            new_R = []\n            for typ, box in events_here:\n                if typ == 'ADD_L':\n                    new_L.append(box)\n                elif typ == 'ADD_R':\n                    new_R.append(box)\n            # query previous\n            for box in new_L:\n                a1 = get_act1(box)\n                a2 = get_act2(box)\n                num = query_fenwicks(fensR, a1, a2)\n                ans[box.id] += num\n            for box in new_R:\n                a1 = get_act1(box)\n                a2 = get_act2(box)\n                num = query_fenwicks(fensL, a1, a2)\n                ans[box.id] += num\n            # cross\n            if new_L and new_R:\n                countsLR = compute_1d_overlap_counts(new_L, new_R, get_act1, get_act2)\n                for ii, box in enumerate(new_L):\n                    ans[box.id] += countsLR[ii]\n                countsRL = compute_1d_overlap_counts(new_R, new_L, get_act1, get_act2)\n                for ii, box in enumerate(new_R):\n                    ans[box.id] += countsRL[ii]\n            # add new\n            for box in new_L:\n                a1 = get_act1(box)\n                a2 = get_act2(box)\n                fensL[a1].update(a2, 1)\n            for box in new_R:\n                a1 = get_act1(box)\n                a2 = get_act2(box)\n                fensR[a1].update(a2, 1)\n\nclass Box:\n    def __init__(self, idd, x1, y1, z1, x2, y2, z2):\n        self.id = idd\n        self.x1 = x1\n        self.x2 = x2\n        self.y1 = y1\n        self.y2 = y2\n        self.z1 = z1\n        self.z2 = z2\n\ndata = sys.stdin.read().split()\nN = int(data[0])\nidx = 1\nboxes = []\nfor i in range(N):\n    x1 = int(data[idx])\n    y1 = int(data[idx + 1])\n    z1 = int(data[idx + 2])\n    x2 = int(data[idx + 3])\n    y2 = int(data[idx + 4])\n    z2 = int(data[idx + 5])\n    boxes.append(Box(i, x1, y1, z1, x2, y2, z2))\n    idx += 6\n\nx_start = [[] for _ in range(101)]\nx_end = [[] for _ in range(101)]\ny_start = [[] for _ in range(101)]\ny_end = [[] for _ in range(101)]\nz_start = [[] for _ in range(101)]\nz_end = [[] for _ in range(101)]\n\nfor box in boxes:\n    x_start[box.x1].append(box)\n    x_end[box.x2].append(box)\n    y_start[box.y1].append(box)\n    y_end[box.y2].append(box)\n    z_start[box.z1].append(box)\n    z_end[box.z2].append(box)\n\nans = [0] * N\n\n# X abut: sweep Y, active Z\nprocess_direction(x_end, x_start,\n                  lambda b: b.y1, lambda b: b.y2,\n                  lambda b: b.z1, lambda b: b.z2,\n                  ans)\n\n# Y abut: sweep X, active Z\nprocess_direction(y_end, y_start,\n                  lambda b: b.x1, lambda b: b.x2,\n                  lambda b: b.z1, lambda b: b.z2,\n                  ans)\n\n# Z abut: sweep X, active Y\nprocess_direction(z_end, z_start,\n                  lambda b: b.x1, lambda b: b.x2,\n                  lambda b: b.y1, lambda b: b.y2,\n                  ans)\n\nprint('\\n'.join(map(str, ans)))\n```",
