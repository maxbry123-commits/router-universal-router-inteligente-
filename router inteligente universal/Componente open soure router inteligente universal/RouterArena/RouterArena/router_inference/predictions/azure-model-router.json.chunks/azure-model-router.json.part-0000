      "generated_answer": "```python\nimport sys\nimport heapq\n\ninput = sys.stdin.read\ndata = input().split()\n\nindex = 0\nN = int(data[index]); index += 1\nM = int(data[index]); index += 1\n\nadj = [[] for _ in range(N + 1)]\nfor _ in range(M):\n    l = int(data[index]); index += 1\n    d = int(data[index]); index += 1\n    k = int(data[index]); index += 1\n    c = int(data[index]); index += 1\n    A = int(data[index]); index += 1\n    B = int(data[index]); index += 1\n    adj[B].append((A, l, d, k, c))\n\nINF = 10**20 + 5 * 10**9\nf = [-1] * (N + 1)\nf[N] = INF\n\npq = []\nheapq.heappush(pq, (-INF, N))\n\nwhile pq:\n    negf_val, u = heapq.heappop(pq)\n    f_val = -negf_val\n    if f_val < f[u]:\n        continue\n    for A, l, d, k, c in adj[u]:\n        U = f[u] - c\n        if U < l:\n            continue\n        j = (U - l) // d\n        j = min(j, k - 1)\n        if j >= 0:\n            t = l + j * d\n            if t > f[A]:\n                f[A] = t\n                heapq.heappush(pq, (-t, A))\n\nfor s in range(1, N):\n    if f[s] == -1:\n        print(\"Unreachable\")\n    else:\n        print(f[s])\n```",
