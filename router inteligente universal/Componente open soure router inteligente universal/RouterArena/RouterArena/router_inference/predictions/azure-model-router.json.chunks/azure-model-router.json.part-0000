      "generated_answer": "```python\nimport sys\n\ndef solve():\n    data = sys.stdin.read().split()\n    index = 0\n    t = int(data[index])\n    index += 1\n    for _ in range(t):\n        n = int(data[index])\n        k = int(data[index + 1])\n        index += 2\n        s = data[index]\n        index += 1\n        freq = [0] * 26\n        for c in s:\n            freq[ord(c) - ord('a')] += 1\n        m = n - k\n        target = m % 2\n        ans = \"NO\"\n        if target == 0:\n            sum_lo = 0\n            sum_hi = 0\n            ok = True\n            for i in range(26):\n                f = freq[i]\n                orig = f % 2\n                des = 0\n                req = orig ^ des\n                if req == 1 and f == 0:\n                    ok = False\n                    break\n                lo = req\n                hi = f if (f % 2 == req) else f - 1\n                sum_lo += lo\n                sum_hi += hi\n            if ok and sum_lo <= k <= sum_hi and (k - sum_lo) % 2 == 0:\n                ans = \"YES\"\n        else:\n            for special in range(26):\n                sum_lo = 0\n                sum_hi = 0\n                ok = True\n                for i in range(26):\n                    f = freq[i]\n                    orig = f % 2\n                    des = 1 if i == special else 0\n                    req = orig ^ des\n                    if req == 1 and f == 0:\n                        ok = False\n                        break\n                    lo = req\n                    hi = f if (f % 2 == req) else f - 1\n                    sum_lo += lo\n                    sum_hi += hi\n                if ok and sum_lo <= k <= sum_hi and (k - sum_lo) % 2 == 0:\n                    ans = \"YES\"\n                    break\n        print(ans)\n\nsolve()\n```",
