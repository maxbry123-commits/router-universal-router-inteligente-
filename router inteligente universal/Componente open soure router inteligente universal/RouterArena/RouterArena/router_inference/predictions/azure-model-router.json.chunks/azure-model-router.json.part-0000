      "generated_answer": "```python\nimport sys\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    idx = 0\n    N = int(data[idx]); idx += 1\n    M = int(data[idx]); idx += 1\n    adj = [[] for _ in range(N + 1)]\n    for _ in range(M):\n        u = int(data[idx]); idx += 1\n        v = int(data[idx]); idx += 1\n        b = int(data[idx]); idx += 1\n        c = int(data[idx]); idx += 1\n        adj[u].append((v, b, c))\n\n    def check(r):\n        dp = [float('-inf')] * (N + 1)\n        dp[1] = 0.0\n        for u in range(1, N + 1):\n            if dp[u] == float('-inf'):\n                continue\n            for v, b, c in adj[u]:\n                w = b - r * c\n                newval = dp[u] + w\n                if newval > dp[v]:\n                    dp[v] = newval\n        return dp[N] >= -1e-10\n\n    lo = 0.0\n    hi = 10001.0\n    for _ in range(100):\n        mid = (lo + hi) / 2\n        if check(mid):\n            lo = mid\n        else:\n            hi = mid\n    print(\"%.15f\" % lo)\n\nmain()\n```",
