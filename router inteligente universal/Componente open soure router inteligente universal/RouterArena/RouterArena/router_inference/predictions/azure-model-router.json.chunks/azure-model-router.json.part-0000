      "generated_answer": "```python\ndef maxGroups(usageLimits):\n    n = len(usageLimits)\n    if n == 0:\n        return 0\n    sorted_l = sorted(usageLimits, reverse=True)\n    prefix = [0] * (n + 1)\n    for i in range(n):\n        prefix[i + 1] = prefix[i] + sorted_l[i]\n    \n    def can_form(k):\n        if k == 0:\n            return True\n        for m in range(1, k + 1):\n            # Binary search for the smallest p where sorted_l[p] <= m\n            left, right = 0, n\n            while left < right:\n                mid = (left + right) // 2\n                if sorted_l[mid] > m:\n                    left = mid + 1\n                else:\n                    right = mid\n            p = left\n            total_cap = m * p + prefix[n] - prefix[p]\n            need = m * (2 * k - m + 1) // 2\n            if total_cap < need:\n                return False\n        return True\n    \n    lo, hi = 0, n\n    while lo < hi:\n        mid = (lo + hi + 1) // 2\n        if can_form(mid):\n            lo = mid\n        else:\n            hi = mid - 1\n    return lo\n```",
