      "generated_answer": "```python\nimport sys\n\ndef get_queries(L, R, N):\n    queries = []\n    current = L\n    while current <= R:\n        rem_len = R - current + 1\n        i = 0\n        while (1 << (i + 1)) <= rem_len and (current % (1 << (i + 1))) == 0:\n            i += 1\n        size = 1 << i\n        j = current // size\n        queries.append((i, j))\n        current += size\n    return queries\n\ndef main():\n    line = sys.stdin.readline().strip()\n    N, L, R = map(int, line.split())\n    queries = get_queries(L, R, N)\n    total = 0\n    for i, j in queries:\n        print(f\"? {i} {j}\", flush=True)\n        resp = sys.stdin.readline().strip()\n        T = int(resp)\n        if T == -1:\n            sys.exit(0)\n        total = (total + T) % 100\n    print(f\"! {total}\", flush=True)\n\nif __name__ == \"__main__\":\n    main()\n```",
