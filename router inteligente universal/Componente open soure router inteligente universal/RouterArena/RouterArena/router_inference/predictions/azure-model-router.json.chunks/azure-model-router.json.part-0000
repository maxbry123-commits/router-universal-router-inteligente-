      "generated_answer": "```python\nimport sys\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    index = 0\n    N = int(data[index]); index += 1\n    M = int(data[index]); index += 1\n    PT = []\n    REG = []\n    OP = []\n    for i in range(N):\n        t = int(data[index]); index += 1\n        x = int(data[index]); index += 1\n        if t == 0:\n            PT.append(x)\n        elif t == 1:\n            REG.append(x)\n        else:\n            OP.append(x)\n    pt_sort = sorted(PT, reverse=True)\n    reg_sort = sorted(REG, reverse=True)\n    op_sort = sorted(OP, reverse=True)\n    np_ = len(pt_sort)\n    nr_ = len(reg_sort)\n    no_ = len(op_sort)\n    prefix_pt = [0] * (np_ + 1)\n    for i in range(np_):\n        prefix_pt[i + 1] = prefix_pt[i] + pt_sort[i]\n    prefix_reg = [0] * (nr_ + 1)\n    for i in range(nr_):\n        prefix_reg[i + 1] = prefix_reg[i] + reg_sort[i]\n    prefix_op = [0] * (no_ + 1)\n    for i in range(no_):\n        prefix_op[i + 1] = prefix_op[i] + op_sort[i]\n    max_hap = 0\n    # r = 0\n    p = M\n    hap = prefix_pt[min(p, np_)]\n    max_hap = hap\n    maxr = min(M, nr_)\n    for r in range(1, maxr + 1):\n        if prefix_op[no_] < r:\n            continue\n        lo = 1\n        hi = no_\n        ans = no_ + 1  # invalid\n        while lo <= hi:\n            mid = (lo + hi) // 2\n            if prefix_op[mid] >= r:\n                ans = mid\n                hi = mid - 1\n            else:\n                lo = mid + 1\n        o = ans\n        if o > M - r or o > no_:\n            continue\n        p = M - r - o\n        hap = prefix_pt[min(p, np_)] + prefix_reg[min(r, nr_)]\n        if hap > max_hap:\n            max_hap = hap\n    print(max_hap)\n\nmain()\n```",
