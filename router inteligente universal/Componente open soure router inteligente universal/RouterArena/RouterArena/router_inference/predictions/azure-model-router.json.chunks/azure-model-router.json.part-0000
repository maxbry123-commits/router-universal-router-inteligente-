    "generated_result": {
      "generated_answer": "```python\nimport sys\n\ninput = sys.stdin.read\ndata = input().strip()\n\nMOD = 998244353\nN = 300010\n\nfact = [1] * N\nfor i in range(1, N):\n    fact[i] = fact[i - 1] * i % MOD\n\ninvfact = [1] * N\ninvfact[N - 1] = pow(fact[N - 1], MOD - 2, MOD)\nfor i in range(N - 2, -1, -1):\n    invfact[i] = invfact[i + 1] * (i + 1) % MOD\n\npow26 = [1] * N\nfor i in range(1, N):\n    pow26[i] = pow26[i - 1] * 26 % MOD\n\n\ndef comb(q, k):\n    if k < 0 or k > q:\n        return 0\n    return fact[q] * invfact[k] % MOD * invfact[q - k] % MOD\n\n\ndef perm(m, k):\n    if k < 0 or k > m:\n        return 0\n    return fact[m] * invfact[m - k] % MOD\n\n\nS = ' ' + data\nn = len(data)\nchoices_upper = [0] * (n + 2)\nchoices_lower = [0] * (n + 2)\nfor i in range(1, n + 1):\n    if S[i].isupper():\n        choices_upper[i] = 1\n        choices_lower[i] = 0\n    elif S[i].islower():\n        choices_upper[i] = 0\n        choices_lower[i] = 1\n    else:  # '?'\n        choices_upper[i] = 26\n        choices_lower[i] = 26\n\nupper_ways = [0] * (n + 2)\nlower_ways = [0] * (n + 2)\nupper_ways[n + 1] = 1\nlower_ways[n + 1] = 1\nfor i in range(n, 0, -1):\n    upper_ways[i] = choices_upper[i] * upper_ways[i + 1] % MOD\n    lower_ways[i] = choices_lower[i] * lower_ways[i + 1] % MOD\n\nsafe = [0] * (n + 2)\nsafe[n + 1] = 1\nfor i in range(n, 0, -1):\n    safe[i] = (choices_upper[i] * safe[i + 1] + choices_lower[i] * lower_ways[i + 1]) % MOD\n\n# Now the main computation\ncurrent_fixed_occ = [0] * 26\ncurrent_f = 0\nconflict = False\nq_cum = 0\ntotal_repeat_contrib = 0\n\nfor r in range(1, n + 1):\n    # Compute for prefix 1..r-1\n    if conflict:\n        ways_prefix = 0\n        total_ways = 0\n        sum_d = 0\n    else:\n        q = q_cum\n        rr = 26 - current_f\n        total_ways = 0\n        sum_d = 0\n        mink = min(q, rr)\n        for k in range(mink + 1):\n            cqk = comb(q, k)\n            perk = perm(rr, k)\n            pwr = pow26[q - k]\n            waysk = cqk * perk % MOD * pwr % MOD\n            total_ways = (total_ways + waysk) % MOD\n            dk = current_f + k\n            sum_d = (sum_d + waysk * dk % MOD) % MOD\n\n    # Now repeat at r\n    repeat_ways_at_r = 0\n    if S[r] == '?' or S[r].isupper():\n        if S[r] == '?':\n            repeat_ways_at_r = sum_d\n        else:\n            c_idx = ord(S[r]) - ord('A')\n            is_fixed_in_prefix = (current_fixed_occ[c_idx] >= 1)\n            if is_fixed_in_prefix:\n                ways_with_c = total_ways\n            else:\n                ways_with_c = 0\n                m = 26 - current_f\n                mink = min(q, m)\n                for k in range(1, mink + 1):\n                    cqk = comb(q, k)\n                    perk = perm(m, k)\n                    perk_no_c = perm(m - 1, k)\n                    diff = (perk - perk_no_c + MOD) % MOD\n                    pwr = pow26[q - k]\n                    waysk_c = cqk * diff % MOD * pwr % MOD\n                    ways_with_c = (ways_with_c + waysk_c) % MOD\n            repeat_ways_at_r = ways_with_c\n\n    total_for_r = repeat_ways_at_r * safe[r + 1] % MOD\n    total_repeat_contrib = (total_repeat_contrib + total_for_r) % MOD\n\n    # Update state with position r\n    if S[r].isupper():\n        c_idx = ord(S[r]) - ord('A')\n        current_fixed_occ[c_idx] += 1\n        if current_fixed_occ[c_idx] == 1:\n            current_f += 1\n        elif current_fixed_occ[c_idx] >= 2:\n            conflict = True\n    elif S[r] == '?':\n        q_cum += 1\n\n# Now no_repeat for whole string\nno_repeat_ways = 0\nif not conflict:\n    q = q_cum\n    rr = 26 - current_f\n    mink = min(q, rr)\n    for k in range(mink + 1):\n        cqk = comb(q, k)\n        perk = perm(rr, k)\n        pwr = pow26[q - k]\n        waysk = cqk * perk % MOD * pwr % MOD\n        no_repeat_ways = (no_repeat_ways + waysk) % MOD\n\nans = (total_repeat_contrib + no_repeat_ways) % MOD\nprint(ans)\n```",
