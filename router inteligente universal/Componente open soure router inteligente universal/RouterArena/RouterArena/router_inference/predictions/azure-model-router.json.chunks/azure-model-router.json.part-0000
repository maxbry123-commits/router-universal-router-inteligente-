    "generated_result": {
      "generated_answer": "```python\nimport sys\nimport heapq\n\ndef solve():\n    data = sys.stdin.read().split()\n    idx = 0\n    N = int(data[idx]); idx += 1\n    A = int(data[idx]); idx += 1\n    B = int(data[idx]); idx += 1\n    C = int(data[idx]); idx += 1\n    D = [[0] * N for _ in range(N)]\n    for i in range(N):\n        for j in range(N):\n            D[i][j] = int(data[idx]); idx += 1\n\n    V = 2 * N\n    INF = 10**18\n    graph = [[] for _ in range(V)]\n\n    def node_car(i):\n        return i\n\n    def node_train(i):\n        return N + i\n\n    for i in range(N):\n        ci = node_car(i)\n        ti = node_train(i)\n        # switch from car to train at i\n        graph[ci].append((ti, 0))\n        # car edges\n        for j in range(N):\n            if i != j:\n                cj = node_car(j)\n                cost = D[i][j] * A\n                graph[ci].append((cj, cost))\n        # train edges\n        for j in range(N):\n            if i != j:\n                tj = node_train(j)\n                cost = D[i][j] * B + C\n                graph[ti].append((tj, cost))\n\n    dist = [INF] * V\n    start = node_car(0)\n    dist[start] = 0\n    pq = []\n    heapq.heappush(pq, (0, start))\n\n    while pq:\n        dd, u = heapq.heappop(pq)\n        if dd > dist[u]:\n            continue\n        for v, w in graph[u]:\n            if dist[v] > dist[u] + w:\n                dist[v] = dist[u] + w\n                heapq.heappush(pq, (dist[v], v))\n\n    car_n = node_car(N - 1)\n    train_n = node_train(N - 1)\n    ans = min(dist[car_n], dist[train_n])\n    print(ans)\n\nsolve()\n```",
