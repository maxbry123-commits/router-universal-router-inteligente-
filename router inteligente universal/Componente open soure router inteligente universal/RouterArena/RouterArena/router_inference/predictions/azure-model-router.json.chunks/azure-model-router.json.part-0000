    "generated_result": {
      "generated_answer": "```python\nimport sys\n\ndef main():\n    data = sys.stdin.read().split()\n    idx = 0\n    N = int(data[idx]); idx += 1\n    M = int(data[idx]); idx += 1\n    wheels = []\n    for i in range(N):\n        C = int(data[idx]); idx += 1\n        P = int(data[idx]); idx += 1\n        S = []\n        for j in range(P):\n            S.append(int(data[idx])); idx += 1\n        wheels.append((C, P, S))\n    \n    dp = [0.0] * (M + 1)\n    for k in range(M - 1, -1, -1):\n        min_cost = float('inf')\n        for C, P, Slist in wheels:\n            exp_add = 0.0\n            for s in Slist:\n                newk = min(k + s, M)\n                exp_add += dp[newk]\n            exp_add /= P\n            total = C + exp_add\n            if total < min_cost:\n                min_cost = total\n        dp[k] = min_cost\n    print(\"%.15f\" % dp[0])\n\nmain()\n```",
