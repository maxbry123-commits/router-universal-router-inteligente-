      "generated_answer": "```python\nimport sys\n\ndef solve(stdin):\n    data = stdin.split()\n    idx = 0\n    N = int(data[idx]); idx += 1\n    Q = int(data[idx]); idx += 1\n    adj = [set() for _ in range(N + 1)]\n    deg = [0] * (N + 1)\n    isolated = N\n    outputs = []\n    for _ in range(Q):\n        tp = int(data[idx]); idx += 1\n        if tp == 1:\n            u = int(data[idx]); idx += 1\n            v = int(data[idx]); idx += 1\n            if deg[u] == 0:\n                isolated -= 1\n            if deg[v] == 0:\n                isolated -= 1\n            deg[u] += 1\n            deg[v] += 1\n            adj[u].add(v)\n            adj[v].add(u)\n        else:\n            v = int(data[idx]); idx += 1\n            neighbors = list(adj[v])\n            for u in neighbors:\n                deg[u] -= 1\n                adj[u].discard(v)\n                if deg[u] == 0:\n                    isolated += 1\n            adj[v].clear()\n            deg[v] = 0\n            if neighbors:\n                isolated += 1\n        outputs.append(str(isolated))\n    print('\\n'.join(outputs))\n\nsolve(sys.stdin.read())\n```",
