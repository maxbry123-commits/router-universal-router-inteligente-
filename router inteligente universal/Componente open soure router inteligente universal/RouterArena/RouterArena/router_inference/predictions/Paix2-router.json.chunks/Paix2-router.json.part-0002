      "generated_answer": "```python\ndef medianOfUniquenessArray(nums):\n    n = len(nums)\n    total_subarrays = n * (n + 1) // 2\n    target = (total_subarrays + 1) // 2\n    \n    def count_subarrays_at_most(k):\n        if k == 0:\n            return 0\n        count = 0\n        left = 0\n        freq = {}\n        distinct = 0\n        for right in range(n):\n            val = nums[right]\n            freq[val] = freq.get(val, 0) + 1\n            if freq[val] == 1:\n                distinct += 1\n            while distinct > k:\n                left_val = nums[left]\n                freq[left_val] -= 1\n                if freq[left_val] == 0:\n                    distinct -= 1\n                left += 1\n            count += right - left + 1\n        return count\n    \n    lo, hi = 1, n\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if count_subarrays_at_most(mid) >= target:\n            hi = mid\n        else:\n            lo = mid + 1\n    \n    return lo\n```",
