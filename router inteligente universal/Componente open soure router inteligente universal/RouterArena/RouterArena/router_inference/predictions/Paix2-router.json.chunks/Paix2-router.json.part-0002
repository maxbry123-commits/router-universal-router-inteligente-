id):\n            return \"Yes\"\n    return \"No\"\n\ndef can_place(tile, x, y, H, W):\n    h, w = tile\n    return x >= 0 and y >= 0 and y + h <= H and x + w <= W\n\ndef get_covered_cells(x, y, tile, H, W):\n    h, w = tile\n    return ((i, j) for i in range(y, y + h) for j in range(x, x + w))\n\n# Read input\ninput_lines = sys.stdin.read().splitlines()\nN, H, W = map(int, input_lines[0].split())\ntiles = [tuple(map(int, line.split())) for line in input_lines[1:N+1]]\n\n# Call the function and print the result\nprint(can_cover_grid(N, H, W, tiles))\n```",
