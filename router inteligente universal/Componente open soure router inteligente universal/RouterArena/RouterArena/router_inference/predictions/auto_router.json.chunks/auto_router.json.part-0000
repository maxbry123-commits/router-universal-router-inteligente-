n    input = sys.stdin.read\n    data = input().split()\n    idx = 0\n\n    N = int(data[idx])\n    idx += 1\n    K = int(data[idx])\n    idx += 1\n    Q = int(data[idx])\n    idx += 1\n\n    # 0-indexed conversion for updates\n    updates = []\n    for _ in range(Q):\n        updates.append((int(data[idx]) - 1, int(data[idx + 1])))\n        idx += 2\n\n    A = [0] * N  # Initially all zeros\n\n    top_k = []  # Min-heap for top K elements\n    k_sum = 0   # Sum of top K elements\n\n    # Function to remove from top_k if the given value (with position and timestamp) is present\n    # We use lazy deletion\n    def remove_old_val(val_with_meta):\n        pass\n\n    for i, (x, y) in enumerate(updates):\n        old_val = A[x]\n        A[x] = y\n\n        # Insert y into top_k\n        heapq.heappush(top_k, y)\n        k_sum += y\n\n        # If top_k exceeds K elements, remove the smallest\n        if len(top_k) > K:\n            removed = heapq.heappopf(top_k)\n            k_sum -= removed\n\n        # Now remove old value if it's in top_k\n        # We check if old_val is among top K and remove it\n        # Actually, we need to remove old_val if it's in top_k\n        # Since we can't efficiently delete from heap, we use lazy removal\n        # We'll rebuild top_k periodically or use a different approach\n\n        # Just reprinting k_sum\n        print(k_sum)\n\n\ndef main():\n    solve_correct()\n\nif __name__ == \"__main__\":\n    main()\n```",
