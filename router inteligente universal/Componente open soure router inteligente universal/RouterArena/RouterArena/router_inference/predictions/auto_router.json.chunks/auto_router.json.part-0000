right:\n                    if logs[temp_idx][0] == server_to_remove and logs[temp_idx][1] >= start_time:\n                        found = True\n                        break\n                    temp_idx += 1\n                if not found:\n                    active_servers.discard(server_to_remove)\n            left += 1\n        \n        # Count servers that did NOT receive requests\n        result[original_idx] = n - len(active_servers)\n    \n    return result\n```",
