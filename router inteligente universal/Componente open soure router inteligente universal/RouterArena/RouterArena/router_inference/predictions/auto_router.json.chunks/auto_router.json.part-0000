                  # Actually, inside loop C3\n                    pass\n\n    # Let's write the nested loops explicitly for speed.\n    for a2 in shifts:\n        for b2 in shifts:\n            for c2 in shifts:\n                # V12\n                ov12_x = max(0, 7 - abs(a2))\n                ov12_y = max(0, 7 - abs(b2))\n                ov12_z = max(0, 7 - abs(c2))\n                if ov12_x == 0 or ov12_y == 0 or ov12_z == 0:\n                    v12 = 0\n                else:\n                    v12 = ov12_x * ov12_y * ov12_z\n                \n                # Span for triple intersection involving C1(0,0,0)\n                # span_x = max(a2, 0, a3) - min(a2, 0, a3)\n                # If a2, a3 are signs.\n                # If we iterate a2, a3 from -7 to 7, we can compute span efficiently.\n                # span = max(a2, a3, 0) - min(a2, a3, 0)\n                # ov_trp_x = 7 - span\n                \n                # Now iterate C3\n                for a3 in shifts:\n                    for b3 in shifts:\n                        for c3 in shifts:\n                            # Calculate pairwise sums\n                            # C1(0,0,0) - C2(a2,b2,c2)\n                            # C1(0,0,0) - C3(a3,b3,c3)\n                            # C2(a2,b2,c2) - C3(a3,b3,c3)\n                            \n                            # V12 precalculated\n                            \n                            ov23_x = max(0, 7 - abs(a2-a3))\n                            ov23_y = max(0, 7 - abs(b2-b3))\n                            ov23_z = max(0, 7 - abs(c2-c3))\n                            \n                            if ov23_x == 0 or ov23_y == 0 or ov23_z == 0:\n                                v23 = 0\n                            else:\n                                v23 = ov23_x * ov23_y * ov23_z\n                                \n                            ov13_x = max(0, 7 - abs(a3))\n                            ov13_y = max(0, 7 - abs(b3))\n       