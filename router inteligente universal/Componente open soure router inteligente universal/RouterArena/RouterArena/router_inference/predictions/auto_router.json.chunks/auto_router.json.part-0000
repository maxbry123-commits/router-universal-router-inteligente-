ator))\n        M = int(next(iterator))\n    except StopIteration:\n        return\n\n    sets = []\n    # sets_containing_element[v] stores the list of set indices that contain integer v.\n    # v ranges from 1 to M.\n    sets_containing_element = [[] for _ in range(M + 1)]\n    \n    start_sets = []\n    target_sets = []\n    \n    # Parse sets\n    for i in range(N):\n        try:\n            A = int(next(iterator))\n            s_members = []\n            contains_1 = False\n            contains_M = False\n            \n            for _ in range(A):\n                val = int(next(iterator))\n                s_members.append(val)\n                if val == 1:\n                    contains_1 = True\n                if val == M:\n                    contains_M = True\n            \n            sets.append(s_members)\n            \n            if contains_1:\n                start_sets.append(i)\n            if contains_M:\n                target_sets.append(i)\n            \n            for val in s_members:\n                sets_containing_element[val].append(i)\n        except StopIteration:\n            break\n    \n    # Check for intersection (if any set contains both 1 and M)\n    set_start_indices = set(start_sets)\n    set_target_indices = set(target_sets)\n    intersection = set_start_indices & set_target_indices\n    \n    if intersection:\n        print(0)\n        return\n        \n    if not target_sets:\n        print(-1)\n        return\n        \n    # BFS initialization\n    # Nodes 0..N-1 represent sets\n    # Nodes N..N+M-1 represent elements 1..M\n    # Element x (1-based) maps to index N + x - 1\n    \n    dist = [-1] * (N + M)\n    q = deque()\n    \n    for s_idx in start_sets:\n        dist[s_idx] = 0\n        q.append(s_idx)\n        \n    # BFS\n    while q:\n        u = q.popleft()\n        d_u = dist[u]\n        \n        if u < N:\n            # u is a Set node\n            # Expand to Element neighbors\n            s_list = sets[u]\