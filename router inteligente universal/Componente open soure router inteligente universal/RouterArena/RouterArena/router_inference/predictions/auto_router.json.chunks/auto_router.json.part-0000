    "prediction": "qwen/qwen3.5-9b",
    "generated_result": {
      "generated_answer": "def maximumFrequency(nums: list[int], k: int) -> int:\n    \"\"\"\n    Returns the maximum frequency of any single element in the array\n    achievable within at most k operations, where each operation allows\n    incrementing or decrementing an element by 1.\n    \"\"\"\n    nums.sort()\n    n = len(nums)\n    if n == 0:\n        return 0\n\n    # Prefix sums to allow O(1) sum queries over subarrays\n    prefix_sum = [0] * (n + 1)\n    for i in range(n):\n        prefix_sum[i + 1] = prefix_sum[i] + nums[i]\n\n    max_freq = 0\n    left = 0\n\n    for right in range(n):\n        # Cost to bring all elements from index [left, right] to nums[right]\n        window_sum = prefix_sum[right + 1] - prefix_sum[left]\n        window_size = right - left + 1\n        cost = window_size * nums[right] - window_sum\n\n        # Shrink window if cost exceeds k\n        while cost > k and left <= right:\n            left += 1\n            # Recalculate cost for the new window\n            if left > right:\n                break\n            window_sum = prefix_sum[right + 1] - prefix_sum[left]\n            window_size = right - left + 1\n            cost = window_size * nums[right] - window_sum\n\n        if left <= right:\n            max_freq = max(max_freq, right - left + 1)\n\n    return max_freq",
