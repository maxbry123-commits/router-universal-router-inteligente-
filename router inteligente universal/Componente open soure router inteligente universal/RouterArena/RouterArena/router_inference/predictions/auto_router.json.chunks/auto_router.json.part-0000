+= prev_dp[k-1]\n            \n            # Iterate to next submask of 'others'\n            if submask == 0:\n                break\n            submask = (submask - 1) & others\n            \n    # The answer is the number of ways to partition the full set into exactly T sets\n    print(dp[full_mask][T])\n\nif __name__ == '__main__':\n    solve()\n```",
