is no walk that visits all vertices at least once.\n\nSample Input 3\n\n5 9\r\n1 2 -246288\r\n4 5 -222742\r\n3 1 246288\r\n3 4 947824\r\n5 2 -178721\r\n4 3 -947824\r\n5 4 756570\r\n2 5 707902\r\n5 1 36781\n\nSample Output 3\n\n-449429",
    "prediction": "qwen/qwen3-235b-a22b-2507",
    "generated_result": {
      "generated_answer": "```python\nimport sys\nfrom collections import defaultdict\nimport heapq\n\ndef solve():\n    input = sys.stdin.read\n    data = input().split()\n    \n    if not data:\n        print(\"No\")\n        return\n    \n    # Parse first two tokens as N and M\n    n = int(data[0])\n    m = int(data[1])\n    \n    # Build adjacency list\n    graph = defaultdict(list)\n    edges = []\n    \n    index = 2\n    for _ in range(m):\n        u = int(data[index])\n        v = int(data[index+1])\n        w = int(data[index+2])\n        index += 3\n        graph[u].append((v, w))\n        edges.append((u, v, w))\n    \n    # Use Floyd-Warshall to compute shortest paths between all pairs\n    # Since we can traverse edges multiple times and want minimum weight walk\n    INF = float('inf')\n    dist = [[INF] * (n+1) for _ in range(n+1)]\n    \n    # Distance from a node to itself is 0\n    for i in range(1, n+1):\n        dist[i][i] = 0\n    \n    # Direct edges\n    for u, v, w in edges:\n        dist[u][v] = min(dist[u][v], w)\n    \n    # Floyd-Warshall algorithm\n    for k in range(1, n+1):\n        for i in range(1, n+1):\n            for j in range(1, n+1):\n                if dist[i][k] != INF and dist[k][j] != INF:\n                    dist[i][j] = min(dist[i][j], dist[i][k] + dist[k][j])\n    \n    # Check if the graph is strongly connected (we can reach every vertex from every other vertex)\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if dist[i][j] == INF:\n                print(\"No\")\n                return\n    \n    # Since the graph is strongly connected and has no negative cycles (given),\n    # we can use the following approach:\n    # The minimum walk visiting all vertices at least once can start anywhere.\n    # We want to find the shortest walk that covers all vertices.\n    # This is similar to the Traveling Salesman Problem but we can visit vertices multiple times.\n    # Since we have all-pairs shortest paths, we can think of a complete graph where\n    # edge (i,j) has weight = shortest path from i to j in original graph.\n    # Then we want the shortest walk that visits each vertex at least once.\n    #\n    # However, since we can revisit vertices, and we have the shortest paths,\n    # any optimal solution can be thought of as moving from vertex to vertex\n    # using shortest paths. We need to find the minimum cost to cover all vertices.\n    #\n    # We can use DP over subsets. Let dp[mask][i] = minimum cost to visit all vertices in mask,\n    # ending at vertex i.\n    \n    # Total number of subsets\n    total_subsets = 1 << n\n    \n    # dp[mask][i] = minimum cost to visit all vertices in mask, ending at vertex i (0-indexed internally, but 1-indexed externally)\n    dp = [[INF] * n for _ in range(total_subsets)]\n    \n    # Initialize: starting at each vertex costs 0\n    for i in range(n):\n        dp[1 << i][i] = 0\n    \n    # Iterate over all masks\n    for mask in range(total_subsets):\n        # For each vertex in the current mask\n        for u in range(n):\n            if mask & (1 << u) == 0:  # u not in mask\n                continue\n            if dp[mask][u] == INF:\n                continue\n            # Try to extend to another vertex v\n            for v in range(n):\n                if mask & (1 << v):\n                    continue  # already visited v, but we can still go to v (it's allowed)\n                \n                # Go from u (vertex u+1) to v (vertex v+1) using shortest path\n                u_vertex = u + 1\n                v_vertex = v + 1\n                cost = dist[u_vertex][v_vertex]\n                if cost == INF:\n                    continue\n                \n                new_mask = mask | (1 << v)\n                new_cost = dp[mask][u] + cost\n                if new_cost < dp[new_mask][v]:\n                    dp[new_mask][v] = new_cost\n    \n    # We want the minimum cost to visit all vertices\n    full_mask = total_subsets - 1\n    answer = INF\n    for i in range(n):\n        if dp[full_mask][i] < answer:\n            answer = dp[full_mask][i]\n    \n    if answer == INF:\n        print(\"No\")\n    else:\n        print(answer)\n\nsolve()\n```",
