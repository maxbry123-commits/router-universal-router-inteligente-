      "success": true,
      "token_usage": {
        "input_tokens": 368,
        "output_tokens": 66,
        "total_tokens": 434
      },
      "provider": "openrouter",
      "error": null
    },
    "cost": 0.00012076,
    "accuracy": 1.0,
    "for_optimality": true
