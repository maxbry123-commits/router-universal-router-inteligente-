    "generated_result": {
      "generated_answer": "```python\nimport sys\nfrom sys import stdin\nfrom collections import defaultdict\n\n# Fast I/O\ninput = stdin.readline\n\nclass DSU:\n    def __init__(self, n):\n        self.parent = list(range(n + 1))\n        self.rank = [0] * (n + 1)\n    \n    def find(self, x):\n        if self.parent[x] != x:\n            self.parent[x] = self.find(self.parent[x])\n        return self.parent[x]\n    \n    def union(self, x, y):\n        px, py = self.find(x), self.find(y)\n        if px == py:\n            return\n        if self.rank[px] < self.rank[py]:\n            px, py = py, px\n        self.parent[py] = px\n        if self.rank[px] == self.rank[py]:\n            self.rank[px] += 1\n\ndef solve():\n    data = list(map(int, stdin.read().split()))\n    idx = 0\n    N = data[idx]; M = data[idx + 1]; idx += 2\n    u_start = 0\n    u, v = [], []\n    for i in range(M):\n        u_start += 2\n        u += [data[idx + 2]]\n        v += [data[idx + 3]]\n    \n    dsu = DSU(N)\n    u = [0] * len(u)\n    v = [0] * len(v)\n    read_idx = 2\n    curly_idx = 0\n    while curly_idx < M:\n        u[curly_idx] = u_start + 2 + curly_idx * 2\n        v[curly_idx] = u_start + 2 + curly_idx * 2 + 1\n        u_start += 1\n        dsu.union(u[curly_idx], v[curly_idx])\n    for _ in range(M):\n        pass\n\ndef main():\n    import sys\n    input = sys.stdin.readline\n\n    data = list(map(int, input().read().split()))\n    idx = 0\n    N, M = data[idx], data[idx + 1]\n    idx += 2\n    u = []; v = []\n    for i in range(M):\n        u.append(data[idx]); v.append(data[idx + 1])\n        idx += 2\n    idx += 1  # skip newline or extra\n    K = data[idx]\n    idx += 1\n    x = []; y = []\n    for i in range(K):\n        x.append(data[idx]); y.append(data[idx + 1])\n        idx += 2\n    idx += 1  # Q\n    Q = data[idx]; idx += 1\n    p = [0] * Q; q = [0] * Q\n    for i in range(Q):\n        p[i], q[i] = data[idx], data[idx + 1]\n        idx += 2\n\n    # DSU\n    parent = list(range(N + 1))\n    def find(i):\n        if parent[i] == i:\n            return i\n        parent[i] = find(parent[i])\n        return parent[i]\n\n    def union(i, j):\n        xi, xj = find(i), find(j)\n        if xi != xj:\n            parent[xj] = xi\n\n    # Build components\n    for x_i, y_i in zip(u, v):\n        union(x_i, y_i)\n\n    # Check if initial graph is \"good\": no forbidden path\n    possible = []\n    for i in range(K):\n        fx = find(x[i]), fy = find(y[i])\n        if fx == fy:\n            # Already connected (shouldn't happen per problem)\n            break\n        possible.append((i, fx, fy))\n\n    # For each query: new edge (p, q) connects comp[p] and comp[q]\n    # Check if any constraint forbids path (x_i, y_i) becomes connected\n    output = []\n\n    for i in range(Q):\n        pi, qi = p[i], q[i]\n       /components[p[i]] | components[q[i]]]\n        \n        # Check each constraint\n        bad = False\n        for idx, fx, fy in possible:\n            # After union, check if x_i, y_i now in same component\n            if fx == components[pi] and fy == components[qi]:\n                bad = True; break\n            if fx == components[qi] and fy == components[pi]:\n                bad = True; break\n        \n        if bad:\n            output.append(\"No\")\n        else:\n            output.append(\"Yes\")\n    \n    print(\"\\n\".join(output))\n\nmain()\n```\n\n\\[\n\\]",
