f permutations for each character's placement\n            # within a row might still explode.\n            # A more disciplined backtracking approach:\n            # For each row, try placing 'A', 'B', 'C' in available spots.\n\n            temp_grid = [list(row) for row in current_grid]\n            temp_grid[row_idx] = list(p) # This will need to be more sophisticated\n\n            # The permutation approach directly applied to rows is too simple.\n            # We need to place characters considering column constraints.\n\n            # Let's redefine the state: grid, current row, columns filled status for A, B, C\n            # A better approach would be to have a recursive function that tries to fill\n            # cells one by one, or row by row, with constraint checking at each step.\n\n            # For N=3 to 5, a column-by-column or cell-by-cell backtracking might be more feasible.\n            # Let's try a cell-by-cell backtracking approach.\n\n            return backtrack(0, 0, [[d for d in row] for row in current_grid]) # Start over with better backtrack\n\n    def backtrack(r, c, grid):\n        if r == N:\n            if is_valid(grid):\n                solutions.append([\"\".join(row) for row in grid])\n            return\n\n        next_r, next_c = (r, c + 1) if c + 1 < N else (r + 1, 0)\n\n        # If cell is already filled (from a previous step, not applicable in this simple structure but good for general backtrack)\n        # For this problem, we are constructing from scratch.\n\n        # Try placing characters\n        chars_to_try = ['A', 'B', 'C']\n        for char in chars_to_try:\n            grid[r][c] = char\n            if check_partial(grid, r, c):\n                backtrack(next_r, next_c, grid)\n            grid[r][c] = '.' # Backtrack\n\n        # Try leaving it empty\n        grid[r][c] = '.'\n        if check_partial(grid, r, c): # The check_partial here is less meaningful for empty cell\n             backtrack(next_r, next_c, grid)\n        grid[r][c] = '.' # Backtrack if we don't proceed (this line is redundant for empty cell)\n\n\n    def check_partial(grid, current_r, current_c):\n        # Check row constraints for the current row and previous columns\n        row_counts = {'A': 0, 'B': 0, 'C': 0}\n        leftmost_in_row = None\n        for c in range(N):\n            if grid[current_r][c] != '.':\n                row_counts[grid[current_r][c]] += 1\n                if leftmost_in_row is None:\n                    leftmost_in_row = grid[current_r][c]\n        if any(count > 1 for count in row_counts.values()):\n            return False\n        if leftmost_in_row is not None and leftmost_in_row != R[current_r]:\n            return False\n\n        # Check column constraints for the current column and previous rows\n        col_counts = {'A': 0, 'B': 0, 'C': 0}\n        topmost_in_col = None\n        for r in range(N):\n            if grid[r][current_c] != '.':\n                col_counts[grid[r][current_c]] += 1\n                if topmost_in_col is None:\n                    topmost_in_col = grid[r][current_c]\n        if any(count > 1 for count in col_counts.values()):\n            return False\n        if topmost_in_col is not None and topmost_in_col != C[current_c]:\n            return False\n\n        # Check if we have placed too many 'A', 'B', 'C' in total for this row/col up to this point.\n        # This implies we need to know how many of each character can be placed in total.\n        # For each character, there must be exactly one occurence in each row and column.\n        # If we have already placed a character in a row/column, we cannot place it again.\n        row_placed = set()\n        col_placed = set()\n        for r_idx in range(N):\n            for c_idx in range(N):\n                if grid[r_idx][c_idx] != '.':\n                    if grid[r_idx][c_idx] in row_placed and r_idx == current_r: return False\n                    if grid[r_idx][c_idx] in col_placed and c_idx == current_c: return False\n\n                    if r_idx == current_r: row_placed.add(grid[r_idx][c_idx])\n                    if c_idx == current_c: col_placed.add(grid[r_idx][c_idx])\n\n        return True\n\n    solutions = []\n    initial_grid = [['.' for _ in range(N)] for _ in range(N)]\n    backtrack(0, 0, initial_grid)\n\n    if solutions:\n        print(\"Yes\")\n        for row in solutions[0]:\n            print(row)\n    else:\n        print(\"No\")\n\nsolve()\n```",
