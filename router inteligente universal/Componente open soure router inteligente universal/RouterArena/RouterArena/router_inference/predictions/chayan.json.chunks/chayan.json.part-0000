   else: # Column operation\n            if not cols_already_colored[a]:\n                # This is the last operation that will color this column.\n                # It colors W * (W - rows_colored_count) cells with color x.\n                cells_in_this_col = H - rows_colored_count\n                if cells_in_this_col > 0:\n                    if x not in color_counts:\n                        color_counts[x] = 0\n                    color_counts[x] += cells_in_this_col\n                \n                cols_already_colored[a] = True\n                cols_colored_count += 1\n    \n    # The current calculation is trying to sum up contributions directly, which might overcount or undertcount intersections.\n    # Let's re-evaluate:\n    \n    # What determines the color of a cell (r, c)?\n    # It's the color X of the LAST operation (T, A, X) such that either:\n    # 1. T=1 and A=r (row operation) AND this row operation for `r` happens AFTER any column operation on `c` that would overwrite it.\n    # 2. T=2 and A=c (column operation) AND this column operation for `c` happens AFTER any row operation on `r` that would overwrite it.\n    \n    # The key is which rows/columns remain \"uncolored\" by a later, definitive operation.\n    \n    # Final state of rows:\n    # `final_row_color[r]` = color `X` if there was an operation `(1, r, X)` and no `(1, r, Y)` for `i' > i`.\n    # `final_col_color[c]` = color `X` if there was an operation `(2, c, X)` and no `(2, c, Y)` for `i' > i`.\n\n    # This is effectively what `final_row_colors` and `final_col_colors` capture.\n\n    # The counts should be:\n    # For each color `C`:\n    #   Sum of cells painted `C` by:\n    #     - Row operations: `(1, r, C)` where `r` is NOT in `final_col_colors`.\n    #     - Column operations: `(2, c, C)` where `c` is NOT in `final_row_colors`.\n    #     - Intersections: `(r, c)` where `r` is in `final_row_colors` and `c` is in `final_col_colors`, and the color of `(r, c)` is `C`.\n\n    # The simplest way to handle intersections is by processing the operations in reverse and deducing FINAL colors.\n    \n    row_last_op_color = {} # row_idx -> color\n    col_last_op_color = {} # col_idx -> color\n\n    for i in range(M - 1, -1, -1):\n        t, a, x = operations[i]\n        if t == 1:\n            if a not in row_last_op_color:\n                row_last_op_color[a] = x\n        else:\n            if a not in col_last_op_color:\n                col_last_op_color[a] = x\n    \n    color_counts = {}\n    \n    # Cells colored by row operations that are NOT overwritten by a FINAL column operation.\n    # A column operation `(2, c, X)` is FINAL for column `c` if no later operation `(2, c, Y)` exists.\n    # `col_last_op_color` gives exactly these FINAL column colors.\n    \n    for r, color in row_last_op_color.items():\n        # For this row `r`, how many columns are NOT part of `col_last_op_color`?\n        columns_not_finalized_by_col_op = W - len(col_last_op_color)\n        if columns_not_finalized_by_col_op > 0:\n            if color not in color_counts:\n                color_counts[color] = 0\n            color_counts[color] += columns_not_finalized_by_col_op\n            \n    # Cells colored by column operations that are NOT overwritten by a FINAL row operation.\n    # A row operation `(1, r, X)` is FINAL for row `r` if no later operation `(1, r, Y)` exists.\n    # `row_last_op_color` gives exactly these FINAL row colors.\n    \n    for c, color in col_last_op_color.items():\n        # For this column `c`, how many rows are NOT part of `row_last_op_color`?\n        rows_not_finalized_by_row_op = H - len(row_last_op_color)\n        if rows_not_finalized_by_row_op > 0:\n            if color not in color_counts:\n                color_counts[color] = 0\n            color_counts[color] += rows_not_finalized_by_row_op\n\n    # Now we need to account for the cells (r, c) where r is in row_last_op_color AND c is in col_last_op_color.\n    # The color of such a cell is determined by the op that occurred LATER in the original sequence.\n    # We can iterate through the ORIGINAL operations.\n    # If an operation (t, a, x) is such that `a`'s final color is set by *this* operation, AND the other dimension is also finalized by a later op:\n    \n    # Let's track how many distinct cells are covered correctly.\n    # Total cells = H * W.\n    # We iterate through rows finalized by last op applied to them.\n    # And columns finalized by last op applied to them.\n\n    # Final counts:\n    # For each `(r, row_c)` in `row_last_op_color.items()`:\n    #   This row contributes `W` cells initially.\n    #   However, if a column `c` has `col_last_op_color[c] != row_c`, AND this column op on `c` happened LATER than the row op on `r`, then `(r, c)` will have the column color.\n    #   This is getting complicated.\n\n    # The simplest approach for intersections:\n    # For each `r` that is a key in `row_last_op_color`:\n    #   For each `c` that is a key in `col_last_op_color`:\n    #     We know the color of `(r, c)` is determined by the operation that had a higher index `i`.\n    #     We can find this easily by iterating through operations in reverse.\n    \n    # The problem is that `row_last_op_color` and `col_last_op_color` store the color set by the last operation *for that specific row/column*.\n    # They don't store the operation index.\n\n    # We need the OPERATION INDEX of the last operation for each row/column.\n    row_last_op_idx = {} # row_idx -> op_idx\n    col_last_op_idx = {} # col_idx -> op_idx\n\n    for i in range(M):\n        t, a, x = operations[i]\n        if t == 1:\n            row_last_op_idx[a] = i\n        else:\n            col_last_op_idx[a] = i\n\n    color_counts = {}\n    \n    # Cells colored by row operations that are NOT overwritten by a column operation with a HIGHER index.\n    for r, last_op_idx_r in row_last_op_idx.items():\n        color_r = operations[last_op_idx_r][2]\n        \n        # How many columns `c` have their LAST operation index `last_op_idx_rc` LESS than `last_op_idx_r`?\n        # These are the columns that are effectively colored by the row operation.\n        \n        cells_colored_by_this_row = 0\n        for c in range(1, W + 1):\n            if c not in col_last_op_idx or col_last_op_idx[c] < last_op_idx_r:\n                cells_colored_by_this_row += 1\n        \n        if color_r not in color_counts:\n            color_counts[color_r] = 0\n        color_counts[color_r] += cells_colored_by_this_row\n\n    # Cells colored by column operations that are NOT overwritten by a row operation with a HIGHER index.\n    for c, last_op_idx_c in col_last_op_idx.items():\n        color_c = operations[last_op_idx_c][2]\n        \n        # How many rows `r` have their LAST operation index `last_op_idx_rc` LESS than `last_op_idx_c`?\n        # These are the rows that are effectively colored by the column operation.\n        cells_colored_by_this_col = 0\n        for r in range(1, H + 1):\n            if r not in row_last_op_idx or row_last_op_idx[r] < last_op_idx_c:\n                cells_colored_by_this_col += 1\n        \n        if color_c not in color_counts:\n            color_counts[color_c] = 0\n        color_counts[color_c] += cells_colored_by_this_col\n\n    # This approach seems to double count the intersections if both row and col ops were the last for their dimension.\n    # E.g., if row r was last op at index i, and col c was last op at index j.\n    # If i > j: cell (r, c) gets color of row op. It's counted in the first loop. It's NOT counted in the second loop because `row_last_op_idx[r] (which is i) >= last_op_idx_c (which is j)`. This is correct.\n    # If j > i: cell (r, c) gets color of col op. It's counted in the second loop. It's NOT counted in the first loop because `col_last_op_idx[c] (which is j) >= last_op_idx_r (which is i)`. This is correct.\n    \n    # This looks promising!\n\n    sorted_colors = sorted(color_counts.keys())\n    \n    print(len(sorted_colors))\n    for color in sorted_colors:\n        print(color, color_counts[color])\n\n\ndef solve_with_set():\n    H, W, M = map(int, sys.stdin.readline().split())\n    operations = []\n    for _ in range(M):\n        operations.append(list(map(int, sys.stdin.readline().split())))\n\n    # Track the last operation index that affected each row and column.\n    row_last_op_idx = {} # row_id -> op_index\n    col_last_op_idx = {} # col_id -> op_index\n\n    for i in range(M):\n        t, a, x = operations[i]\n        if t == 1: # Row operation\n            row_last_op_idx[a] = i\n        else: # Column operation\n            col_last_op_idx[a] = i\n            \n    color_counts = {}\n\n    # Count cells colored by row operations.\n    for r_id, op_idx_r in row_last_op_idx.items():\n        color = operations[op_idx_r][2]\n        \n        # This row operation colors cells it affects.\n        # A cell (r_id, c_id) is colored by this row operation if:\n        # 1. The operation index of this row operation (op_idx_r) is GREATER than the operation index of the LAST operation that affected column c_id.\n        #    OR column c_id has NOT been affected by any operation before index op_idx_r.\n        \n        cells_colored_by_this_row = 0\n        \n        if len(col_last_op_idx) < W: # If not all columns have a final operation recorded\n            # The number of columns NOT in col_last_op_idx is W - len(col_last_op_idx).\n            # These columns are definitely colored by this row op for the row-component.\n            cells_colored_by_this_row += (W - len(col_last_op_idx))\n            \n        # Now consider columns that DO have a final operation recorded (i.e., they are in col_last_op_idx).\n        for c_id, op_idx_c in col_last_op_idx.items():\n            if op_idx_r > op_idx_c:\n                # The row operation happened LATER than the last column operation affecting c_id.\n                # So, this cell (r_id, c_id) will be colored by the row operation.\n                cells_colored_by_this_row += 1\n        \n        if cells_colored_by_this_row > 0:\n            if color not in color_counts:\n                color_counts[color] = 0\n            color_counts[color] += cells_colored_by_this_row\n            \n    # Count cells colored by column operations.\n    for c_id, op_idx_c in col_last_op_idx.items():\n        color = operations[op_idx_c][2]\n        \n        # This column operation colors cells it affects.\n        # A cell (r_id, c_id) is colored by this column operation if:\n        # 1. The operation index of this column operation (op_idx_c) is GREATER than the operation index of the LAST operation that affected row r_id.\n        #    OR row r_id has NOT been affected by any operation before index op_idx_c.\n\n        cells_colored_by_this_col = 0\n        \n        if len(row_last_op_idx) < H: # If not all rows have a final operation recorded\n            # The number of rows NOT in row_last_op_idx is H - len(row_last_op_idx).\n            # These rows are definitely colored by this col op for the column-component.\n            cells_colored_by_this_col += (H - len(row_last_op_idx))\n        \n        # Now consider rows that DO have a final operation recorded (i.e., they are in row_last_op_idx).\n        for r_id, op_idx_r in row_last_op_idx.items():\n            if op_idx_c > op_idx_r:\n                # The column operation happened LATER than the last row operation affecting r_id.\n                # So, this cell (r_id, c_id) will be colored by the column operation.\n                cells_colored_by_this_col += 1\n                \n        if cells_colored_by_this_col > 0:\n            if color not in color_counts:\n                color_counts[color] = 0\n            color_counts[color] += cells_colored_by_this_col\n\n    # The current logic is double-counting the corners.\n    # If row op at index `i` sets color `C_r` for row `r`.\n    # If col op at index `j` sets color `C_c` for col `c`.\n    # If `i > j`: The cell `(r, c)` should have color `C_r`. `cells_colored_by_this_row` counts it. `cells_colored_by_this_col` does NOT count it because `op_idx_r (i) > op_idx_c (j)`. Correct.\n    # If `j > i`: The cell `(r, c)` should have color `C_c`. `cells_colored_by_this_col` counts it. `cells_colored_by_this_row` does NOT count it because `op_idx_c (j) > op_idx_r (i)`. Correct.\n    \n    # The problem lies in cells that are NOT covered by any 'final' row or column operation. These should be color 0.\n    # The logic implicitly assumes everything is painted. We need to account for \"unpainted\" intersections.\n\n    # Total cells MIGHT be H * W.\n    # The reverse iteration needs to assign the FINAL color.\n    \n    # Let's refine `cells_colored_by_this_row` and `cells_colored_by_this_col`.\n    # If `r` is affected by `op_idx_r`, it covers `W` cells.\n    # Among these `W` cells, some are part of columns whose LAST operation index `op_idx_c` is GREATER than `op_idx_r`. These cells will NOT take the row color.\n\n    color_counts = {}\n    \n    # Iterate through rows that have a LAST operation.\n    for r_id, op_idx_r in row_last_op_idx.items():\n        color = operations[op_idx_r][2]\n        \n        # This row `r_id` will paint cells with `color`.\n        # The number of columns that are NOT covered by a LATER column operation.\n        # Col `c` is NOT covered by a LATER col op if `c` is not in `col_last_op_idx` OR `col_last_op_idx[c] < op_idx_r`.\n        \n        count = 0\n        for c_id in range(1, W + 1):\n            is_column_overwritten_later = False\n            if c_id in col_last_op_idx:\n                if col_last_op_idx[c_id] > op_idx_r:\n                    is_column_overwritten_later = True\n            \n            if not is_column_overwritten_later:\n                count += 1\n        \n        if count > 0:\n            if color not in color_counts:\n                color_counts[color] = 0\n            color_counts[color] += count\n\n    # Iterate through columns that have a LAST operation.\n    for c_id, op_idx_c in col_last_op_idx.items():\n        color = operations[op_idx_c][2]\n        \n        # This column `c_id` will paint cells with `color`.\n        # The number of rows that are NOT covered by a LATER row operation.\n        # Row `r` is NOT covered by a LATER row op if `r` is not in `row_last_op_idx` OR `row_last_op_idx[r] < op_idx_c`.\n        \n        count = 0\n        for r_id in range(1, H + 1):\n            is_row_overwritten_later = False\n            if r_id in row_last_op_idx:\n                if row_last_op_idx[r_id] > op_idx_c:\n                    is_row_overwritten_later = True\n\n            if not is_row_overwritten_later:\n                count += 1\n                \n        if count > 0:\n            if color not in color_counts:\n                color_counts[color] = 0\n            color_counts[color] += count\n\n    # The logic above correctly assigns colors.\n    # When `op_idx_r > op_idx_c`, `cells_colored_by_this_row` gets +1, and `cells_colored_by_this_col` does NOT get +1 for this cell.\n    # When `op_idx_c > op_idx_r`, `cells_colored_by_this_col` gets +1, and `cells_colored_by_this_row` does NOT get +1 for this cell.\n    # If a row `r` has no final operation, and column `c` has a final operation `op_idx_c`, that cell `(r, c)` will be covered by the column operation.\n    # This is counted in the column loop because `r` will not be in `row_last_op_idx`.\n    # Similarly, if `c` has no final operation and `r` has a final operation.\n    \n    # What about color 0? The initial color.\n    # If a cell is never touched by any operation, it remains 0.\n    # My counting method implicitly assumes all cells are painted by some operation.\n    # Or, if a row/column doesn't have a FINAL operation, it means all its cells were covered by operations with HIGHER indices.\n\n    # The number of cells involved in the first loop (row operations):\n    # These are cells `(r_id, c_id)` where `r_id` has `op_idx_r`, and `c_id` is such that it's NOT covered by a *later* column operation.\n    # `W - len(col_last_op_idx)` is the number of columns that have NO final op applied. These are implicitly covered by row ops.\n    # `col_last_op_idx[c_id] < op_idx_r` means the column op on `c_id` happened *before* the row op on `r_id`.\n    \n    # The number of cells NOT involved in any operation is H*W - (cells covered by row ops) - (cells covered by col ops).\n    # These \"unpainted\" cells remain color 0.\n    \n    # The total number of cells counted so far is the sum of `count` in both loops.\n    # This sum should be <= H * W. If it's less, the remaining cells are color 0.\n    \n    total_counted_cells = sum(color_counts.values())\n    \n    if H * W > total_counted_cells:\n        color_0_count = H * W - total_counted_cells\n        if 0 not in color_counts:\n            color_counts[0] = 0\n        color_counts[0] += color_0_count\n\n    sorted_colors = sorted(color_counts.keys())\n    \n    print(len(sorted_colors))\n    for color in sorted_colors:\n        print(color, color_counts[color])\n\nsolve_with_set()\n```",
