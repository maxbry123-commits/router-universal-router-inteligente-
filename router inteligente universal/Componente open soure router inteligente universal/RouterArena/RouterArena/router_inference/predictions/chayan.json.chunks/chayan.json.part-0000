"\n    # This implies that if we have 'aa' occurring multiple times, we only count 'a' and 'aa' once.\n\n    # Let's iterate through the string and identify consecutive blocks of the same character.\n    # For each block, we can determine its length.\n    # The unique substrings of character 'c' of length up to 'k' are 'c', 'cc', ..., 'c' (k times).\n    # This gives us 'k' unique substrings related to that block.\n\n    # We need to count the total number of unique such substrings across the entire string.\n    # A simpler way might be to iterate and collect the unique *longest* runs for each character type.\n\n    # Let's use a dictionary to store the maximum length of consecutive occurrences for each character.\n    max_consecutive_lengths = {}\n\n    if N == 0:\n        print(0)\n        return\n\n    current_char = S[0]\n    current_count = 1\n\n    for i in range(1, N):\n        if S[i] == current_char:\n            current_count += 1\n        else:\n            # Update the maximum consecutive length for the current_char\n            if current_char not in max_consecutive_lengths:\n                max_consecutive_lengths[current_char] = 0\n            max_consecutive_lengths[current_char] = max(max_consecutive_lengths[current_char], current_count)\n\n            # Reset for the new character\n            current_char = S[i]\n            current_count = 1\n\n    # After the loop, update for the last character block\n    if current_char not in max_consecutive_lengths:\n        max_consecutive_lengths[current_char] = 0\n    max_consecutive_lengths[current_char] = max(max_consecutive_lengths[current_char], current_count)\n\n    total_unique_substrings = 0\n    for char in max_consecutive_lengths:\n        # For a character with max consecutive length `k`, it contributes `k` unique substrings\n        # ('c', 'cc', ..., 'c' repeated k times).\n        total_unique_substrings += max_consecutive_lengths[char]\n\n    print(total_unique_substrings)\n\n\ndef solve_v2():\n    N = int(sys.stdin.readline())\n    S = sys.stdin.readline().strip()\n\n    if N == 0:\n        print(0)\n        return\n\n    # We need to find the number of unique non-empty substrings that are repetitions of a single character.\n    # For example, if S = \"aaabaa\", the substrings are:\n    # 'a' (from \"aaa\" and \"aa\")\n    # 'aa' (from \"aaa\" and \"aa\")\n    # 'aaa' (from \"aaa\")\n    # 'b' (from \"b\")\n    # These are 'a', 'aa', 'aaa', 'b', which are 4 unique substrings.\n\n    # The approach is to consider all possible non-empty substrings that are repetitions of one character.\n    # For a character 'c', the possible substrings are 'c', 'cc', 'ccc', and so on.\n    # We want to find all unique strings of this form that appear as substrings in S.\n\n    # We can iterate through the string and identify consecutive runs of identical characters.\n    # For each run of length `k` consisting of character `c`:\n    # The new unique substrings of character `c` we can form are `c`, `cc`, ..., `c` (k times).\n\n    # Let's maintain a set of already counted unique substrings to avoid duplicates.\n    unique_char_substrings = set()\n\n    i = 0\n    while i < N:\n        current_char = S[i]\n        j = i\n        while j < N and S[j] == current_char:\n            j += 1\n        # Substring from i to j-1 is a run of current_char of length (j-i)\n\n        run_length = j - i\n        # For this run of length `run_length` of `current_char`, we can form substrings:\n        # `current_char`, `current_char` * 2, ..., `current_char` * `run_length`.\n        # We add all of these to our set. The set will automatically handle uniqueness.\n        for k in range(1, run_length + 1):\n            unique_char_substrings.add(current_char * k)\n\n        i = j # Move to the next block of characters\n\n    print(len(unique_char_substrings))\n\n\ndef solve_optimized():\n    N = int(sys.stdin.readline())\n    S = sys.stdin.readline().strip()\n\n    if N == 0:\n        print(0)\n        return\n\n    # We need to count the number of unique non-empty substrings of S that are repetitions of one character.\n    # For example, if S = \"aaabaa\", the substrings are:\n    # 'a', 'aa', 'aaa', 'b'. Total 4.\n\n    # The key is to find, for each character 'c', what is the maximum length `k` such that\n    # `c * k` is a substring of S and for any `m > k`, `c * m` is NOT a substring of S.\n    # However, this is not exactly what's needed. We need to count all unique strings like 'c', 'cc', 'ccc', ...\n    # that are present as substrings in S.\n\n    # Consider runs of consecutive identical characters.\n    # If we have a run of 'a's of length 5: \"aaaaa\".\n    # This run contributes substrings: 'a', 'aa', 'aaa', 'aaaa', 'aaaaa'.\n\n    # If we have another run of 'a's of length 3: \"aaa\".\n    # This run contributes substrings: 'a', 'aa', 'aaa'.\n\n    # The crucial part is \"two substrings that are equal as strings are not distinguished even if they are obtained differently.\"\n    # This means we are counting unique string values.\n\n    # Let's iterate through the string and identify consecutive runs.\n    # For each character, we need to know the maximum length of a consecutive run it forms.\n    # For a character 'c', if its longest consecutive run is of length `L`, then the substrings of the form `c*k`\n    # that *could* potentially exist are `c`, `cc`, ..., `c*L`.\n    # We are interested in which of these actually appear as substrings in S.\n\n    # Consider Sample 1: S = \"aaabaa\", N = 6\n    # Run 1: \"aaa\" (char 'a', length 3)\n    # Run 2: \"b\"   (char 'b', length 1)\n    # Run 3: \"aa\"  (char 'a', length 2)\n\n    # For 'a':\n    # The runs suggest we might have 'a', 'aa', 'aaa' (from \"aaa\"), and 'a', 'aa' (from \"aa\"). Unique are 'a', 'aa', 'aaa'.\n    # For 'b':\n    # The runs suggest we might have 'b' (from \"b\"). Unique is 'b'.\n\n    # Total unique strings: 'a', 'aa', 'aaa', 'b'. Count is 4.\n\n    # This implies that for each character, we are interested in the maximum length of a consecutive block of that character.\n    # If for character 'c', the maximum consecutive length found anywhere in `S` is `max_len_c`, then the substrings\n    # `c`, `cc`, ..., `c` repeated `max_len_c` times, are potentially present.\n    # And crucially, they *are* present.\n\n    # Let's try to find the maximum consecutive lengths for each character.\n    max_consecutive_for_char = {} # Stores char -> max_length\n\n    if N == 0:\n        print(0)\n        return\n\n    i = 0\n    while i < N:\n        current_char = S[i]\n        count = 0\n        j = i\n        while j < N and S[j] == current_char:\n            count += 1\n            j += 1\n\n        # Update max consecutive count for current_char\n        if current_char not in max_consecutive_for_char:\n            max_consecutive_for_char[current_char] = 0\n        max_consecutive_for_char[current_char] = max(max_consecutive_for_char[current_char], count)\n\n        i = j # Move to the start of the next block\n\n    # The total number of unique non-empty substrings that are repetitions of one character\n    # is the sum of the maximum consecutive lengths for each character.\n    total_count = 0\n    for char in max_consecutive_for_char:\n        total_count += max_consecutive_for_char[char]\n\n    print(total_count)\n\n\ndef main():\n    solve_optimized()\n\nif __name__ == \"__main__\":\n    main()\n```",
