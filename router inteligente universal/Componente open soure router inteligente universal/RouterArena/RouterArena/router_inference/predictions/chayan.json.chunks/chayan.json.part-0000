x = {y: i for i, y in enumerate(all_y_values)}\n            num_unique_y = len(all_y_values)\n\n            # Step 3: Use a segment tree (or Fenwick tree) to store maximum sums for y-ranges.\n            # The segment tree will support point updates (adding a sum for a specific y)\n            # and range maximum queries (max sum for y >= query_y).\n            \n            # Segment Tree Implementation:\n            # Nodes store the maximum sum in their range.\n            tree = [-1] * (4 * num_unique_y)\n\n            def update_segment_tree(idx, val, node, start, end):\n                if start == end:\n                    tree[node] = max(tree[node], val)\n                else:\n                    mid = (start + end) // 2\n                    if start <= idx <= mid:\n                        update_segment_tree(idx, val, 2 * node, start, mid)\n                    else:\n                        update_segment_tree(idx, val, 2 * node + 1, mid + 1, end)\n                    tree[node] = max(tree[2 * node], tree[2 * node + 1])\n\n            def query_segment_tree(l, r, node, start, end):\n                if r < start or end < l:\n                    return -1\n                if l <= start and end <= r:\n                    return tree[node]\n                \n                mid = (start + end) // 2\n                p1 = query_segment_tree(l, r, 2 * node, start, mid)\n                p2 = query_segment_tree(l, r, 2 * node + 1, mid + 1, end)\n                return max(p1, p2)\n\n            # Step 4: Iterate through sorted combined list.\n            for x_val, y_val, third_val, item_type in combined_points_and_queries:\n                if item_type == 'data':\n                    # It's a data point (nums1[j], nums2[j], sum)\n                    y_idx = y_to_idx[y_val]\n                    s = third_val # This is the sum nums1[j] + nums2[j]\n                    update_segment_tree(y_idx, s, 1, 0, num_unique_y - 1)\n                else:\n                    # 