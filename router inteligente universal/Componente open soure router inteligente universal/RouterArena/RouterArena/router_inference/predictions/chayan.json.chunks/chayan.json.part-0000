l\" is time 0 relative to reaching N.\n\n    # Priority queue stores `(negative_latest_arrival_at_N_from_station, station_id)`.\n    # We use negative because `heapq` is a min-heap, and we want to extract maximums.\n    pq = [(-f_values[N], N)]\n\n    while pq:\n        neg_current_f_u, u = heapq.heappop(pq)\n        current_f_u = -neg_current_f_u\n\n        # If we've already found a better (later) arrival time at N from station `u`, skip.\n        if current_f_u < f_values[u]:\n            continue\n\n        # Now, we consider all trains that ARRIVE at station `u`.\n        # For each such train:\n        # It departs from `prev_station` at `depart_time_at_prev` and arrives at `u` at `arrival_time_at_u`.\n        # Since we know the latest arrival at N from `u` is `current_f_u`,\n        # a potential latest arrival at N from `prev_station` via this train is `arrival_time_at_u + current_f_u`.\n        # This is because if we depart `prev_station` at `depart_time_at_prev` and arrive at `u` at `arrival_time_at_u`,\n        # we can then utilize the path from `u` that reaches N by `current_f_u`.\n        # The total time to reach N from `prev_station` in this case is `arrival_time_at_u + current_f_u`.\n\n        # We need to ensure that `current_f_u` is a valid arrival time (not -inf).\n        if current_f_u == -float('inf'):\n            continue\n\n        # Iterate through trains arriving at station `u`.\n        # For a specific train in `train_routes[u]`: `(depart_time_from_prev, arrival_time_at_u, prev_station, duration)`\n        # Note: `train_routes[u]` stores trains arriving *at* `u`. So `u` is the `B` for these trains.\n        # The actual departure station for this train is `prev_station`.\n        # The arrival time at `u` is `arrival_time_at_u`.\n\n        for depart_time_from_prev, arrival_time_at_u, prev_station, duration in train_routes[u]:\n            # The latest arrival at N from `prev_station` through this specific train segment\n            