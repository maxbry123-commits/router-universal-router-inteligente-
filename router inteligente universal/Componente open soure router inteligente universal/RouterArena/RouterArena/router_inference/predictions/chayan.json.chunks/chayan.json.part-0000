u)\n                subtree_C_sum[u] += subtree_C_sum[v]\n\n    dfs_subtree_c_sum(1, 0)\n\n    # Now use DFS to propagate f values\n    # Transition: f(v) = f(u) - subtree_C_sum[v] + (sum(C_i) - subtree_C_sum[v])\n    # where v is a child of u.\n    # f(v) = f(u) - subtree_C_sum[v] + (total_C_sum - subtree_C_sum[v])\n    # f(v) = f(u) + (total_C_sum - 2 * subtree_C_sum[v])\n    \n    total_C_sum = sum(C)\n\n    def dfs_propagate_f(u, p):\n        for v in adj[u]:\n            if v != p:\n                f_val[v] = f_val[u] + (total_C_sum - 2 * subtree_C_sum[v])\n                dfs_propagate_f(v, u)\n\n    dfs_propagate_f(1, 0)\n\n    print(min(f_val[1:]))\n\n\nsolve()\n```",
