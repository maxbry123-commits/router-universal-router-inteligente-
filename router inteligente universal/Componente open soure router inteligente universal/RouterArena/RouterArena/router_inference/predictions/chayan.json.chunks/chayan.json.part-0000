.count('#')\n        if count == min_non_zero_row_count:\n            missing_row = r_idx + 1\n            break\n\n    # Now find the column in this `missing_row`.\n    # Iterate through the columns of `missing_row - 1`.\n    # The character will be '.' at the location of the eaten cookie.\n    missing_col = -1\n    for c_idx in range(W):\n        if grid[missing_row - 1][c_idx] == '.':\n            missing_col = c_idx + 1\n            break\n\n    print(missing_row, missing_col)\n\nsolve()\n```",
