s * total_black_in_full_pattern\n\n                # 2. Sum from remaining columns in full row blocks\n                # These are rows `i` from `0` to `r_blocks * N - 1`.\n                # Columns `j` from `c_blocks * N` to `C`.\n                # For `j` in this range, `j % N` is in `[0, c_rem]`.\n                # For rows `i` in `[0, r_blocks * N - 1]`: `i % N` cycles through `0..N-1` repeatedly.\n                # The number of times a row `r_mod` appears is `r_blocks`.\n                for r_mod in range(N):\n                    count += r_blocks * get_black_in_rect_pattern(r_mod, 0, r_mod, c_rem)\n\n                # 3. Sum from remaining rows in full column blocks\n                # These are rows `i` from `r_blocks * N` to `R`.\n                # Columns `j` from `0` to `c_blocks * N - 1`.\n                # For `i` in this range, `i % N` is in `[0, r_rem]`.\n                # For columns `j` in `[0, c_blocks * N - 1]`: `j % N` cycles through `0..N-1` repeatedly.\n                # The number of times a column `c_mod` appears is `c_blocks`.\n                for c_mod in range(N):\n                    count += c_blocks * get_black_in_rect_pattern(0, c_mod, r_rem, c_mod)\n\n                # 4. Sum from the bottom-right partial block\n                # Rows `i` from `r_blocks * N` to `R` (i.e., `i % N` from `0` to `r_rem`).\n                # Columns `j` from `c_blocks * N` to `C` (i.e., `j % N` from `0` to `c_rem`).\n                count += get_black_in_rect_pattern(0, 0, r_rem, c_rem)\n\n                return count\n\n        # The final answer for a query (A, B, C, D)\n        return (\n            count_black_up_to(C, D)\n            - count_black_up_to(A - 1, D)\n            - count_black_up_to(C, B - 1)\n            + count_black_up_to(A - 1, B - 1)\n        )\n\n    for _ in range(Q):\n        A, B, C, D = map(int, sys.stdin.readline().split())\n        print(solve_query(A, B, C, D))\n\ndef solve_query(A, B, C, D):\n    \"\"\"\n    This function is defined here to have access to N, P, prefix_sum_pattern,\n    total_black_in_full_pattern, and get_black_in_rect_pattern.\n    It's a bit of a workaround to avoid passing all these as arguments repeatedly.\n    \"\"\"\n    N = globals()[\"N\"]\n    P = globals()[\"P\"]\n    prefix_sum_pattern = globals()[\"prefix_sum_pattern\"]\n    total_black_in_full_pattern = globals()[\"total_black_in_full_pattern\"]\n\n    def get_black_in_rect_pattern(r1, c1, r2, c2):\n        \"\"\"Gets black squares in a rectangle within the N x N pattern.\"\"\"\n        if r1 > r2 or c1 > c2:\n            return 0\n        return (\n            prefix_sum_pattern[r2 + 1][c2 + 1]\n            - prefix_sum_pattern[r1][c2 + 1]\n            - prefix_sum_pattern[r2 + 1][c1]\n            + prefix_sum_pattern[r1][c1]\n        )\n\n    def count_black_up_to(R, C):\n        if R < 0 or C < 0:\n            return 0\n\n        r_blocks = (R + 1) // N\n        c_blocks = (C + 1) // N\n        r_rem = R % N\n        c_rem = C % N\n\n        # 1. Sum from full N x N blocks\n        count = r_blocks * c_blocks * total_black_in_full_pattern\n\n        # 2. Sum from remaining columns in full row blocks\n        # Rows `i` from `0` to `r_blocks * N - 1`.\n        # Columns `j` from `c_blocks * N` to `C`.\n        # The pattern cells involved are `P[i % N][j % N]`.\n        # For the rows, `i % N` will cycle through `0..N-1`, each appearing `r_blocks` times.\n        # For the columns, `j % N` will be in `[0, c_rem]`.\n        # So, for each `r_mod` in `[0, N-1]`, we sum black cells in `P[r_mod][0..c_rem]`.\n        # Contribution for this part = `r_blocks * sum(get_black_in_rect_pattern(r_mod, 0, r_mod, c_rem) for r_mod in range(N))`.\n        # This is equivalent to summing black cells in pattern rows from 0 to N-1, for columns 0 to c_rem.\n        # We can optimize this by precalculating sum of black cells in pattern rows.\n        # Or more directly using `get_black_in_rect_pattern`.\n        sum_partial_cols_in_full_rows = 0\n        for r_mod in range(N):\n            sum_partial_cols_in_full_rows += get_black_in_rect_pattern(r_mod, 0, r_mod, c_rem)\n        count += r_blocks * sum_partial_cols_in_full_rows\n\n        # 3. Sum from remaining rows in full column blocks\n        # Rows `i` from `r_blocks * N` to `R`.\n        # Columns `j` from `0` to `c_blocks * N - 1`.\n        # For the rows, `i % N` will be in `[0, r_rem]`.\n        # For the columns, `j % N` will cycle through `0..N-1`, each appearing `c_blocks` times.\n        # Contribution for this part = `c_blocks * sum(get_black_in_rect_pattern(0, c_mod, r_rem, c_mod) for c_mod in range(N))`.\n        sum_partial_rows_in_full_cols = 0\n        for c_mod in range(N):\n            sum_partial_rows_in_full_cols += get_black_in_rect_pattern(0, c_mod, r_rem, c_mod)\n        count += c_blocks * sum_partial_rows_in_full_cols\n\n        # 4. Sum from the bottom-right partial block\n        # Rows `i` from `r_blocks * N` to `R` (i.e., `i % N` from `0` to `r_rem`).\n        # Columns `j` from `c_blocks * N` to `C` (i.e., `j % N` from `0` to `c_rem`).\n        count += get_black_in_rect_pattern(0, 0, r_rem, c_rem)\n\n        return count\n\n    return (\n        count_black_up_to(C, D)\n        - count_black_up_to(A - 1, D)\n        - count_black_up_to(C, B - 1)\n        + count_black_up_to(A - 1, B - 1)\n    )\n\n\ndef main():\n    N, Q = map(int, sys.stdin.readline().split())\n    P = [sys.stdin.readline().strip() for _ in range(N)]\n\n    # Store N and P in global scope for solve_query to access\n    globals()[\"N\"] = N\n    globals()[\"P\"] = P\n\n    # Precompute the number of black squares in a pattern block of size N x N\n    black_count_in_pattern = [[0] * N for _ in range(N)]\n    for r in range(N):\n        for c in range(N):\n            black_count_in_pattern[r][c] = (P[r][c] == 'B')\n\n    # Precompute the 2D prefix sum of black squares within the N x N pattern\n    prefix_sum_pattern = [[0] * (N + 1) for _ in range(N + 1)]\n    for r in range(N):\n        for c in range(N):\n            prefix_sum_pattern[r + 1][c + 1] = (\n                prefix_sum_pattern[r][c + 1]\n                + prefix_sum_pattern[r + 1][c]\n                - prefix_sum_pattern[r][c]\n                + black_count_in_pattern[r][c]\n            )\n\n    # Total black squares in the N x N pattern\n    total_black_in_full_pattern = prefix_sum_pattern[N][N]\n\n    # Store precomputed values in global scope\n    globals()[\"prefix_sum_pattern\"] = prefix_sum_pattern\n    globals()[\"total_black_in_full_pattern\"] = total_black_in_full_pattern\n\n    for _ in range(Q):\n        A, B, C, D = map(int, sys.stdin.readline().split())\n        print(solve_query(A, B, C, D))\n\nmain()\n```",
