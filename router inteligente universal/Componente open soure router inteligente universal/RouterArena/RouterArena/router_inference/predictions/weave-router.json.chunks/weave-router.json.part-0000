se intersections will depend on shifts\n                    # We need I2 = sum of volumes of exactly-two overlaps\n                    \n                    # For simplicity, align cubes along axes\n                    # Cube1 at (0,0,0), Cube2 at (7-dx, 0, 0), Cube3 at (0, 7-dy, 0)\n                    # Then:\n                    # |C1∩C2| = dx*7*7\n                    # |C1∩C3| = 7*dy*7\n                    # |C2∩C3| = dx*dy*7 (if they overlap)\n                    # |C1∩C2∩C3| = dx*dy*7? No, dx*dy*dz\n                    \n                    # Try placing Cube2 at (7-dx, 0, 0) and Cube3 at (0, 7-dy, 0)\n                    # Then triple overlap is dx*dy*7, but we need dx*dy*dz\n                    \n                    # Let's try: Cube1 (0,0,0), Cube2 (7-dx, 0, 0), Cube3 (0, 7-dy, 7-dz)\n                    # |C1∩C2| = dx*7*7\n                    # |C1∩C3| = 7*dy*dz\n                    # |C2∩C3| = dx*dy*dz (if overlapping in x and y, z aligned? No)\n                    \n                    # General approach: try small offsets\n                    for a2 in range(-7, 8):\n                        for b2 in range(-7, 8):\n                            for c2 in range(-7, 8):\n                                for a3 in range(-7, 8):\n                                    for b3 in range(-7, 8):\n                                        for c3 in range(-7, 8):\n                                            # Cube1 at (0,0,0)\n                                            x1_min, x1_max = 0, 7\n                                            y1_min, y1_max = 0, 7\n                                            z1_min, z1_max = 0, 7\n                                            \n                                            x2_min, x2_max = a2, a2+7\n                                            y2_min, y2_max = b2, b2+7\n                                            z2_min, z2_max = c2, c2+7\n                                            \n                                            x3_min, x3_max = a3, a3+7\n                                            y3_min, y3_max = b3, b3+7\n                                            z3_min, z3_max = c3, c3+7\n                                            \n                                            def intersection_volume(c1_min, c1_max, c2_min, c2_max):\n                                                return max(0, min(c1_max, c2_max) - max(c1_min, c2_min))\n                                            \n                                            dx12 = intersection_volume(x1_min, x1_max, x2_min, x2_max)\n                                            dy12 = intersection_volume(y1_min, y1_max, y2_min, y2_max)\n                                            dz12 = intersection_volume(z1_min, z1_max, z2_min, z2_max)\n                                            v12 = dx12 * dy12 * dz12\n                                            \n                                            dx13 = intersection_volume(x1_min, x1_max, x3_min, x3_max)\n                                            dy13 = intersection_volume(y1_min, y1_max, y3_min, y3_max)\n                                            dz13 = intersection_volume(z1_min, z1_max, z3_min, z3_max)\n                                            v13 = dx13 * dy13 * dz13\n                                            \n                                            dx23 = intersection_volume(x2_min, x2_max, x3_min, x3_max)\n                                            dy23 = intersection_volume(y2_min, y2_max, y3_min, y3_max)\n                                            dz23 = intersection_volume(z2_min, z2_max, z3_min, z3_max)\n                                            v23 = dx23 * dy23 * dz23\n                                            \n                                            # Triple intersection\n                                            x_trip_min = max(x1_min, x2_min, x3_min)\n                                            x_trip_max = min(x1_max, x2_max, x3_max)\n                                            y_trip_min = max(y1_min, y2_min, y3_min)\n                                            y_trip_max = min(y1_max, y2_max, y3_max)\n                                            z_trip_min = max(z1_min, z2_min, z3_min)\n                                            z_trip_max = min(z1_max, z2_max, z3_max)\n                                            \n                                            if x_trip_min < x_trip_max and y_trip_min < y_trip_max and z_trip_min < z_trip_max:\n                                                v123 = (x_trip_max - x_trip_min) * (y_trip_max - y_trip_min) * (z_trip_max - z_trip_min)\n                                            else:\n                                                v123 = 0\n                                            \n                                            if v123 != V3:\n                                                continue\n                                            \n                                            # Volume in exactly two = sum(pairwise) - 3*V3\n                                            if (v12 + v13 + v23 - 3*v123) != V2:\n                                                continue\n                                            \n                                            # Total volume covered = sum singletons - sum pairwise + V3\n                                            v_total = (343*3) - (v12+v13+v23) + v123\n                                            \n                                            # Volume in exactly one\n                                            if (v_total - V2 - V3) != V1:\n                                                continue\n                                            \n                                            # Found a solution\n                                            print(\"Yes\")\n                                            print(f\"0 0 0 {a2} {b2} {c2} {a3} {b3} {c3}\")\n                                            return\n    