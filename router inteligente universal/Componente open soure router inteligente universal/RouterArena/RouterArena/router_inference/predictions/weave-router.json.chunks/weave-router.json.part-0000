      "generated_answer": "```python\nimport sys\nfrom collections import defaultdict\n\ndef solve():\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    H = int(next(it))\n    W = int(next(it))\n    M = int(next(it))\n    \n    ops = []\n    for _ in range(M):\n        T = int(next(it))\n        A = int(next(it))\n        X = int(next(it))\n        ops.append((T, A, X))\n        \n    used_rows = set()\n    used_cols = set()\n    color_count = defaultdict(int)\n    \n    for T, A, X in reversed(ops):\n        if T == 1:\n            if A not in used_rows:\n                used_rows.add(A)\n                cells = W - len(used_cols)\n                if cells > 0:\n                    color_count[X] += cells\n        else:\n            if A not in used_cols:\n                used_cols.add(A)\n                cells = H - len(used_rows)\n                if cells > 0:\n                    color_count[X] += cells\n                    \n    total_painted = sum(color_count.values())\n    remaining = H * W - total_painted\n    if remaining > 0:\n        color_count[0] += remaining\n        \n    positive_colors = sorted(c for c, cnt in color_count.items() if cnt > 0)\n    out = [str(len(positive_colors))]\n    for c in positive_colors:\n        out.append(f\"{c} {color_count[c]}\")\n    sys.stdout.write(\"\\n\".join(out))\n```",
