      "generated_answer": "Here’s a Python function that solves the problem using dynamic programming and value iteration:\n\n```python\ndef solve_roulette():\n    import sys\n    input = sys.stdin.read\n    data = input().split()\n    idx = 0\n    \n    N = int(data[idx]); idx += 1\n    M = int(data[idx]); idx += 1\n    \n    costs = []\n    probs = []\n    \n    for _ in range(N):\n        C = int(data[idx]); idx += 1\n        P = int(data[idx]); idx += 1\n        scores = []\n        for _ in range(P):\n            scores.append(int(data[idx])); idx += 1\n        \n        costs.append(C)\n        prob_dist = {}\n        for s in scores:\n            prob_dist[s] = prob_dist.get(s, 0) + 1.0 / P\n        probs.append(prob_dist)\n    \n    dp = [0.0] * (M + 1)\n    \n    for _ in range(2000):\n        for pts in range(M):\n            best = float('inf')\n            for i in range(N):\n                exp_cost = costs[i]\n                prob_sum = 0.0\n                for s, p in probs[i].items():\n                    nxt = min(M, pts + s)\n                    if nxt == M:\n                        pass\n                    else:\n                        exp_cost += p * dp[nxt]\n                if exp_cost < best:\n                    best = exp_cost\n            dp[pts] = best\n        dp[M] = 0.0\n    \n    return dp[0]\n```",
