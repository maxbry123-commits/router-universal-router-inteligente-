ms.length <= 10^4\n1 <= nums[i] <= 10^9",
    "prediction": "deepseek/deepseek-v4-pro",
    "generated_result": {
      "generated_answer": "```python\nfrom typing import List\n\ndef maximum_element_sum(nums: List[int]) -> int:\n    \"\"\"\n    Returns the maximum element-sum of a complete subset of indices.\n    A subset of indices is complete if the product of every pair of its\n    indices is a perfect square.\n    \"\"\"\n    n = len(nums)\n    group_sum = {}\n    \n    for i in range(1, n + 1):\n        x = i\n        # Compute square-free part of x\n        sf = 1\n        d = 2\n        while d * d <= x:\n            cnt = 0\n            while x % d == 0:\n                x //= d\n                cnt += 1\n            if cnt % 2 == 1:\n                sf *= d\n            d += 1\n        if x > 1:\n            sf *= x\n            \n        # Add the corresponding array value to the group of this square-free part\n        group_sum[sf] = group_sum.get(sf, 0) + nums[i - 1]\n        \n    return max(group_sum.values())\n```",
