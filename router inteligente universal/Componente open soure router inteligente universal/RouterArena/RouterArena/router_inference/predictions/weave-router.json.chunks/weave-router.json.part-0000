      "generated_answer": "```python\nimport sys\n\ndef solve() -> None:\n    data = sys.stdin.buffer.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    deg = [0] * (n + 1)\n    idx = 1\n    for _ in range(n - 1):\n        u = int(data[idx])\n        v = int(data[idx + 1])\n        deg[u] += 1\n        deg[v] += 1\n        idx += 2\n\n    m2 = 0          # number of stars with level >= 3\n    s = 0           # sum of levels of those stars\n    for v in range(1, n + 1):\n        d = deg[v]\n        if d >= 3:\n            m2 += 1\n            s += d\n\n    m1 = (n - m2 - s) // 3   # number of level-2 stars\n\n    ans = []\n    for v in range(1, n + 1):\n        d = deg[v]\n        if d >= 3:\n            ans.append(d)\n    ans.extend([2] * m1)\n    ans.sort()\n    sys.stdout.write(' '.join(map(str, ans)))\n\nif __name__ == \"__main__\":\n    solve()\n```",
