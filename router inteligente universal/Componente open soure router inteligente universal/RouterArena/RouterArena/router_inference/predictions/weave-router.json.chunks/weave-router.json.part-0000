      "generated_answer": "```python\ndef solve() -> None:\n    import sys\n\n    input = sys.stdin.readline\n    N, M = map(int, input().split())\n\n    adj = [[] for _ in range(N + 1)]\n    max_ratio = 0.0\n    for _ in range(M):\n        u, v, b, c = map(int, input().split())\n        adj[u].append((v, b, c))\n        if c > 0:\n            ratio = b / c\n            if ratio > max_ratio:\n                max_ratio = ratio\n\n    def check(x: float) -> bool:\n        dist = [-float('inf')] * (N + 1)\n        dist[1] = 0.0\n        for u in range(1, N + 1):\n            du = dist[u]\n            if du == -float('inf'):\n                continue\n            for v, b, c in adj[u]:\n                w = b - x * c\n                nd = du + w\n                if nd > dist[v]:\n                    dist[v] = nd\n        return dist[N] >= 0.0\n\n    lo = 0.0\n    hi = max_ratio\n    # 60 iterations are enough for 1e-9 precision\n    for _ in range(60):\n        mid = (lo + hi) * 0.5\n        if check(mid):\n            lo = mid\n        else:\n            hi = mid\n\n    print(f\"{lo:.15f}\")\n```",
