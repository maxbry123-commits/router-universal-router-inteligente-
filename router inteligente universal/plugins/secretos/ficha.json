{
  "plugin_host": {
    "schema": "plugin_host/v1",
    "id": "secretos",
    "enabled_default": true,
    "health_action": "status",
    "nota_roja": "Secretos del chat: valores cifrados (AES-GCM, llave scrypt de FICHA_CLAVE_BANCO, mismo formato FICHA-SELLO-1 del banco unico). Solo SQLite de memoria + espejo cifrado en el bucket. Ninguna accion HTTP devuelve el valor en claro; los plugins lo leen por nombre con obtener()."
  },
  "artifact_id": "riu.plugins.secretos",
  "version": "0.1.0",
  "estado": "testing",
  "categoria": "transversal",
  "etapa": "T",
  "contrato": {
    "rol": "service"
  },
  "ejecucion": {
    "kind": "api",
    "transport": "importlib",
    "runtime_type": "compute",
    "entry_point": "plugins.secretos.plugin:handle",
    "idempotente": true,
    "allowed_actions": [
      "status",
      "listar",
      "guardar",
      "borrar",
      "restaurar",
      "mcp_token_nuevo"
    ]
