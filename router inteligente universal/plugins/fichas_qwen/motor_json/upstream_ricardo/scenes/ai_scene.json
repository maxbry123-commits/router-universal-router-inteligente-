{
  "meta": {
    "title": "AI Neural Core",
    "description": "Glowing neural-network wall with a floating emissive core, halo rings, data streams and orbs over a dark reflective floor. Cyan/magenta lighting, fog-glow bloom, DoF on the core.",
    "blender_target": "5.2 (EEVEE)"
  },
  "ops": [
    { "op": "new_scene" },

    { "op": "set_world", "color": [0.01, 0.012, 0.03], "strength": 0.5 },

    { "op": "add_material", "name": "NN_Node",   "color": [0.04, 0.5, 0.9],   "emission_color": [0.1, 0.85, 1.0],  "emission_strength": 5,  "roughness": 0.35 },
    { "op": "add_material", "name": "NN_Link",   "color": [0.02, 0.25, 0.45], "emission_color": [0.05, 0.5, 0.85],  "emission_strength": 1.5, "roughness": 0.5 },
    { "op": "add_material", "name": "Core_Glow", "color": [0.1, 0.8, 1.0],    "emission_color": [0.25, 0.9, 1.0],   "emission_strength": 6,  "roughness": 0.2 },
    { "op": "add_material", "name": "Stream",    "color": [0.1, 0.7, 1.0],    "emission_color": [0.3, 0.95, 1.0],   "emission_strength": 4,  "roughness": 0.3 },
    { "op": "add_material", "name": "Orb",       "color": [0.8, 1.0, 1.0],    "emission_color": [0.85, 1.0, 1.0],   "emission_strength": 9,  "roughness": 0.2 },
    { "op": "add_material", "name": "Halo_Metal","color": [0.75, 0.8, 0.9],   "metallic": 1.0, "roughness": 0.25 },
    { "op": "add_material", "name": "Floor_Dark","color": [0.015, 0.02, 0.04],"metallic": 0.7, "roughness": 0.25 },

    { "op": "neural_net", "layers": [3, 5, 7, 5, 3], "gap": 1.6, "radius": 0.17,
      "link_radius": 0.02, "node_material": "NN_Node", "link_material": "NN_Link",
      "base_name": "NN", "full": true },

    { "op": "exec", "code": "from mathutils import Matrix\nR = Matrix.Rotation(math.radians(90), 4, 'X')\nq = R.to_quaternion()\nfor o in bpy.data.objects:\n    if o.name.startswith('NN_') or o.name.lower().startswith('link'):\n        o.location = R @ o.location\n        o.location.x -= 3.2\n        if o.rotation_mode == 'QUATERNION':\n            o.rotation_quaternion = q @ o.rotation_quaternion" },

    { "op": "add_mesh", "kind": "ico_sphere", "name": "Core", "location": [0, -1.8, -1.8],
      "subdivisions": 3, "radius": 0.9, "material": "Core_Glow", "smooth": true },

    { "op": "add_mesh", "kind": "torus", "name": "HaloInner", "location": [0, -1.8, -1.8],
      "rotation": [65, 0, 30], "major_radius": 1.4, "minor_radius": 0.045,
      "major_segments": 96, "minor_segments": 12, "material": "Halo_Metal", "smooth": true },

    { "op": "add_mesh", "kind": "torus", "name": "HaloOuter", "location": [0, -1.8, -1.8],
      "rotation": [15, 70, -35], "major_radius": 1.9, "minor_radius": 0.03,
      "major_segments": 96, "minor_segments": 12, "material": "Halo_Metal", "smooth": true },

    { "op": "connect", "a": [0, -1.8, -1.8], "b": [-3.2, 0, 0],     "radius": 0.035, "material": "Stream", "segments": 4 },
    { "op": "connect", "a": [0, -1.8, -1.8], "b": [-3.2, 0, -0.6],  "radius": 0.035, "material": "Stream", "segments": 4 },
    { "op": "connect", "a": [0, -1.8, -1.8], "b": [-3.2, 0, -1.2],  "radius": 0.035, "material": "Stream", "segments": 4 },
    { "op": "connect", "a": [0, -1.8, -1.8], "b": [3.2, 0, 0],      "radius": 0.035, "material": "Stream", "segments": 4 },
    { "op": "connect", "a": [0, -1.8, -1.8], "b": [3.2, 0, -0.6],   "radius": 0.035, "material": "Stream", "segments": 4 },
    { "op": "connect", "a": [0, -1.8, -1.8], "b": [3.2, 0, -1.2],   "radius": 0.035, "material": "Stream", "segments": 4 },

    { "op": "add_mesh", "kind": "uv_sphere", "name": "Orb_A", "location": [-1.6, -0.9, -0.9], "segments": 24, "ring_count": 16, "radius": 0.11, "material": "Orb", "smooth": true },
    { "op": "add_mesh", "kind": "uv_sphere", "name": "Orb_B", "location": [1.6, -0.9, -0.9],  "segments": 24, "ring_count": 16, "radius": 0.11, "material": "Orb", "smooth": true },
    { "op": "add_mesh", "kind": "uv_sphere", "name": "Orb_C", "location": [-1.6, -0.9, -1.5], "segments": 24, "ring_count": 16, "radius": 0.11, "material": "Orb", "smooth": true },
    { "op": "add_mesh", "kind": "uv_sphere", "name": "Orb_D", "location": [1.6, -0.9, -1.5],  "segments": 24, "ring_count": 16, "radius": 0.11, "material": "Orb", "smooth": true },

    { "op": "add_mesh", "kind": "plane", "name": "Floor", "location": [0, 0, -3.9], "size": 40, "material": "Floor_Dark" },

    { "op": "add_light", "kind": "point", "name": "CoreLight",   "location": [0, -1.8, -1.8], "energy": 80,  "color": [0.4, 0.9, 1.0], "radius": 1.0 },
    { "op": "add_light", "kind": "point", "name": "RimMagenta",  "location": [0, 3.0, -1.8],  "energy": 600, "color": [1.0, 0.25, 0.6], "radius": 1.5 },
    { "op": "add_light", "kind": "sun",   "name": "KeySun",      "rotation": [35, 0, -25],    "energy": 2.5, "color": [0.85, 0.9, 1.0] },

    { "op": "add_camera", "name": "Cam", "location": [0, -10.5, 1.4], "lens": 50,
      "dof": { "focus_object": "Core", "fstop": 5.6 } },
    { "op": "track_to", "object": "Cam", "location": [0, 0, -1.7] },

    { "op": "exec", "code": "s = bpy.context.scene\ns.render.use_compositing = True\nbpy.ops.node.new_compositing_node_group()\nnt = [g for g in bpy.data.node_groups if g.bl_idname == 'CompositorNodeTree'][-1]\nrl = next(n for n in nt.nodes if n.bl_idname == 'CompositorNodeRLayers')\nout_n = next(n for n in nt.nodes if n.bl_idname == 'NodeGroupOutput')\nviewer = next((n for n in nt.nodes if n.bl_idname == 'CompositorNodeViewer'), None)\nrr = next((n for n in nt.nodes if n.bl_idname == 'NodeReroute'), None)\nif rr is not None:\n    nt.nodes.remove(rr)\ngl = nt.nodes.new('CompositorNodeGlare')\ngl.inputs['Type'].default_value = 'Fog Glow'\ngl.inputs['Threshold'].default_value = 0.4\ngl.inputs['Strength'].default_value = 5.0\nnt.links.new(rl.outputs['Image'], gl.inputs['Image'])\nnt.links.new(gl.outputs['Image'], out_n.inputs['Image'])\nif viewer is not None:\n    nt.links.new(gl.outputs['Image'], viewer.inputs['Image'])\ns.compositing_node_group = nt" },

    { "op": "set_render", "engine": "BLENDER_EEVEE", "width": 1600, "height": 900, "scale": 1.0 },

    { "op": "render", "path": "${PROJECT_ROOT}/output/ai_scene.png", "format": "PNG", "color_mode": "RGBA" },
    { "op": "save", "path": "${PROJECT_ROOT}/output/ai_scene.blend" }
  ]
}
