{
 "registry_version": "1.0.0",
 "language": "es",
 "extends_contract": "loop_contract.example.v1_1.json",
 "selector": {
  "precedence": [
   "button_lock",
   "slash_command",
   "auto_classifier",
   "default_mode"
  ],
  "default_mode": "m05_respuesta_rapida",
  "on_unknown_mode": "REJECT",
  "gate": {
   "trigger_words": [
    "INICIA",
    "RUN",
    "IMPUTA"
   ],
   "satisfied_by": [
    "button_lock",
    "slash_command",
    "trigger_word"
   ]
  },
  "ui_thinking_toggle_policy": "mode_wins",
  "auto_slash": "/auto"
 },
 "ui": {
  "button": {
   "label": "Modo",
   "position": "composer_left",
   "menu_style": "bottom_sheet",
   "include_auto_option": true,
   "show_active_chip": true,
   "persist": "per_conversation"
  },
  "menu_order": [
   "m01_plan",
   "m02_objetivo",
   "m03_investigacion",
   "m04_agentico_loop",
   "m05_respuesta_rapida",
   "m06_orquestador_pool",
   "m07_tool",
   "m08_auto_evolucion",
   "m09_mythos",
   "m10_agenda",
   "m11_max_paralelo"
  ]
 },
 "hard_limit_caps": {
  "max_iterations": 1000,
  "max_wall_clock_s": 86400,
  "max_cost_usd": 300,
  "max_consecutive_no_progress": 30,
  "max_tokens_per_turn": 64000,
  "max_running": 10,
  "max_cycle_repeats": 10
 },
 "immutable_sections": [
  "selector.gate",
  "selector.on_unknown_mode",
  "hard_limit_caps",
  "self_modification",
  "immutable_sections"
 ],
 "self_modification": {
  "branch_prefix": "self-evolve/",
  "merge_policy": "pr_only",
  "require_tests_green": true,
  "max_files_changed_per_cycle": 10,
  "protected_paths": [
   ".env",
   "secrets/",
   ".git/"
  ],
  "targets": {
   "router_ficha": "router inteligente universal/plugins/fichas_qwen/modos/modes_registry.json",
   "backend": [
    "router inteligente universal/plugins/fichas_qwen/",
    "router inteligente universal/plugins/puente_chat/"
   ],
   "frontend": [
    "chat router/chat frontend/"
   ]
  }
 },
 "objective_schema": {
  "required": [
   "goal",
   "done_when",
   "constraints",
   "out_of_scope",
   "deliverables"
  ],
  "list_fields": [
   "done_when",
   "constraints",
   "out_of_scope",
   "deliverables"
  ]
 },
 "autonomy_rules": [
  "Nunca preguntes lo que puedas descubrir leyendo el repo o ejecutando un comando.",
  "Si falta un dato no critico, asume lo razonable, registralo en state/assumptions.md y sigue.",
  "Cada turno termina con una accion: editar, ejecutar o escribir estado; prohibido responder solo con analisis.",
  "Maximo 3 lecturas seguidas sin editar ni ejecutar.",
  "Antes de leer, consulta state/progress.json y no releas lo ya registrado.",
  "Registra en progress.json lo hecho y su evidencia (comando y salida).",
  "Detente solo cuando todas las tareas sean terminales; las aprobaciones de frontend o resultados no bloquean los nodos independientes.",
  "Si la misma accion falla 2 veces, cambia de enfoque."
 ],
 "tools_profiles": {
  "none": [],
  "read_only": [
   "read_file",
   "grep",
   "glob"
  ],
  "research": [
   "read_file",
   "grep",
   "glob",
   "web_search",
   "web_fetch"
  ],
  "code": [
   "read_file",
   "grep",
   "glob",
   "edit_file",
   "bash",
   "web_search",
   "web_fetch"
  ],
  "orchestrate": [
   "read_state",
   "dispatch_task",
   "web_search",
   "web_fetch"
  ],
  "registered_tools": [
   "registered_tools"
  ],
  "self_evolve": [
   "read_file",
   "grep",
   "glob",
   "edit_file",
   "bash",
   "git_branch",
   "git_commit",
   "run_tests",
   "web_search",
   "web_fetch"
  ]
 },
 "step_catalog": [
  {
   "id": "pin_objective",
   "kind": "llm+deterministic",
   "description": "Fija el objetivo en state/objective.md (goal, done_when, constraints, out_of_scope, deliverables) y lo reinyecta en cada iteracion.",
   "evidence": "state/objective.md existe y valida contra objective_schema"
  },
  {
   "id": "gather_context",
   "kind": "tool",
   "description": "Lee repo, estado y archivos relevantes SIN repetir lecturas (cache path+mtime+rango).",
   "evidence": "state/context.md con rutas leidas"
  },
  {
   "id": "read_state",
   "kind": "tool",
   "description": "Carga progress.json, requirements.json y assumptions.md antes de actuar.",
   "evidence": "hash de los archivos de estado en el evento step_passed"
  },
  {
   "id": "research_sources",
   "kind": "tool",
   "description": "Consulta las fuentes de research_sources.json con busqueda y fetch; falla en suave y registra.",
   "evidence": "state/research.md y state/research_failed.md"
  },
  {
   "id": "research_before_step",
   "kind": "tool",
   "description": "Antes de CADA paso, busca en fuentes oficiales y comunidad como resolverlo; registra la fuente usada.",
   "evidence": "entrada nueva en state/research.md con URL por paso"
  },
  {
   "id": "extract_methods",
   "kind": "llm",
   "description": "Extrae metodos, librerias, repos y advertencias de lo investigado.",
   "evidence": "state/methods.json"
  },
  {
   "id": "rank_resources",
   "kind": "deterministic",
   "description": "Ordena recursos por relevancia, actualidad y cobertura del objetivo.",
   "evidence": "state/resources.json con score por recurso"
  },
  {
   "id": "create_resources",
   "kind": "tool",
   "description": "Crea los recursos necesarios (archivos, scripts, fixtures, configuracion).",
   "evidence": "archivos creados listados en progress.json"
  },
  {
   "id": "architecture_design",
   "kind": "llm",
   "description": "Disena arquitectura y decisiones; cada decision con alternativa descartada.",
   "evidence": "state/architecture.md"
  },
  {
   "id": "task_breakdown_dag",
   "kind": "llm+deterministic",
   "description": "Convierte el plan en DAG de tareas con aceptacion verificable por nodo.",
   "evidence": "state/plan.dag.json valida con validate_contract.py"
  },
  {
   "id": "risk_review",
   "kind": "llm",
   "description": "Lista riesgos, supuestos y huecos del plan.",
   "evidence": "state/risks.md"
  },
  {
   "id": "emit_plan",
   "kind": "deterministic",
   "description": "Entrega el plan final en archivos; no ejecuta nada.",
   "evidence": "state/plan.md y state/plan.dag.json"
  },
  {
   "id": "execute_dag_loop",
   "kind": "loop",
   "description": "Ejecuta el DAG en bucle gather-act-verify-repeat hasta que todos los nodos sean terminales.",
   "evidence": "progress.json con todos los nodos en estado terminal y evidencia"
  },
  {
   "id": "run_tests",
   "kind": "tool",
   "description": "Corre pruebas y linters del proyecto.",
   "evidence": "salida y exit code de los comandos de verificacion"
  },
  {
   "id": "verify_frontend",
   "kind": "tool",
   "description": "Verifica el frontend (build y revision visual) y publica punto de revision no bloqueante.",
   "evidence": "captura o salida de build + review_point emitido"
  },
  {
   "id": "final_gate",
   "kind": "deterministic",
   "description": "Compuerta final fail-closed: todo terminal, todo con evidencia, limites no violados.",
   "evidence": "veredicto PASS/FAIL del validador"
  },
  {
   "id": "deliver_report",
   "kind": "deterministic",
   "description": "Entrega resumen con evidencia por entregable.",
   "evidence": "state/report.md"
  },
  {
   "id": "fast_answer",
   "kind": "llm",
   "description": "Responde directo, breve, sin herramientas ni bucle.",
   "evidence": "respuesta enviada"
  },
  {
   "id": "run_tool",
   "kind": "tool",
   "description": "Ejecuta la herramienta pedida con los argumentos dados y devuelve el resultado tal cual.",
   "evidence": "tool_result en el historial del siguiente turno"
  },
  {
   "id": "audit_self",
   "kind": "tool",
   "description": "Revisa ficha de router, backend y frontend del chat y lista gaps contra el registro de modos.",
   "evidence": "state/self_audit.md"
  },
  {
   "id": "detect_gaps",
   "kind": "deterministic",
   "description": "Calcula la lista de gaps abiertos comparando objetivo, requisitos y resultados.",
   "evidence": "state/gaps.json (lista vacia = sin gaps)"
  },
  {
   "id": "apply_fix_branch",
   "kind": "tool",
   "description": "Aplica correcciones SOLO en rama self-evolve/*, cambios aditivos y minimos.",
   "evidence": "commit en rama self-evolve/* con diff acotado"
  },
  {
   "id": "regression_tests",
   "kind": "tool",
   "description": "Corre la bateria completa y el harness_selftest tras cada correccion.",
   "evidence": "exit code 0 de toda la bateria"
  },
  {
   "id": "open_pr",
   "kind": "tool",
   "description": "Abre PR con diff, evidencia de pruebas y lista de gaps cerrados; NO hace merge.",
   "evidence": "URL o archivo del PR"
  },
  {
   "id": "store_verbatim_input",
   "kind": "deterministic",
   "description": "Guarda el input original sin modificar y su hash sha256.",
   "evidence": "state/input_verbatim.md y hash"
  },
  {
   "id": "prioritize_tasks",
   "kind": "llm+deterministic",
   "description": "Asigna prioridad, dependencias y estrategia por tarea.",
   "evidence": "state/agenda.json con prioridad por tarea"
  },
  {
   "id": "cross_verify",
   "kind": "llm+deterministic",
   "description": "Verifica cruzada: cada tarea debe trazarse a un fragmento del input verbatim, y viceversa.",
   "evidence": "state/cross_verify.json sin huecos"
  },
  {
   "id": "build_queues",
   "kind": "deterministic",
   "description": "Crea colas por prioridad y marca tareas paralelizables.",
   "evidence": "state/queues.json"
  },
  {
   "id": "arm_watchdog",
   "kind": "deterministic",
   "description": "Activa vigilancia: latido, deteccion de estancamiento y reintento.",
   "evidence": "evento watchdog_armed"
  },
  {
   "id": "dispatch_parallel",
   "kind": "tool",
   "description": "Despacha tareas a modelos y agentes del registry; hasta max_running en paralelo, el resto en cola.",
   "evidence": "eventos task_started por tarea y peak_running<=cap"
  },
  {
   "id": "merge_results",
   "kind": "deterministic",
   "description": "Integra resultados de workers; ante conflicto rebase y reverifica.",
   "evidence": "commit de integracion y pruebas en verde"
  },
  {
   "id": "verify_traceability",
   "kind": "deterministic",
   "description": "Verifica que cada tarea tenga folio, evento de inicio, evidencia y estado terminal.",
   "evidence": "state/traceability.json sin huecos"
  }
 ],
 "auto_classifier": {
  "enabled": true,
  "method": "deterministic_rules_first",
  "fallback": "default_mode",
  "rules": [
   {
    "id": "ar01_agenda",
    "priority": 20,
    "pattern": "(agenda|priorid(ad|ades)|cola de tareas|calendario|watchdog)",
    "then_mode": "m10_agenda"
   },
   {
    "id": "ar02_plan",
    "priority": 30,
    "pattern": "(arquitectura|planifica|plan de proyecto|roadmap|dise[ñn]a el sistema)",
    "then_mode": "m01_plan"
   },
   {
    "id": "ar03_research",
    "priority": 40,
    "pattern": "(investiga|research|busca (recursos|m[eé]todos)|benchmark de)",
    "then_mode": "m03_investigacion"
   },
   {
    "id": "ar04_tool",
    "priority": 50,
    "pattern": "^\\s*(ejecuta (la )?tool|usa (la )?tool|run tool)",
    "then_mode": "m07_tool"
   }
  ]
 },
 "events": [
  "mode_resolved",
  "objective_pinned",
  "step_started",
  "step_passed",
  "step_failed",
  "cycle_started",
  "cycle_closed",
  "task_queued",
  "task_started",
  "task_blocked",
  "watchdog_stall",
  "limit_reached",
  "terminal"
 ],
