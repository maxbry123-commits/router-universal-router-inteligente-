{
  "schema": "yaiwes.ui.window.v1",
  "version": "0.2.0",
  "id": "chat-01",
  "panelId": "PANEL-01",
  "kind": "window",
  "label": "Chat operativo",
  "slotId": "panel-b-chat",
  "source": "UI YAIWES interface / Panel 1",
  "frontend": {
    "snapshot": "../index.html",
    "source": ["panel-01-chat.html", "panel-01-chat.css", "panel-01-chat.js"],
    "canvasTag": false,
    "runtime": "browser-native",
    "storage": "localStorage"
  },
  "visualSource": {
    "folder": "../../01-original/FOTOS-REF/",
    "patterns": ["dark mobile chat", "persistent composer", "mode dropdown", "bottom sheet tools", "compact chat list", "dark settings rows"]
  },
  "actions": [
    {"id":"chat.create","kind":"button","targetSlot":"panel-b-chat"},
    {"id":"chat.rename","kind":"menuitem","targetSlot":"panel-b-chat"},
    {"id":"mode.select","kind":"selector","targetSlot":"panel-b-chat"},
    {"id":"tools.toggle","kind":"selector","targetSlot":"panel-b-chat"},
    {"id":"send_message","kind":"button","targetSlot":"panel-b-chat"},
    {"id":"upload_file","kind":"file-input","targetSlot":"panel-b-chat"},
    {"id":"transcribe_audio","kind":"audio-input","targetSlot":"panel-b-chat"},
    {"id":"cancel_run","kind":"button","targetSlot":"panel-b-chat"},
    {"id":"export_conversation","kind":"menuitem","targetSlot":"panel-b-chat"},
    {"id":"chat.clear","kind":"menuitem","targetSlot":"panel-b-chat"}
  ],
  "states": ["idle", "selected", "queued", "running", "done", "failed", "blocked", "cancelled"],
  "backendBoundary": {
    "failClosed": true,
    "requiredEvents": ["action.accepted", "run.started", "run.delta", "run.completed", "run.failed", "run.cancelled"],
    "requiredCommands": ["send_message", "upload_file", "transcribe_audio", "cancel_run"]
  }
}
