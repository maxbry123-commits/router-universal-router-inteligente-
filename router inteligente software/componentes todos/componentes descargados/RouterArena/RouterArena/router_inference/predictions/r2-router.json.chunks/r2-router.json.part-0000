      "generated_answer": "```python\ndef solve():\n    import sys\n    W, B = map(int, sys.stdin.read().split())\n    \n    base = \"wbwbwwbwbwbw\"\n    n = len(base)\n    \n    # Precompute prefix counts for w and b\n    prefix_w = [0] * (n + 1)\n    prefix_b = [0] * (n + 1)\n    for i in range(n):\n        prefix_w[i+1] = prefix_w[i] + (1 if base[i] == 'w' else 0)\n        prefix_b[i+1] = prefix_b[i] + (1 if base[i] == 'b' else 0)\n    \n    total_w = prefix_w[n]\n    total_b = prefix_b[n]\n    \n    # For small W+B, check all possible substrings directly\n    max_len = W + B\n    if max_len <= 2 * n:\n        s = base * 2\n        for l in range(len(s)):\n            for r in range(l + W + B - 1, len(s)):\n                sub = s[l:r+1]\n                if sub.count('w') == W and sub.count('b') == B:\n                    print(\"Yes\")\n                    return\n        print(\"No\")\n        return\n    \n    # For larger cases, use modular arithmetic reasoning\n    # Check if there exists k such that k*total_w <= W < (k+1)*total_w and remainder can be satisfied\n    min_w = (W // total_w) * total_w if total_w > 0 else 0\n    max_w = ((W + total_w - 1) // total_w) * total_w if total_w > 0 else 0\n    \n    min_b = (B // total_b) * total_b if total_b > 0 else 0\n    max_b = ((B + total_b - 1) // total_b) * total_b if total_b > 0 else 0\n    \n    if total_w == 0 and total_b == 0:\n        print(\"No\")\n        return\n        \n    if W == 0 and B == 0:\n        print(\"No\")\n        return\n        \n    # Brute force up to 2 full periods is sufficient due to constraints\n    s = base * 3\n    for l in range(len(base) * 2):\n        for r in range(l, len(s)):\n            if r - l + 1 >= W + B and r - l + 1 <= W + B + n:\n                sub = s[l:r+1]\n                if sub.count('w') == W and sub.count('b') == B:\n                    print(\"Yes\")\n                    return\n    print(\"No\")\n\nsolve()\n```",
