        "input_tokens": 761,
        "output_tokens": 148,
        "total_tokens": 909
      },
      "provider": "deepseek",
      "error": null
    },
    "cost": 0.00014798,
    "accuracy": 0.3564814814814815,
    "for_optimality": false
