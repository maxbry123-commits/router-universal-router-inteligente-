w + high) // 2\n        if can_succeed(mid):\n            K_min = mid\n            high = mid - 1\n        else:\n            low = mid + 1\n    \n    if K_min == -1:\n        print(-1)\n        return\n\n    # Now reconstruct one valid strategy that uses at most K_min potions simultaneously\n    potions = defaultdict(int)\n    current_count = 0\n    actions = []\n    monsters_remaining = future_monsters.copy()\n    \n    event_idx = 0\n    for t, x in events:\n        if t == 1:\n            if current_count < K_min:\n                # Pick up\n                potions[x] += 1\n                current_count += 1\n                actions.append(1)\n            else:\n                # Skip\n                actions.append(0)\n        else: # t == 2\n            if potions[x] > 0:\n                potions[x] -= 1\n                current_count -= 1\n            else:\n                # Should not happen if our binary search was correct\n                print(-1)\n                return\n        event_idx += 1\n    \n    print(K_min)\n    print(\" \".join(map(str, actions)))\n\nsolve()\n```",
