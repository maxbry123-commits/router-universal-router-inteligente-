        "input_tokens": 745,
        "output_tokens": 5,
        "total_tokens": 750
      },
      "provider": "openrouter",
      "error": null
    },
    "cost": 0.00019375,
    "accuracy": 0.3181818181818181,
    "for_optimality": false
  },
