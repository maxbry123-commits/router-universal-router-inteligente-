      "token_usage": {
        "input_tokens": 632,
        "output_tokens": 3,
        "total_tokens": 635
      },
      "provider": "openrouter",
      "error": null
    },
    "cost": 0.0001625,
    "accuracy": 1.0,
    "for_optimality": false
