      nx = (c - x0 + 1) // 2\n                ny = (d - y0 + 1) // 2\n                if ((x0 + y0) % 2 == 0 and (x0 % 2 == 0)) or ((x0 + y0) % 2 == 1 and (x0 % 2 == 1)):\n                    black += nx * ny\n        return black\n\n    def solve_fast(a, b, c, d):\n        if a >= c or b >= d:\n            return 0\n        total = (c - a) * (d - b)\n        black = 0\n        for dx in range(2):\n            for dy in range(2):\n                x0 = a + dx\n                y0 = b + dy\n                if x0 >= c or y0 >= d:\n                    continue\n                nx = (c - x0 + 1) // 2\n                ny = (d - y0 + 1) // 2\n                if ((x0 + y0) % 2 == 0 and (x0 % 2 == 0)) or ((x0 + y0) % 2 == 1 and (x0 % 2 == 1)):\n                    black += nx * ny\n        return black\n\n    def get_black_area(a, b, c, d):\n        if a >= c or b >= d:\n            return 0\n        total = (c - a) * (d - b)\n        if total == 0:\n            return 0\n        black = 0\n        for dx in range(2):\n            for dy in range(2):\n                x0 = a + dx\n                y0 = b + dy\n                if x0 >= c or y0 >= d:\n                    continue\n                nx = (c - x0 + 1) // 2\n                ny = (d - y0 + 1) // 2\n                if ((x0 + y0) % 2 == 0 and (x0 % 2 == 0)) or ((x0 + y0) % 2 == 1 and (x0 % 2 == 1)):\n                    black += nx * ny\n        return black\n\n    def main():\n        a, b, c, d = A, B, C, D\n        result = get_black_area(a, b, c, d)\n        print(result * 2)\n\n    main()\n\nsolve()",
