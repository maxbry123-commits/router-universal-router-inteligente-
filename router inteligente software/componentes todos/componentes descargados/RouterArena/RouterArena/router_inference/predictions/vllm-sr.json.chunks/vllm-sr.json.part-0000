      "generated_answer": "```python\nimport sys\ninput = sys.stdin.read\n\ndef main():\n    data = input().split()\n    N = int(data[0])\n    intervals = []\n    points = set()\n    idx = 1\n    for i in range(N):\n        l = int(data[idx])\n        r = int(data[idx+1])\n        intervals.append((l, r))\n        points.add(l)\n        points.add(r)\n        idx += 2\n    all_points = sorted(list(points))\n    rank = {val: i+1 for i, val in enumerate(all_points)}\n    M = len(all_points)\n    \n    class Fenwick:\n        def __init__(self, size):\n            self.size = size\n            self.tree = [0] * (size + 1)\n        def update(self, idx, val):\n            while idx <= self.size:\n                self.tree[idx] += val\n                idx += idx & -idx\n        def query(self, idx):\n            res = 0\n            while idx > 0:\n                res += self.tree[idx]\n                idx -= idx & -idx\n            return res\n        def query_range(self, left, right):\n            return self.query(right) - self.query(left-1)\n    \n    ft = Fenwick(M)\n    intervals.sort(key=lambda x: x[0])\n    ans = 0\n    for l, r in intervals:\n        # query r's >= l\n        rnk_l = rank[l]\n        # find smallest pos where all_points[pos-1] >= l, which is rnk_l since l in points\n        cnt = ft.query_range(rnk_l, M)\n        ans += cnt\n        rnk_r = rank[r]\n        ft.update(rnk_r, 1)\n    print(ans)\n\nmain()\n```",
