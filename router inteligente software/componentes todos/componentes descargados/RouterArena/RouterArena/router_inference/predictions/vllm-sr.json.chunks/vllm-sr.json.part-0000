      "generated_answer": "```python\nimport sys\nimport heapq\nfrom collections import defaultdict\n\ndef solve():\n    input = sys.stdin.read\n    data = input().split()\n    N = int(data[0])\n    d = defaultdict(int)\n    idx = 1\n    for i in range(N):\n        S = int(data[idx])\n        C = int(data[idx + 1])\n        d[S] = C\n        idx += 2\n    if not d:\n        print(0)\n        return\n    pq = list(d.keys())\n    heapq.heapify(pq)\n    visited = set(pq)\n    while pq:\n        s = heapq.heappop(pq)\n        if d[s] < 2:\n            continue\n        carry = d[s] // 2\n        d[s] %= 2\n        news = 2 * s\n        if d[news] == 0:\n            heapq.heappush(pq, news)\n        d[news] += carry\n    ans = sum(d.values())\n    print(ans)\n\nsolve()\n```",
