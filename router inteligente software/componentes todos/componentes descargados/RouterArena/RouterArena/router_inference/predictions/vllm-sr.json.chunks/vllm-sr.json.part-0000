      "generated_answer": "```python\nimport sys\n\ndef solve():\n    input = sys.stdin.read\n    data = input().split()\n    N = int(data[0])\n    boxes = []\n    index = 1\n    for i in range(N):\n        x1 = int(data[index])\n        y1 = int(data[index+1])\n        z1 = int(data[index+2])\n        x2 = int(data[index+3])\n        y2 = int(data[index+4])\n        z2 = int(data[index+5])\n        boxes.append((x1, y1, z1, x2, y2, z2))\n        index += 6\n    neigh = [set() for _ in range(N)]\n    \n    # x-direction\n    for k in range(101):\n        grid = [[-1] * 101 for _ in range(101)]\n        lefts = []\n        rights = []\n        for i in range(N):\n            if boxes[i][3] == k:\n                lefts.append(i)\n            elif boxes[i][0] == k:\n                rights.append(i)\n        for i in lefts:\n            x1, y1, z1, x2, y2, z2 = boxes[i]\n            for yy in range(y1, y2):\n                for zz in range(z1, z2):\n                    grid[yy][zz] = i\n        for i in rights:\n            x1, y1, z1, x2, y2, z2 = boxes[i]\n            s = set()\n            for yy in range(y1, y2):\n                for zz in range(z1, z2):\n                    if grid[yy][zz] != -1:\n                        s.add(grid[yy][zz])\n            for j in s:\n                neigh[i].add(j)\n                neigh[j].add(i)\n    \n    # y-direction\n    for k in range(101):\n        grid = [[-1] * 101 for _ in range(101)]\n        lefts = []\n        rights = []\n        for i in range(N):\n            if boxes[i][4] == k:\n                lefts.append(i)\n            elif boxes[i][1] == k:\n                rights.append(i)\n        for i in lefts:\n            x1, y1, z1, x2, y2, z2 = boxes[i]\n            for xx in range(x1, x2):\n                for zz in range(z1, z2):\n                    grid[xx][zz] = i\n        for i in rights:\n            x1, y1, z1, x2, y2, z2 = boxes[i]\n            s = set()\n            for xx in range(x1, x2):\n                for zz in range(z1, z2):\n                    if grid[xx][zz] != -1:\n                        s.add(grid[xx][zz])\n            for j in s:\n                neigh[i].add(j)\n                neigh[j].add(i)\n    \n    # z-direction\n    for k in range(101):\n        grid = [[-1] * 101 for _ in range(101)]\n        lefts = []\n        rights = []\n        for i in range(N):\n            if boxes[i][5] == k:\n                lefts.append(i)\n            elif boxes[i][2] == k:\n                rights.append(i)\n        for i in lefts:\n            x1, y1, z1, x2, y2, z2 = boxes[i]\n            for xx in range(x1, x2):\n                for yy in range(y1, y2):\n                    grid[xx][yy] = i\n        for i in rights:\n            x1, y1, z1, x2, y2, z2 = boxes[i]\n            s = set()\n            for xx in range(x1, x2):\n                for yy in range(y1, y2):\n                    if grid[xx][yy] != -1:\n                        s.add(grid[xx][yy])\n            for j in s:\n                neigh[i].add(j)\n                neigh[j].add(i)\n    \n    for i in range(N):\n        print(len(neigh[i]))\n\nsolve()\n```",
