      "generated_answer": "```python\nimport sys\nimport itertools\n\ndef solve():\n    input = sys.stdin.read\n    data = input().split()\n    index = 0\n    H = int(data[index])\n    W = int(data[index + 1])\n    index += 2\n    A = []\n    for i in range(H):\n        row = [int(data[index + j]) for j in range(W)]\n        A.append(row)\n        index += W\n    B = []\n    for i in range(H):\n        row = [int(data[index + j]) for j in range(W)]\n        B.append(row)\n        index += W\n    min_ops = float('inf')\n    for row_perm in itertools.permutations(range(H)):\n        for col_perm in itertools.permutations(range(W)):\n            match = True\n            for i in range(H):\n                for j in range(W):\n                    if A[row_perm[i]][col_perm[j]] != B[i][j]:\n                        match = False\n                        break\n                if not match:\n                    break\n            if match:\n                inv_row = 0\n                for x in range(H):\n                    for y in range(x + 1, H):\n                        if row_perm[x] > row_perm[y]:\n                            inv_row += 1\n                inv_col = 0\n                for x in range(W):\n                    for y in range(x + 1, W):\n                        if col_perm[x] > col_perm[y]:\n                            inv_col += 1\n                min_ops = min(min_ops, inv_row + inv_col)\n    if min_ops == float('inf'):\n        print(-1)\n    else:\n        print(min_ops)\n\nsolve()\n```",
