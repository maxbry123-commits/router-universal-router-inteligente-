      "generated_answer": "```python\nimport sys\ninput = sys.stdin.read\ndata = input().split()\nN = int(data[0])\nQ = int(data[1])\nhist = [(1, 0)]\nT = 0\nhx = 1\nhy = 0\nidx = 2\nfor _ in range(Q):\n    tp = data[idx]\n    idx += 1\n    if tp == '1':\n        C = data[idx]\n        idx += 1\n        if C == 'R':\n            hx += 1\n        elif C == 'L':\n            hx -= 1\n        elif C == 'U':\n            hy += 1\n        elif C == 'D':\n            hy -= 1\n        hist.append((hx, hy))\n        T += 1\n    else:\n        p = int(data[idx])\n        idx += 1\n        if p - 1 <= T:\n            x, y = hist[T - (p - 1)]\n        else:\n            x = p - T\n            y = 0\n        print(x, y)\n```",
