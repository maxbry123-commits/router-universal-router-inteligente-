      "generated_answer": "```python\nimport sys\n\ndef read_poly():\n    lines = [sys.stdin.readline().strip() for _ in range(4)]\n    cells = []\n    for i in range(4):\n        for j in range(4):\n            if lines[i][j] == '#':\n                cells.append((i, j))\n    return cells\n\ndef normalize(cells):\n    if not cells:\n        return set()\n    minr = min(r for r, c in cells)\n    minc = min(c for r, c in cells)\n    return {(r - minr, c - minc) for r, c in cells}\n\ndef rotate_cells(cells, k):\n    res = []\n    for r, c in cells:\n        for _ in range(k):\n            r, c = c, -r\n        res.append((r, c))\n    return normalize(res)\n\ndef get_all_shapes(cells):\n    shapes = []\n    for k in range(4):\n        shape = rotate_cells(cells, k)\n        if shape not in shapes:\n            shapes.append(shape)\n    return shapes\n\ndef get_placements(shape):\n    placements = []\n    maxr = max((r for r, c in shape), default=0)\n    maxc = max((c for r, c in shape), default=0)\n    for dr in range(4 - maxr):\n        for dc in range(4 - maxc):\n            placed = set()\n            valid = True\n            for r, c in shape:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < 4 and 0 <= nc < 4:\n                    placed.add(nr * 4 + nc)\n                else:\n                    valid = False\n                    break\n            if valid:\n                mask = 0\n                for p in placed:\n                    mask |= (1 << p)\n                placements.append(mask)\n    return placements\n\ndef can_tile(polys):\n    all_placements = []\n    for cells in polys:\n        shapes = get_all_shapes(cells)\n        place_list = []\n        for shape in shapes:\n            place_list.extend(get_placements(shape))\n        all_placements.append(list(set(place_list)))\n    for m1 in all_placements[0]:\n        for m2 in all_placements[1]:\n            if m1 & m2:\n                continue\n            for m3 in all_placements[2]:\n                if m1 & m3 or m2 & m3:\n                    continue\n                if (m1 | m2 | m3) == (1 << 16) - 1:\n                    return True\n    return False\n\npolys = [read_poly() for _ in range(3)]\nprint(\"Yes\" if can_tile(polys) else \"No\")\n```",
