    "generated_result": {
      "generated_answer": "```python\nimport sys\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    N = int(data[0])\n    K = int(data[1])\n    Q = int(data[2])\n    updates = []\n    vals = set([0])\n    idx = 3\n    for _ in range(Q):\n        X = int(data[idx])\n        Y = int(data[idx+1])\n        updates.append((X, Y))\n        vals.add(Y)\n        idx += 2\n    vals = sorted(list(vals))\n    V = len(vals)\n    rank = {v: i for i, v in enumerate(vals)}\n    \n    # Segment tree: each node stores (count, sum)\n    tree_count = [0] * (4 * V)\n    tree_sum = [0] * (4 * V)\n    \n    def update(node, start, end, idx, delta_count, delta_sum):\n        if start == end:\n            tree_count[node] += delta_count\n            tree_sum[node] += delta_sum\n            return\n        mid = (start + end) // 2\n        if idx <= mid:\n            update(2 * node, start, mid, idx, delta_count, delta_sum)\n        else:\n            update(2 * node + 1, mid + 1, end, idx, delta_count, delta_sum)\n        tree_count[node] = tree_count[2 * node] + tree_count[2 * node + 1]\n        tree_sum[node] = tree_sum[2 * node] + tree_sum[2 * node + 1]\n    \n    def query_topk(node, start, end, k):\n        if k <= 0:\n            return 0\n        if start == end:\n            return vals[start] * min(k, tree_count[node])\n        mid = (start + end) // 2\n        if tree_count[2 * node + 1] >= k:\n            return query_topk(2 * node + 1, mid + 1, end, k)\n        else:\n            return tree_sum[2 * node + 1] + query_topk(2 * node, start, mid, k - tree_count[2 * node + 1])\n    \n    A = [0] * N\n    # Initialize all zeros\n    z_rank = rank[0]\n    update(1, 0, V-1, z_rank, N, N * 0)\n    \n    for X, Y in updates:\n        X -= 1\n        old = A[X]\n        if old != Y:\n            # remove old\n            old_r = rank[old]\n            update(1, 0, V-1, old_r, -1, -old)\n            # add new\n            new_r = rank[Y]\n            update(1, 0, V-1, new_r, 1, Y)\n            A[X] = Y\n        print(query_topk(1, 0, V-1, K))\n\nmain()\n```",
