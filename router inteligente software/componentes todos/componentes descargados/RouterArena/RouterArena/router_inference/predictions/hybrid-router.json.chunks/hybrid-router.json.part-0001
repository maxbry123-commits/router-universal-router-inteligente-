        "input_tokens": 359,
        "output_tokens": 67,
        "total_tokens": 426
      },
      "provider": "openrouter",
      "error": null
    },
    "cost": 3.2189e-05,
    "accuracy": 0.5833333333333333,
    "for_optimality": false
