  # = 24^n + n * 24^(n-1)\n    missing_l_at_most_one_e = (pow(24, n, MOD) + n * pow(24, n-1, MOD)) % MOD\n    \n    # missing 't' and at most one 'e': strings with no 't' and at most one 'e'\n    # = 24^n + n * 24^(n-1)\n    missing_t_at_most_one_e = (pow(24, n, MOD) + n * pow(24, n-1, MOD)) % MOD\n    \n    result = (result + missing_l_and_t + missing_l_at_most_one_e + missing_t_at_most_one_e) % MOD\n    \n    # Subtract triple intersection: missing 'l', 't', and having at most one 'e'\n    # = strings with no 'l', no 't', and at most one 'e'\n    # = 23^n + n * 23^(n-1)\n    missing_l_t_at_most_one_e = (pow(23, n, MOD) + n * pow(23, n-1, MOD)) % MOD\n    \n    result = (result - missing_l_t_at_most_one_e) % MOD\n    \n    return result\n```",
