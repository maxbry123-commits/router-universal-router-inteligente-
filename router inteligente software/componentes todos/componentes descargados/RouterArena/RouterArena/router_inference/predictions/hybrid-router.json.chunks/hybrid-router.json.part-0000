to k)\n    \n    # This equals: sum over all pairs (S, T) where T is a subsequence of S and sum(T) = k\n    \n    # For a fixed T with sum k, how many S contain T? If T has length m, and the original\n    # array has n elements, then we can choose any subset of the remaining n-m elements\n    # So each such T contributes 2^(n-m) to the answer\n    \n    from collections import defaultdict\n    \n    total = 0\n    \n    # Generate all possible subsequences that sum to k\n    # For each such subsequence, add 2^(n - length_of_subsequence) to result\n    def backtrack(index, current_sum, length):\n        nonlocal total\n        if index == n:\n            if current_sum == k:\n                total = (total + pow(2, n - length, MOD)) % MOD\n            return\n        \n        # Skip current element\n        backtrack(index + 1, current_sum, length)\n        \n        # Take current element\n        backtrack(index + 1, current_sum + nums[index], length + 1)\n    \n    backtrack(0, 0, 0)\n    return total\n```",
