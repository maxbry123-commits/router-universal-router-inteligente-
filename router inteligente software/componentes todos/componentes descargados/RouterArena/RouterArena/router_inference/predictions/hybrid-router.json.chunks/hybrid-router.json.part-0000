    k = int(data[1])\n    P = list(map(int, data[2:2+n]))\n    \n    # Build pos array: pos[value] = 1-indexed index\n    pos = [0] * (n+1)\n    for i in range(n):\n        pos[P[i]] = i+1  # 1-based index\n    \n    if k == 1:\n        print(0)\n        return\n    \n    # We'll consider consecutive value ranges [a, a+k-1] for a in [1, n-k+1]\n    # For each, collect positions of these values, maintain min and max using lazy heaps\n    min_heap = []\n    max_heap = []\n    # valid[i] = True if position i is in current window\n    valid = [False] * (n+1)  # 1-indexed up to n\n    \n    # Initialize: a = 1, values 1 to k\n    for val in range(1, k+1):\n        p = pos[val]\n        heapq.heappush(min_heap, p)\n        heapq.heappush(max_heap, -p)\n        valid[p] = True\n    \n    best = float('inf')\n    \n    # Iterate a from 1 to n-k+1\n    for a in range(1, n - k + 2):\n        # Clean heaps\n        while min_heap and not valid[min_heap[0]]:\n            heapq.heappop(min_heap)\n        while max_heap and not valid[-max_heap[0]]:\n            heapq.heappop(max_heap)\n        \n        if not min_heap:\n            break\n            \n        min_pos = min_heap[0]\n        max_pos = -max_heap[0]\n        span = max_pos - min_pos\n        if span < best:\n            best = span\n        \n        # Prepare for next a: remove value `a`, add value `a+k` (if exists and next a exists)\n        if a < n - k + 1:\n            # Remove value `a` -> its position\n            p_remove = pos[a]\n            valid[p_remove] = False   # lazy deletion\n            \n            # Add value `a+k`\n            p_add = pos[a+k]\n            valid[p_add] = True\n            heapq.heappush(min_heap, p_add)\n            heapq.heappush(max_heap, -p_add)\n    \n    print(best)\n\nmain()\n```\n\nLet's test with sample:\n\nSample 1: n=4, k=2\nP = [2,3,1,4] → pos[2]=1, pos[3]=2, pos[1]=3, pos[4]=4\n\nInitial window: values 1,2 → positions 3,1\n- min_heap: [1,3] (heapified)\n- max_heap