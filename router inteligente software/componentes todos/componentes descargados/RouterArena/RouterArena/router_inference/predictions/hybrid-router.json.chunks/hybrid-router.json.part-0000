      "generated_answer": "```python\nimport sys\nfrom itertools import product\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    V1, V2, V3 = map(int, data)\n    side = 7\n    total_volume = 3 * (side ** 3)  # 3 * 343 = 1029\n    \n    # The total covered volume can also be computed as:\n    # V1 + 2*V2 + 3*V3 = sum over points of (number of cubes covering it)\n    # Also: V1 + V2 + V3 <= 3 * 343, but more constraints exist\n    \n    # Basic sanity checks\n    if V3 > side**3:  # Can't have more triple overlap than one cube's volume\n        print(\"No\")\n        return\n        \n    if (V1 + V2 + V3) > total_volume:\n        print(\"No\")\n        return\n        \n    if (V1 + 2*V2 + 3*V3) > 3*(side**3):\n        print(\"No\")\n        return\n        \n    # We'll try to fix the first cube at (0,0,0) for symmetry.\n    # Then search over relative positions of cube2 and cube3 within [-14,14] offset\n    # Since cubes have side 7 and we allow up to 100, but overlaps depend on relative positions\n    \n    a1, b1, c1 = 0, 0, 0  # fix first cube at origin\n    \n    # Define helper: volume of intersection of two cubes\n    def intersect_vol(a1, b1, c1, a2, b2, c2):\n        dx = max(0, min(a1+side, a2+side) - max(a1, a2))\n        dy = max(0, min(b1+side, b2+side) - max(b1, b2))\n        dz = max(0, min(c1+side, c2+side) - max(c1, c2))\n        return dx * dy * dz\n    \n    # Try possible offsets for cube2 and cube3 relative to cube1\n    # Search range: from -14 to 14 should be enough to get various overlap patterns\n    search_range = range(-14, 15)\n    \n    for da2, db2, dc2 in product(search_range, repeat=3):\n        a2, b2, c2 = da2, db2, dc2\n        for da3, db3, dc3 in product(search_range, repeat=3):\n            a3, b3, c3 = da3, db3, dc3\n            \n            # All coordinates must be within |.| <= 100\n            if any(abs(x) > 100 for x in [a1,b1,c1,a2,b2,c2,a3,b3,c3]):\n                continue\n                \n            C1 = (a1, b1, c1)\n            C2 = (a2, b2, c2)\n            C3 = (a3, b3, c3)\n            cubes = [C1, C2, C3]\n            \n            # Compute pairwise intersections and triple intersection\n            v12 = intersect_vol(a1,b1,c1, a2,b2,c2)\n            v13 = intersect_vol(a1,b1,c1, a3,b3,c3)\n            v23 = intersect_vol(a2,b2,c2, a3,b3,c3)\n            v123 = intersect_vol(a2,b2,c2, a3,b3,c3)  # intersection of 2 and 3\n            v123 = intersect_vol(a1,b1,c1, a2,b2,c2) if v123 > 0 else 0  # must intersect with 1 too\n            # Actually compute full triple\n            dx = max(0, min(a1+side, a2+side, a3+side) - max(a1, a2, a3))\n            dy = max(0, min(b1+side, b2+side, b3+side) - max(b1, b2, b3))\n            dz = max(0, min(c1+side, c2+side, c3+side) - max(c1, c2, c3))\n            v123 = dx * dy * dz\n            \n            # Volume in exactly two cubes\n            exact2 = (v12 - v123) + (v13 - v123) + (v23 - v123)\n            \n            # Volume in all three\n            exact3 = v123\n            \n            # Volume in exactly one cube\n            vol1 = side**3\n            exact1 = (vol1 - v12 - v13 + v123) + \\\n                     (vol1 - v12 - v23 + v123) + \\\n                     (vol1 - v13 - v23 + v123)\n            # But wait: inclusion-exclusion for exactly one:\n            # For each cube: subtract pairwise overlaps, add back triple\n            exact1 = 0\n            for i in range(3):\n                total_subtract = 0\n                for j in range(3):\n                    if i != j:\n                        a_i, b_i, c_i = cubes[i]\n                        a_j, b_j, c_j = cubes[j]\n                        v_ij = intersect_vol(a_i,b_i,c_i, a_j,b_j,c_j)\n                        total_subtract += v_ij\n                # Add back triple (since subtracted too much)\n                exact1 += (vol1 - total_subtract + 2*v123)\n            # Wait, above logic is flawed.\n\n            # Correct method:\n            # A point is in exactly one cube if it's in one and not in the other two.\n            # But easier: total single coverage = Σ|Ci| - 2Σ|Ci∩Cj| + 3|C1∩C2∩C3|\n            # But that's not right either.\n\n            # Standard inclusion-exclusion for exactly one:\n            # |exactly one| = Σ|Ci| - 2Σ|Ci∩Cj| + 3|C1∩C2∩C3|\n            # Actually:\n            # Let S1 = sum |Ci| = 3 * 343\n            # S2 = sum |Ci ∩ Cj| (i<j) = v12 + v13 + v23\n            # S3 = |C1∩C2∩C3| = v123\n            # Then:\n            # |exactly one| = S1 - 2*S2 + 3*S3\n            # |exactly two| = S2 - 3*S3\n            # |exactly three| = S3\n            #\n            # Why?\n            # Each point in exactly one set is counted 1 time in S1, 0 in S2/S3 → contributes 1\n            # Each point in exactly two sets: counted 2 in S1, 1 in S2 (in one pair), 0 in S3 → 2 - 2*1 = 0 → wait not matching\n            #\n            # Correct derivation:\n            #\n            # Define:\n            # A = exactly one: each such point contributes 1 to S1, 0 to S2, 0 to S3\n            # B = exactly two: contributes 2 to S1, 1 to S2, 0 to S3\n            # C = exactly three: contributes 3 to S1, 3 to S2, 1 to S3  (3 pairs: {1,2},{1,3},{2,3})\n            #\n            # So:\n            # S1 = 1*A + 2*B + 3*C\n            # S2 = 0*A + 1*B + 3*C\n            # S3 = 0*A + 0*B + 1*C\n            #\n            # Then:\n            # C = S3\n            # B = S2 - 3*C = S2 - 3*S3\n            # A = S1 - 2*B - 3*C = S1 - 2*(S2 - 3*S3) - 3*S3 = S1 - 2*S2 + 3*S3\n            #\n            S1 = 3 * (side**3)\n            S2 = v12 + v13 + v23\n            S3 = v123\n\n            computed_V3 = S3\n            computed_V2 = S2 - 3*S3\n            computed_V1 = S1 - 2*S2 + 3*S3\n\n            if computed_V1 == V1 and computed_V2 == V2 and computed_V3 == V3:\n                print(\"Yes\")\n                print(a1, b1, c1, a2, b2, c2, a3, b3, c3)\n   