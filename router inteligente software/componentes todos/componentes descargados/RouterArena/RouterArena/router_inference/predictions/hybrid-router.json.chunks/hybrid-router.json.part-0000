ange(1, H+1):\n        rt = row_time[i]\n        # Count columns j with col_time[j] < rt\n        # bisect_left gives first index >= rt\n        count_cols = bisect.bisect_left(all_col_times, rt)\n        color = row_color[i]\n        color_count[color] += count_cols\n    \n    # Columns: count cells where col_time[j] >= row_time[i]\n    for j in range(1, W+1):\n        ct = col_time[j]\n        # Count rows i with row_time[i] <= ct\n        count_rows = bisect.bisect_right(all_row_times, ct)\n        color = col_color[j]\n        color_count[color] += count_rows\n    \n    # Output\n    sorted_colors = sorted(color_count.keys())\n    print(len(sorted_colors))\n    for color in sorted_colors:\n        print(color, color_count[color])\n\nif __name__ == '__main__':\n    main()\n```\n\n---\n\nThis should pass all cases.\n\nLet me test with Sample 1 again:\n\n- row win:\n  - row1: rt=-1 → bisect_left(all_col_times=[-1,-1,-1,1], -1) → index 0 → count_cols=0 → color 0 +=0\n  - row2: rt=0 → bisect_left([...], 0) → first index with >=0 → that’s index 3 (since [-1,-1,-1,1], 1>=0) → so index=3 → count_cols=3 → color 5 +=3\n  - row3: rt=3 → bisect_left(...,3) → first >=3 → index 4? len=4 → index=4 → count_cols=4 → color 2 +=4\n- col win:\n  - col1: ct=-1 → bisect_right(all_row_times=[-1,0,3], -1) = index of first > -1 → index=1 → count_rows=1 → col_color[1]=0 → color 0 +=1\n  - col2: ct=-1 → same → color 0 +=1 → 2\n  - col3: ct=-1 → color 0 +=1 → 3\n  - col4: ct=1 → bisect_right([...],1) → all values <=1: -1,0 → 1 is not in list but 0<1, 3>1 → so values <=1: -1,0 → count=2 → color 0 +=2 → total 5\n\nSo color 0:5, 5:3, 2:4 → output 3, then:\n0 5\n2 4\n5 3\n\nBut we must output **in ascending order of color**: 0,2,5 → correct.\n\nSo yes.\n\n---\n\n✅ Final answer:\n\n```python\nimport sys\nimport bisect\nfrom collections import defaultdict\n\ndef main():\n    data = sys.stdin.read().split()\n    H = int(data[0])\n    W = int(data[1])\n    M = int(data[2])\n    ops = []\n    idx = 3\n    for i in range(M):\n        t = int(data[idx]); a = int(data[idx+1]); x = int(data[idx+2])\n        idx += 3\n        ops.append((t, a, x))\n    \n    row_time = [-1] * (H + 1)\n    row_color = [0] * (H + 1)\n    col_time = [-1] * (W + 1)\n    col_color = [0] * (W + 1)\n    \n    for time, (t, a, x) in enumerate(ops):\n        if t == 1:\n            row_time[a] = time\n            row_color[a] = x\n        else:\n            col_time[a] = time\n            col_color[a] = x\n    \n    all_row_times = [row_time[i] for i in range(1, H + 1)]\n    all_col_times = [col_time[j] for j in range(1, W + 1)]\n    all_row_times.sort()\n    all_col_times.sort()\n    \n    color_count = defaultdict(int)\n    \n    for i in range(1, H + 1):\n        rt = row_time[i]\n        count_cols = bisect.bisect_left(all_col_times, rt)\n        color_count[row_color[i]] += count_cols\n    \n    for j in range(1, W + 1):\n        ct = col_time[j]\n        count_rows = bisect.bisect_right(all_row_times, ct)\n        color_count[col_color[j]] += count_rows\n    \n    sorted_colors = sorted(color_count.keys())\n    print(len(sorted_colors))\n    for color in sorted_colors:\n        print(color, color_count[color])\n\nif __name__ == '__main__':\n    main()\n```",
